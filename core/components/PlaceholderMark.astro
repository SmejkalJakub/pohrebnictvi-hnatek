---
/**
 * Wraps placeholder content or images with a visible label (prototype builds only; production
 * rejects placeholders).
 *
 * When a `class` is passed, the wrapper element is rendered whether or not the content is a
 * placeholder: templates use that element for layout (a grid cell, a column), so dropping it once
 * the client approves the content would break the layout (design review 2026-11-13, §2.1). Without
 * a class, inactive content renders bare, as before.
 */
interface Props {
  active: boolean;
  kind?: "content" | "image";
  as?: "div" | "span" | "section" | "article" | "figure" | "li";
  class?: string;
  labelClass?: string;
}

const { active, kind = "content", as = "div", class: className, labelClass } = Astro.props;
const Tag = as;
let label = "Zástupný obsah";
if (kind === "image") {
  label = "Zástupný obrázek";
}
const keepWrapper = className !== undefined && className.trim() !== "";
---
{
  active ? (
    <Tag class={className} data-placeholder={kind}>
      <span class={labelClass} data-placeholder-label>
        {label}
      </span>
      <slot />
    </Tag>
  ) : keepWrapper ? (
    <Tag class={className}>
      <slot />
    </Tag>
  ) : (
    <slot />
  )
}

---
/**
 * Nonstop transport CTA (content-contract §6.5). The accessible name always contains the
 * service label and the number. Renders nothing when the service is disabled.
 * Variants: "full" (label + number), "label" (label only), "number" (number only),
 * "custom" (only the slot: short template UI text such as "Nonstop převoz"; the accessible name
 * still comes from core). For the other variants the slot is rendered first (e.g. an icon).
 */
import type { EmergencyTransport } from "../content/schemas.ts";
import { formatPhone } from "../format/phone.ts";

interface Props {
  emergency: EmergencyTransport;
  variant?: "full" | "label" | "number" | "custom";
  class?: string;
  labelClass?: string;
  numberClass?: string;
}

const { emergency, variant = "full", class: className, labelClass, numberClass } = Astro.props;
const phone = formatPhone(emergency.phone);
const accessibleName = `${emergency.label}, volat ${phone.spoken}`;
const showLabel = variant === "full" || variant === "label";
const showNumber = variant === "full" || variant === "number";
---
{
  emergency.enabled ? (
    <a href={phone.href} class={className} aria-label={accessibleName} data-emergency-link data-variant={variant}>
      <slot />
      {showLabel ? <span class={labelClass} data-part="label">{emergency.label}</span> : null}
      {showNumber ? <span class={numberClass} data-part="number">{phone.display}</span> : null}
    </a>
  ) : null
}

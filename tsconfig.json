{
  "compilerOptions": {
    "target": "ES2024",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2024"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "core/**/*.ts",
    "fixtures/**/*.ts",
    "clients/**/*.ts",
    "tools/**/*.ts",
    "qa/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "core/content/load.ts",
    "core/content/collections.ts",
    "core/media/resolve.ts",
    "core/env.d.ts"
  ]
}

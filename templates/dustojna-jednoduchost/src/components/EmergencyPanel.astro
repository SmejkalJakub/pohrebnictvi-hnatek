---
/**
 * Separately headed nonstop transport panel (contact page first, 404, transport service).
 * Office hours never appear inside it. Renders nothing when the service is disabled.
 */
import EmergencyPhoneLink from "@core/components/EmergencyPhoneLink.astro";
import type { EmergencyTransport } from "@core/content/schemas.ts";
import LineIcon from "./LineIcon.astro";
import When from "./When.astro";
import { ui } from "../i18n/cs.ts";

interface Props {
  emergency: EmergencyTransport;
  headingLevel?: "h2" | "h3";
  id?: string;
  high?: boolean;
}

const { emergency, headingLevel = "h2", id = "nonstop-prevoz", high = false } = Astro.props;
const Heading = headingLevel;
---
<When if={emergency.enabled}>
    <section class="emergency-panel" aria-labelledby={id} data-emergency-block>
      <Heading id={id}>{emergency.label}</Heading>
      {high ? <p class="mt-1 font-semibold text-accent">{ui.emergencyAround}</p> : null}
      <div class="mt-4">
        <EmergencyPhoneLink
          emergency={emergency}
          variant="number"
          class="btn btn-emergency min-h-14 px-4 text-lg sm:px-5 sm:text-xl md:text-2xl"
          numberClass="num"
        >
          <LineIcon name="phone" size={24} />
        </EmergencyPhoneLink>
      </div>
      {emergency.shortNote !== null ? <p class="mt-3">{emergency.shortNote}</p> : null}
      {emergency.serviceArea !== null ? <p class="mt-1 text-muted">{emergency.serviceArea}</p> : null}
    </section>
</When>

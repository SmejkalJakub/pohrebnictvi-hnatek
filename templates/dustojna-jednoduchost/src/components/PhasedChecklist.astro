---
/**
 * Phased checklist for /jak-postupovat/: guidance grouped under phase headings. It opens with
 * the "Kde blízký člověk zemřel?" picker; choosing a situation sets a fragment (#situace-…) and
 * CSS :has(:target) hides the steps that do not apply (no JavaScript; without :has() support the
 * full list shows). The default slot (page body) renders after the picker. Each entry is a
 * compact block: summary, situations, a <details> body, a checklist of real checkboxes, its
 * contact prompt and a "Další krok" link. Closed <details> do not print, so the body is
 * repeated in a print-only block.
 */
import type { CollectionEntry } from "astro:content";
import { render } from "@core/content/load.ts";
import EmergencyPhoneLink from "@core/components/EmergencyPhoneLink.astro";
import PhoneLink from "@core/components/PhoneLink.astro";
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import {
  SITUATION_ANCHOR,
  SPECIFIC_SITUATIONS,
  chooserSituations,
  nextGuidanceStep,
  situationsAttribute,
} from "@core/content/guidance-flow.ts";
import { GUIDANCE_PHASES } from "@core/content/schemas.ts";
import type { SiteContext } from "@core/content/view-models.ts";
import { formatPhone } from "@core/format/phone.ts";
import LineIcon from "./LineIcon.astro";
import ReviewFlag from "./ReviewFlag.astro";
import SituationPicker from "./SituationPicker.astro";
import { guidancePhaseAnchors, guidancePhaseLabels, situationLabels, ui } from "../i18n/cs.ts";
import { primaryOfficePhone } from "../lib/site.ts";

interface Props {
  site: SiteContext;
  guidance: CollectionEntry<"guidance">[];
}

const ALL_ANCHOR = "postup";

const { site, guidance } = Astro.props;
const office = primaryOfficePhone(site);
const officeNumber = formatPhone(office.number);
const situations = chooserSituations(guidance);

/** A phase (and its nav link) stays visible while any of its steps is visible. */
function phaseSituations(entries: CollectionEntry<"guidance">[]): string {
  const attributes = new Set(entries.flatMap((entry) => situationsAttribute(entry).split(" ")));
  if (attributes.has("any")) {
    return "any";
  }
  return [...attributes].join(" ");
}

const phases = GUIDANCE_PHASES.map((phase) => {
  const entries = guidance.filter((entry) => entry.data.phase === phase);
  return {
    phase,
    label: guidancePhaseLabels[phase],
    anchor: guidancePhaseAnchors[phase],
    entries,
    situations: phaseSituations(entries),
  };
}).filter((group) => group.entries.length > 0);

const rendered = new Map<string, Awaited<ReturnType<typeof render>>["Content"]>();
for (const entry of guidance) {
  const { Content } = await render(entry);
  rendered.set(entry.id, Content);
}

function nextOf(entry: CollectionEntry<"guidance">): CollectionEntry<"guidance"> | null {
  return nextGuidanceStep(guidance, guidance.indexOf(entry));
}

/* Static filter rules, one block per known situation (selectors depend on the anchors). */
const filterCss = SPECIFIC_SITUATIONS.map((situation) => {
  const target = `[data-guide]:has(#${SITUATION_ANCHOR[situation]}:target)`;
  const hidden = `:not([data-situations~="any"]):not([data-situations~="${situation}"])`;
  return [
    `${target} [data-guide-step]${hidden} { display: none; }`,
    `${target} [data-filter-status="${situation}"] { display: flex; }`,
    `${target} [data-situation-link="${situation}"] { background: var(--c-accent); border-color: var(--c-accent); color: var(--c-on-accent); }`,
    `${target} [data-situation-link="${situation}"] .picker-chev { color: var(--c-on-accent); }`,
  ].join("\n");
}).join("\n");
---
<div data-guide>
  <style is:inline set:html={filterCss}></style>

  {
    situations.length > 0 ? (
      <div class="picker-wrap mb-10" data-no-print>
        <SituationPicker situations={situations} base="" allAnchor={ALL_ANCHOR} headingId="kde-zemrel" />
      </div>
    ) : null
  }

  <div class="prose-b mb-8"><slot /></div>

  {
    situations.map((situation) => (
      <span id={SITUATION_ANCHOR[situation]} class="guide-target" />
    ))
  }
  <span id={ALL_ANCHOR} class="guide-target" />

  {
    situations.map((situation) => (
      <p class="filter-status mb-6" data-filter-status={situation} data-no-print>
        <span>
          {ui.filterShowing} <strong>{situationLabels[situation]}</strong>
        </span>
        <a href={`#${ALL_ANCHOR}`} class="btn btn-quiet">
          {ui.filterShowAll}
        </a>
      </p>
    ))
  }

  <nav aria-label={ui.phasesNav} class="phase-nav" data-no-print>
    <ol class="phase-nav-list flex flex-wrap gap-2">
      {
        phases.map((group) => (
          <li data-guide-step data-situations={group.situations}>
            <a href={`#${group.anchor}`} class="btn btn-quiet min-h-11 px-3 text-[0.9375rem] font-semibold">
              <span class="num phase-nav-num text-muted" /> {group.label}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class="phases mt-10 space-y-12">
    {
      phases.map((group) => (
        <section aria-labelledby={group.anchor} class="phase" data-guide-step data-situations={group.situations}>
          <h2 id={group.anchor} class="flex items-baseline gap-3 border-b border-line pb-2">
            <span class="num phase-num text-muted" aria-hidden="true" />
            <span>{group.label}</span>
          </h2>
          <ol class="mt-2">
            {group.entries.map((entry) => {
              const Content = rendered.get(entry.id);
              const situations = entry.data.situations.filter((situation) => situation !== "any");
              const next = nextOf(entry);
              return (
                <li id={entry.id} class="guidance-entry border-b border-hair py-6" data-guide-step data-situations={situationsAttribute(entry)}>
                  <PlaceholderMark active={entry.data.placeholder} kind="content">
                    <div class="grid gap-4 md:grid-cols-12 md:gap-x-8">
                      <div class="md:col-span-7">
                        <h3>{entry.data.title}</h3>
                        {situations.length > 0 ? (
                          <p class="mt-1 text-[0.9375rem] font-semibold text-muted">
                            {situations.map((situation) => situationLabels[situation]).join(" · ")}
                          </p>
                        ) : null}
                        <p class="mt-2 text-[1.1875rem]">{entry.data.summary}</p>
                        <ReviewFlag site={site} reviewedAt={entry.data.review.reviewedAt} />
                        {Content !== undefined ? (
                          <>
                            <details class="details-b mt-2">
                              <summary>
                                <LineIcon name="chevron" class="chev" />
                                {ui.detailedSteps}
                              </summary>
                              <div class="prose-b pb-2 pl-7"><Content /></div>
                            </details>
                            <div class="print-only prose-b mt-2"><Content /></div>
                          </>
                        ) : null}
                        <p class="mt-3" data-no-print>
                          {next !== null ? (
                            <a href={`#${next.id}`} class="text-link next-link">
                              {ui.nextStep}: {next.data.title}
                              <LineIcon name="chevron" />
                            </a>
                          ) : (
                            <span class="text-muted">{ui.lastStep}</span>
                          )}
                        </p>
                      </div>
                      <div class="space-y-4 md:col-span-5">
                        {entry.data.checklist.length > 0 ? (
                          <fieldset class="tick-set">
                            <legend class="font-semibold">{ui.prepareList}</legend>
                            <p class="text-[0.9375rem] text-muted" data-no-print>{ui.tickHint}</p>
                            <ul class="tick-list mt-2">
                              {entry.data.checklist.map((item, itemIndex) => (
                                <li>
                                  <label class="tick" for={`${entry.id}-bod-${itemIndex + 1}`}>
                                    <input type="checkbox" id={`${entry.id}-bod-${itemIndex + 1}`} class="tick-box" />
                                    <span class="tick-text">{item}</span>
                                  </label>
                                </li>
                              ))}
                            </ul>
                          </fieldset>
                        ) : null}
                        {entry.data.contactPrompt === "emergency" && site.emergency.enabled ? (
                          <div data-emergency-block>
                            <p class="text-[0.9375rem] font-semibold">{ui.callEmergencyPrompt}</p>
                            <EmergencyPhoneLink
                              emergency={site.emergency}
                              variant="full"
                              class="btn btn-emergency mt-2 flex-wrap text-left"
                              numberClass="num"
                            >
                              <LineIcon name="phone" />
                            </EmergencyPhoneLink>
                          </div>
                        ) : null}
                        {entry.data.contactPrompt === "office" ? (
                          <div>
                            <p class="text-[0.9375rem] font-semibold">{ui.callOfficePrompt}</p>
                            <PhoneLink number={office.number} class="btn btn-outline mt-2 flex-wrap justify-start text-left">
                              <LineIcon name="phone" />
                              <span>{office.label}</span>
                              <span class="num">{officeNumber.display}</span>
                            </PhoneLink>
                          </div>
                        ) : null}
                      </div>
                    </div>
                  </PlaceholderMark>
                </li>
              );
            })}
          </ol>
        </section>
      ))
    }
  </div>
</div>

<style>
  .guide-target {
    display: block;
    height: 0;
  }

  .filter-status {
    display: none;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--c-accent);
    border-radius: 0.25rem;
    background: var(--c-surface);
  }

  /* Phase numbers follow the visible phases only. */
  .phase-nav-list,
  .phases {
    counter-reset: phase;
  }

  .phase-nav-list > li,
  .phases > .phase {
    counter-increment: phase;
  }

  .phase-nav-num::before,
  .phase-num::before {
    content: counter(phase) ".";
  }

  .tick-set {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }

  .tick-list {
    border-top: 1px solid var(--c-hair);
  }

  .tick {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    min-height: 3rem;
    padding-block: 0.625rem;
    border-bottom: 1px solid var(--c-hair);
    cursor: pointer;
  }

  .tick-box {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.125rem;
    accent-color: var(--c-accent);
    cursor: pointer;
  }

  .tick-box:checked + .tick-text {
    color: var(--c-muted);
    text-decoration: line-through;
  }

  .next-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    font-weight: 600;
  }
</style>

---
import PhoneLink from "@core/components/PhoneLink.astro";
import { getCoffins, getPage, getSiteContext } from "@core/content/load.ts";
import Site from "../layouts/Site.astro";
import PageHeading from "../components/PageHeading.astro";
import UniformCatalogueGrid, { type CatalogueItem } from "../components/UniformCatalogueGrid.astro";
import { ui } from "../i18n/cs.ts";
import { primaryOfficePhone, seoTitle } from "../lib/site.ts";

const site = await getSiteContext();
const page = await getPage("rakve");
const coffins = await getCoffins();
const office = primaryOfficePhone(site);
const Body = page.Content;
const items: CatalogueItem[] = coffins.map((coffin) => {
  const facts: CatalogueItem["facts"] = [];
  if (coffin.data.material !== null) {
    facts.push({ label: ui.material, value: coffin.data.material });
  }
  if (coffin.data.code !== null) {
    facts.push({ label: ui.code, value: coffin.data.code });
  }
  return {
    id: coffin.id,
    name: coffin.data.name,
    image: coffin.data.image,
    placeholder: coffin.data.placeholder,
    facts,
    summary: coffin.data.summary,
  };
});
---
<Site site={site} title={seoTitle(page.data)} description={page.data.metaDescription}>
  <PageHeading title={page.data.title} lead={page.data.lead} placeholder={page.data.placeholder} />
  <div class="band">
    <div class="container-b space-y-10">
      <div class="prose-b"><Body /></div>
      <UniformCatalogueGrid site={site} items={items} aspect="4/3" headingId="nabidka-rakvi" heading={ui.coffinsHeading} />
      <p class="border-t border-line pt-6" data-office-phones>
        {ui.catalogueContact}: <span class="text-muted">{office.label}</span>{" "}
        <PhoneLink number={office.number} class="num inline-flex min-h-11 items-center font-semibold" />
      </p>
    </div>
  </div>
</Site>

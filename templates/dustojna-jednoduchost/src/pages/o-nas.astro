---
import { getPage, getSiteContext } from "@core/content/load.ts";
import { resolveOptionalImage } from "@core/media/resolve.ts";
import Site from "../layouts/Site.astro";
import PageHeading from "../components/PageHeading.astro";
import FactSheet from "../components/FactSheet.astro";
import StoryFigure from "../components/StoryFigure.astro";
import { seoTitle } from "../lib/site.ts";

const site = await getSiteContext();
const page = await getPage("o-nas");
const image = resolveOptionalImage(page.data.heroImage);
const Body = page.Content;
---
<Site site={site} title={seoTitle(page.data)} description={page.data.metaDescription} image={image?.src ?? null}>
  <PageHeading title={page.data.title} lead={page.data.lead} placeholder={page.data.placeholder} />
  <div class="band">
    <div class="container-b space-y-12">
      <FactSheet site={site} />
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-x-12">
        <div class="prose-b prose-quiet lg:col-span-7"><Body /></div>
        {image !== null ? <div class="lg:col-span-5"><StoryFigure image={image} /></div> : null}
      </div>
    </div>
  </div>
</Site>

---
/**
 * Jak postupovat: a long-form narrative article. Guidance entries are numbered <h2> sections
 * in reading order, with a sticky margin TOC on desktop, checklists as plain bulleted lists
 * and a boxed "Potřebujete převoz hned?" aside after the first section.
 */
import LetterLayout from "../layouts/LetterLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import MarginToc, { type TocItem } from "../components/MarginToc.astro";
import ShiftedBody from "../components/ShiftedBody.astro";
import EmergencyPhoneLink from "@core/components/EmergencyPhoneLink.astro";
import PhoneLink from "@core/components/PhoneLink.astro";
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import UnreviewedMark from "@core/components/UnreviewedMark.astro";
import { getGuidance, getPage, getSiteContext, render } from "@core/content/load.ts";
import { GUIDANCE_PHASE_LABEL, ui } from "../i18n/cs.ts";
import { formatCzechDate } from "../lib/content.ts";

const site = await getSiteContext();
const page = await getPage("jak-postupovat");
const guidance = await getGuidance();
const entries = await Promise.all(
  guidance.map(async (entry, index) => {
    const { Content } = await render(entry);
    const previous = guidance[index - 1];
    const phaseStarts = previous === undefined || previous.data.phase !== entry.data.phase;
    return { entry, Content, number: index + 1, phaseStarts };
  }),
);
const officePhone = site.contact.phones.find((phone) => phone.department === "office");
const toc: TocItem[] = entries.map(({ entry, number }) => ({
  href: `#${entry.id}`,
  label: entry.data.title,
  number: `${number}.`,
}));
---
<LetterLayout site={site} title={page.data.metaTitle ?? page.data.title} description={page.data.metaDescription}>
  <PageIntro title={page.data.title} lead={page.data.lead} placeholder={page.data.placeholder}>
    <div class="prose intro-body">
      <page.Content />
    </div>
  </PageIntro>

  <div class="frame article-grid">
    <div class="article-toc">
      <MarginToc items={toc} />
    </div>
    <article class="article" data-guidance-article>
      {
        entries.map(({ entry, Content, number, phaseStarts }, index) => (
          <>
            <section class="step" id={entry.id} aria-labelledby={`${entry.id}-nadpis`} data-guidance={entry.id} data-phase={entry.data.phase}>
              {phaseStarts ? <p class="label step-phase">{GUIDANCE_PHASE_LABEL[entry.data.phase]}</p> : null}
              <PlaceholderMark active={entry.data.placeholder} kind="content">
                <h2 id={`${entry.id}-nadpis`} class="step-heading">
                  <span class="step-num">{number}.</span> {entry.data.title}
                </h2>
                {entry.data.review.reviewedAt === null && site.mode === "prototype" ? (
                  <p>
                    <UnreviewedMark reviewedAt={entry.data.review.reviewedAt} />
                  </p>
                ) : null}
                <p class="step-summary">{entry.data.summary}</p>
                <ShiftedBody by={1} idPrefix={entry.id}>
                  <Content />
                </ShiftedBody>
                {entry.data.checklist.length > 0 ? (
                  <div class="prose step-checklist">
                    <p>
                      <strong>{ui.checklistLabel}:</strong>
                    </p>
                    <ul>
                      {entry.data.checklist.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                ) : null}
                {entry.data.contactPrompt === "emergency" && site.emergency.enabled ? (
                  <p class="step-prompt">
                    {ui.promptEmergency} <EmergencyPhoneLink emergency={site.emergency} variant="number" class="step-prompt-link" />
                  </p>
                ) : null}
                {entry.data.contactPrompt === "office" && officePhone !== undefined ? (
                  <p class="step-prompt">
                    {ui.promptOffice} <PhoneLink number={officePhone.number} class="step-prompt-link" />
                  </p>
                ) : null}
                {entry.data.review.reviewedAt !== null ? (
                  <p class="step-review">
                    {ui.reviewedOn} {formatCzechDate(entry.data.review.reviewedAt)}
                    {entry.data.review.sources.length > 0 ? (
                      <span>
                        {" · "}
                        {ui.sources}:{" "}
                        {entry.data.review.sources.map((source, sourceIndex) => (
                          <>
                            {sourceIndex > 0 ? ", " : null}
                            <a href={source.url} rel="noopener">
                              {source.title}
                            </a>
                          </>
                        ))}
                      </span>
                    ) : null}
                  </p>
                ) : null}
              </PlaceholderMark>
            </section>
            {index === 0 && site.emergency.enabled ? (
              <aside class="urgent" aria-label={site.emergency.label} data-urgent-aside>
                <p class="urgent-title">{ui.urgentAsideTitle}</p>
                {site.emergency.shortNote !== null ? <p>{site.emergency.shortNote}</p> : null}
                <p>
                  <EmergencyPhoneLink emergency={site.emergency} variant="full" class="urgent-link" />
                </p>
              </aside>
            ) : null}
          </>
        ))
      }
    </article>
  </div>
</LetterLayout>

<style>
  .intro-body:not(:empty) {
    margin-top: 1.5rem;
  }

  .article-grid {
    display: grid;
    gap: 2rem;
  }

  .article {
    max-width: var(--measure);
  }

  .step {
    padding-block: 2rem;
    border-top: 1px solid var(--rule);
  }

  .step-phase {
    margin-bottom: 0.75rem;
  }

  .step-num {
    font-family: var(--font-caption);
    font-style: italic;
    color: var(--accent);
    margin-right: 0.25rem;
  }

  .step-heading {
    margin-bottom: 0.75rem;
  }

  .step-summary {
    font-family: var(--font-caption);
    font-size: 1.25rem;
    line-height: 1.5;
    margin-block: 0.75rem 1rem;
  }

  :global([data-fonts="literata"]) .step-summary {
    font-size: 1.125rem;
  }

  .step-checklist {
    margin-top: 1.25rem;
  }

  .step-prompt {
    margin-top: 1.25rem;
    font-weight: 600;
  }

  .step :global(.step-prompt-link) {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    white-space: nowrap;
  }

  .step-review {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .urgent {
    margin-block: 0.5rem 2rem;
    border: 1px solid var(--rule);
    border-left: 4px solid var(--strip-bg);
    background: var(--surface);
    padding: 1.25rem 1.5rem;
  }

  .urgent-title {
    font-family: var(--font-subhead);
    font-weight: var(--subhead-weight);
    font-size: var(--subhead-size);
    margin-bottom: 0.25rem;
  }

  .urgent :global(.urgent-link) {
    display: inline-flex;
    flex-wrap: wrap;
    column-gap: 0.75rem;
    align-items: baseline;
    min-height: 2.75rem;
    padding-top: 0.5rem;
    font-weight: 600;
  }

  .urgent :global(.urgent-link [data-part="number"]) {
    font-size: 1.5rem;
    white-space: nowrap;
  }

  @media (min-width: 64rem) {
    .article-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 2rem;
      align-items: start;
    }

    .article-toc {
      grid-column: 1 / span 3;
      align-self: stretch;
    }

    .article {
      grid-column: 4 / span 7;
    }
  }
</style>

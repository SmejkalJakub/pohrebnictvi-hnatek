---
/**
 * Dark band above the letterhead with the nonstop transport line (design-differentiation §2.1).
 * Sticky on mobile; sticky on desktop too and with a larger number when emphasis is "high".
 * Renders nothing when the emergency service is disabled (content-contract §6.5 rule 6).
 */
import EmergencyPhoneLink from "@core/components/EmergencyPhoneLink.astro";
import type { SiteContext } from "@core/content/view-models.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  site: SiteContext;
  emphasis: "standard" | "high";
}

const { site, emphasis } = Astro.props;
---
{
  site.emergency.enabled ? (
    <div class="strip" data-utility-strip data-emphasis={emphasis}>
      <div class="frame strip-inner">
        <EmergencyPhoneLink emergency={site.emergency} variant="full" class="strip-link" labelClass="strip-label" numberClass="strip-number">
          <svg class="strip-glyph" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path
              fill="currentColor"
              d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"
            />
          </svg>
          <span class="strip-call" aria-hidden="true">{ui.call}</span>
        </EmergencyPhoneLink>
      </div>
    </div>
  ) : null
}

<style>
  .strip {
    background: var(--strip-bg);
    color: var(--strip-fg);
    position: sticky;
    top: 0;
    z-index: 30;
    font-family: var(--font-body);
  }

  .strip :global(:focus-visible) {
    outline-color: var(--strip-fg);
    outline-offset: -4px;
  }

  .strip-inner {
    display: flex;
    justify-content: center;
  }

  .strip :global(.strip-link) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 2.75rem;
    padding-block: 0.375rem;
    color: var(--strip-fg);
    text-decoration: none;
    font-size: 0.9375rem;
    line-height: 1.25;
  }

  .strip :global(.strip-glyph) {
    flex: none;
    order: 0;
  }

  .strip :global(.strip-label) {
    order: 1;
    flex: 1 1 auto;
    font-weight: 600;
  }

  .strip :global(.strip-number) {
    order: 2;
    display: none;
    font-weight: 600;
    font-variant-numeric: tabular-nums lining-nums;
    white-space: nowrap;
  }

  /* Mobile "Volat" affordance: a bordered pill on the right. */
  .strip-call {
    order: 3;
    flex: none;
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.125rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .strip :global(.strip-link:hover) .strip-call {
    background: var(--strip-fg);
    color: var(--strip-bg);
  }

  /* High emphasis, mobile: label over a larger number instead of the pill. */
  .strip[data-emphasis="high"] :global(.strip-link) {
    flex-wrap: wrap;
    column-gap: 0.5rem;
    row-gap: 0;
    padding-block: 0.5rem;
  }

  .strip[data-emphasis="high"] :global(.strip-label) {
    flex: 1 1 60%;
    font-size: 0.875rem;
  }

  .strip[data-emphasis="high"] :global(.strip-number) {
    display: inline;
    order: 3;
    flex-basis: 100%;
    padding-left: 1.625rem;
    font-size: 1.375rem;
  }

  .strip[data-emphasis="high"] .strip-call {
    order: 2;
  }

  @media (min-width: 40rem) {
    .strip :global(.strip-link) {
      width: auto;
      justify-content: center;
    }

    .strip :global(.strip-label) {
      flex: none;
    }

    .strip :global(.strip-number) {
      display: inline;
    }

    .strip :global(.strip-number)::before {
      content: "·";
      display: inline-block;
      margin-right: 0.5rem;
      opacity: 0.75;
    }

    .strip-call {
      display: none;
    }

    .strip[data-emphasis="high"] :global(.strip-link) {
      flex-wrap: nowrap;
      column-gap: 0.75rem;
    }

    .strip[data-emphasis="high"] :global(.strip-label) {
      flex: none;
      font-size: 1rem;
    }

    .strip[data-emphasis="high"] :global(.strip-number) {
      flex-basis: auto;
      padding-left: 0;
      font-size: 1.5rem;
      order: 2;
    }
  }

  /* Desktop: in normal flow unless emphasis is high. */
  @media (min-width: 64rem) {
    .strip[data-emphasis="standard"] {
      position: static;
    }
  }

  @media print {
    .strip {
      position: static;
      border-bottom: 1px solid #000;
    }

    .strip-call,
    .strip :global(.strip-glyph) {
      display: none;
    }
  }
</style>

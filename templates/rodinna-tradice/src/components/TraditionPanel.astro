---
/**
 * Typographic panel used instead of a hero photograph, like the seal on a letterhead. With a
 * brand mark (site.config brand.mark) the mark sits at its centre; the tradition wording is set
 * large between hairline rules, then the year (only when set) and the place, and at the foot the
 * live office status. It never repeats the brand name: the letterhead above already carries it
 * (design review 2026-11-13, §4 A).
 */
import { Image } from "astro:assets";
import OfficeStatus from "@core/components/OfficeStatus.astro";
import { brandMark } from "@core/brand/runtime.ts";
import type { SiteContext } from "@core/content/view-models.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  site: SiteContext;
}

const { site } = Astro.props;
const company = site.company;
const wording = company.tradition.publicWording;
const year = company.tradition.foundedYear;
const location = site.contact.locations[0];
const mark = brandMark();
let headline: string | null = wording;
if (headline === null && company.familyOwned === true) {
  headline = ui.familyOwned;
}
---
<div class:list={["tradition", { "has-mark": mark !== null }]} data-tradition-panel>
  <div class="tradition-inner">
    {mark !== null ? <Image src={mark} alt="" width={168} class="tradition-mark" loading="eager" /> : null}
    {headline !== null ? <p class="tradition-wording">{headline}</p> : null}
    {
      year !== null ? (
        <p class="tradition-year">
          {ui.foundedSince} {year}
        </p>
      ) : null
    }
    {location !== undefined ? <p class="tradition-place">{location.address.city}</p> : null}
  </div>
  <OfficeStatus site={site} class="tradition-status" />
</div>

<style>
  .tradition {
    background: var(--surface);
    padding: 1.25rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
  }

  .tradition-inner {
    width: 100%;
    border-block: 1px solid var(--ornament);
    padding-block: 2rem;
    text-align: center;
    display: grid;
    gap: 0.875rem;
    justify-items: center;
  }

  .tradition :global(.tradition-mark) {
    width: 7rem;
    height: auto;
    margin-bottom: 0.25rem;
  }

  .tradition-wording {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 1.625rem;
    line-height: 1.2;
    text-wrap: balance;
    max-width: 18rem;
    color: var(--ink);
  }

  .tradition-year {
    font-family: var(--font-caption);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--accent);
  }

  .tradition-place {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    border-top: 1px solid var(--ornament);
    padding-top: 0.75rem;
    min-width: 6rem;
    line-height: 1.6;
  }

  .tradition :global(.tradition-status) {
    justify-content: center;
    text-align: center;
  }

  @media (min-width: 64rem) {
    .tradition {
      padding: 2rem;
      min-height: 26rem;
    }

    .tradition-inner {
      padding-block: 3rem;
      gap: 1rem;
    }

    .tradition :global(.tradition-mark) {
      width: 8.5rem;
    }

    .tradition-wording {
      font-size: 1.875rem;
    }
  }
</style>

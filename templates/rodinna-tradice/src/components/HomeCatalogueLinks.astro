---
/** Optional home section: a short prose pointer to the coffin and flower catalogues. */
import { getPage } from "@core/content/load.ts";
import MarginSection from "./MarginSection.astro";
import { ui } from "../i18n/cs.ts";

const coffins = await getPage("rakve");
const flowers = await getPage("kvetiny");
---
<MarginSection id="nabidka" label={ui.sectionLabelCatalogue} heading={ui.catalogueHeading} section="catalogue-links">
  <div class="pair">
    <div>
      <h3>{coffins.data.title}</h3>
      {coffins.data.lead !== null ? <p>{coffins.data.lead}</p> : null}
      <a class="more-link" href="/rakve/">{ui.catalogueCoffins}</a>
    </div>
    <div>
      <h3>{flowers.data.title}</h3>
      {flowers.data.lead !== null ? <p>{flowers.data.lead}</p> : null}
      <a class="more-link" href="/kvetiny/">{ui.catalogueFlowers}</a>
    </div>
  </div>
</MarginSection>

<style>
  .pair {
    display: grid;
    gap: 2rem;
  }

  .pair h3 {
    margin-bottom: 0.375rem;
  }

  @media (min-width: 48rem) {
    .pair {
      grid-template-columns: 1fr 1fr;
      column-gap: 3rem;
    }

    .pair > div + div {
      border-left: 1px solid var(--rule);
      padding-left: 3rem;
    }
  }
</style>

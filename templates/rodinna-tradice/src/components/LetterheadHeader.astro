---
/**
 * Letterhead header: centred wordmark (or logo) above a hairline rule and a centred text
 * navigation. On mobile the wordmark sits beside a "Menu" text button and the menu opens as
 * a full list in the normal flow (not an overlay). Without JS the list is simply shown.
 */
import { Image } from "astro:assets";
import type { SiteContext } from "@core/content/view-models.ts";
import { resolveOptionalImage } from "@core/media/resolve.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  site: SiteContext;
  currentPath: string;
}

const { site, currentPath } = Astro.props;
const logo = resolveOptionalImage(site.company.logo);
const brand = site.company.brandName;

function isCurrent(href: string): boolean {
  return currentPath === href;
}
---
<header class="letterhead" data-letterhead>
  <div class="frame">
    <div class="masthead">
      <span class="masthead-balance" aria-hidden="true"></span>
      <a class="wordmark" href="/" aria-label={`${brand} – ${ui.homeLink}`}>
        {
          logo !== null ? (
            <Image src={logo.src} alt="" height={72} class="logo" loading="eager" />
          ) : (
            <span class="wordmark-text">{brand}</span>
          )
        }
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="hlavni-menu" data-menu-toggle data-close-label={ui.menuClose}>
        <span data-menu-label>{ui.menu}</span>
      </button>
    </div>
    <nav class="nav" aria-label={ui.mainNav}>
      <ul id="hlavni-menu" class="nav-list" data-collapsed>
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const list = document.getElementById("hlavni-menu");
  if (toggle !== null && list !== null) {
    const label = toggle.querySelector("[data-menu-label]");
    const openText = label?.textContent ?? "Menu";
    const setOpen = (open: boolean): void => {
      toggle.setAttribute("aria-expanded", String(open));
      if (open) {
        list.removeAttribute("data-collapsed");
      } else {
        list.setAttribute("data-collapsed", "");
      }
      if (label !== null) {
        if (open) {
          label.textContent = toggle.dataset.closeLabel ?? openText;
        } else {
          label.textContent = openText;
        }
      }
    };
    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .letterhead {
    padding-top: 1.25rem;
  }

  .masthead {
    display: grid;
    grid-template-columns: 4.75rem 1fr 4.75rem;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .wordmark {
    justify-self: center;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--ink);
    text-decoration: none;
    text-align: center;
  }

  .wordmark-text {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 1.75rem;
    line-height: 1.1;
    letter-spacing: 0.01em;
    text-wrap: balance;
  }

  .logo {
    height: 3.5rem;
    width: auto;
  }

  .menu-toggle {
    justify-self: end;
    min-height: 2.75rem;
    min-width: 4.5rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--rule);
    background: transparent;
    color: var(--ink);
    font: 600 0.9375rem/1 var(--font-body);
    letter-spacing: 0.04em;
    cursor: pointer;
  }

  .menu-toggle[aria-expanded="true"] {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  :global(html.no-js) .menu-toggle {
    visibility: hidden;
  }

  .nav-list {
    display: flex;
    flex-direction: column;
  }

  .nav-list a {
    display: flex;
    align-items: center;
    min-height: 3rem;
    padding-block: 0.25rem;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 1.375rem;
    text-decoration: none;
  }

  :global([data-fonts="literata"]) .nav-list a {
    font-family: var(--font-subhead);
    font-weight: var(--subhead-weight);
    font-size: 1.125rem;
  }

  .nav-list a[aria-current="page"] {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  :global(html.js) .nav-list[data-collapsed] {
    display: none;
  }

  @media (min-width: 64rem) {
    .letterhead {
      padding-top: 2.25rem;
    }

    .masthead {
      display: flex;
      justify-content: center;
      padding-bottom: 1.25rem;
    }

    .masthead-balance,
    .menu-toggle {
      display: none;
    }

    .wordmark-text {
      font-size: 2.5rem;
    }

    .logo {
      height: 4.5rem;
    }

    .nav-list,
    :global(html.js) .nav-list[data-collapsed] {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      column-gap: 2rem;
      border-bottom: 1px solid var(--rule);
    }

    .nav-list a {
      min-height: 3.25rem;
      border-bottom: 0;
      font-family: var(--font-body);
      font-weight: 400;
      font-size: 1rem;
      letter-spacing: 0.02em;
    }

    :global([data-fonts="literata"]) .nav-list a {
      font-family: var(--font-body);
      font-weight: 400;
      font-size: 0.9375rem;
    }
  }

  @media print {
    .menu-toggle,
    .nav {
      display: none;
    }
  }
</style>

---
/**
 * "Jak vám pomůžeme": services in two or three headed prose paragraphs by category,
 * each service an inline link to its anchor on /sluzby/. Deliberately not cards.
 */
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import { getServices, serviceHref } from "@core/content/load.ts";
import MarginSection from "./MarginSection.astro";
import { SERVICE_PROSE_GROUPS, ui } from "../i18n/cs.ts";

const services = await getServices();
const groups = SERVICE_PROSE_GROUPS.map((group) => ({
  title: group.title,
  services: services.filter((service) => group.categories.includes(service.data.category)),
})).filter((group) => group.services.length > 0);
---
<MarginSection id="sluzby-prehled" label={ui.sectionLabelServices} heading={ui.servicesHeading} section="services">
  <div class="groups">
    {
      groups.map((group) => (
        <div class="group">
          <h3>{group.title}</h3>
          <p>
            {group.services.map((service) => (
              <PlaceholderMark active={service.data.placeholder} kind="content" as="span">
                <span class="service-run" data-service={service.id}>
                  <a href={serviceHref(service.id, false)}>{service.data.title}</a>. {service.data.summary}{" "}
                </span>
              </PlaceholderMark>
            ))}
          </p>
        </div>
      ))
    }
  </div>
  <p>
    <a class="more-link" href="/sluzby/">{ui.allServices}</a>
  </p>
</MarginSection>

<style>
  .groups {
    display: grid;
    gap: 1.75rem;
    max-width: var(--measure);
    margin-bottom: 1rem;
  }

  .group h3 {
    margin-bottom: 0.375rem;
  }

  .service-run a {
    font-weight: 600;
  }

  .groups :global([data-placeholder="content"]) {
    display: inline;
  }

  .groups :global([data-placeholder="content"] > [data-placeholder-label]) {
    margin-bottom: 0;
    margin-right: 0.375rem;
  }
</style>

---
/** Služby: H1, lead, the index table (služba · co zahrnuje · cena · Detail), the VAT note. */
import VatNote from "@core/components/VatNote.astro";
import { getPage, getPricing, getServices, getSiteContext } from "@core/content/load.ts";
import IndexLayout from "../../layouts/IndexLayout.astro";
import SheetHead from "../../components/SheetHead.astro";
import ServiceIndexTable, { type ServiceRow } from "../../components/ServiceIndexTable.astro";
import ReferenceBody from "../../components/ReferenceBody.astro";
import { descriptionFor, groupFor, titleFor } from "../../lib/directory.ts";

const site = await getSiteContext();
const page = await getPage("sluzby");
const services = await getServices();
const pricing = await getPricing();
const rows: ServiceRow[] = services.map((entry) => ({
  entry,
  price: groupFor(pricing, entry.data.priceGroupId)?.items[0] ?? null,
}));
const hasPrice = rows.some((row) => row.price !== null);
const Body = page.Content;
---
<IndexLayout site={site} title={titleFor(page.data)} description={descriptionFor(page.data)}>
  <SheetHead title={page.data.title} lead={page.data.lead} placeholder={page.data.placeholder} />
  <ServiceIndexTable rows={rows} />
  {hasPrice && pricing !== null ? <VatNote pricing={pricing} class="sheet-note" /> : null}
  <ReferenceBody show={page.hasBody}><Body /></ReferenceBody>
</IndexLayout>

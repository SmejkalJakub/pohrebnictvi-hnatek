---
/** 404: "Stránka nenalezena", one sentence, and the whole index as <details> rows. */
import { getGuidance, getServices, getSiteContext } from "@core/content/load.ts";
import { SITUATION_ANCHOR, chooserSituations } from "@core/content/guidance-flow.ts";
import { serviceHref } from "@core/content/view-models.ts";
import IndexLayout from "../layouts/IndexLayout.astro";
import RegisterList, { type SubLink } from "../components/RegisterList.astro";
import { loadIndex } from "../lib/index-entries.ts";
import { situationButtons, ui } from "../i18n/cs.ts";

const site = await getSiteContext();
const entries = await loadIndex(site, "/404.html", false);
const services = await getServices();
const guidance = await getGuidance();
const children: Record<string, SubLink[]> = {
  "jak-postupovat": chooserSituations(guidance).map((situation) => ({
    label: situationButtons[situation],
    href: `/jak-postupovat/#${SITUATION_ANCHOR[situation]}`,
  })),
  sluzby: services.map((service) => ({ label: service.data.title, href: serviceHref(service.id, true) })),
};
---
<IndexLayout site={site} title={ui.notFoundTitle} description={ui.notFoundText} noindex>
  <div class="sheet-head">
    <h1 class="sheet-title">{ui.notFoundTitle}</h1>
    <p class="sheet-lead">{ui.notFoundText}</p>
  </div>
  <RegisterList entries={entries} children={children} />
  <p class="sheet-more"><a href="/">{ui.homeLink}</a></p>
</IndexLayout>

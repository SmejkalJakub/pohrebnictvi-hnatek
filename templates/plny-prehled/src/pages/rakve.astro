---
/** Rakve: H1, lead, the catalogue table (thumbnail 4:3, name, code / material, description). */
import { getCoffins, getPage, getSiteContext } from "@core/content/load.ts";
import IndexLayout from "../layouts/IndexLayout.astro";
import SheetHead from "../components/SheetHead.astro";
import CatalogueTable, { type CatalogueItem } from "../components/CatalogueTable.astro";
import NoCatalogueItems from "../components/NoCatalogueItems.astro";
import ReferenceBody from "../components/ReferenceBody.astro";
import { ui } from "../i18n/cs.ts";
import { descriptionFor, titleFor } from "../lib/directory.ts";

const site = await getSiteContext();
const page = await getPage("rakve");
const coffins = await getCoffins();
const items: CatalogueItem[] = coffins.map((entry) => {
  const meta = [entry.data.code, entry.data.material].filter((part): part is string => part !== null).join(", ");
  return {
    id: entry.id,
    name: entry.data.name,
    meta: meta === "" ? null : meta,
    summary: entry.data.summary,
    image: entry.data.image,
    placeholder: entry.data.placeholder,
  };
});
const Body = page.Content;
---
<IndexLayout site={site} title={titleFor(page.data)} description={descriptionFor(page.data)}>
  <SheetHead title={page.data.title} lead={page.data.lead} placeholder={page.data.placeholder} />
  {
    items.length > 0 ? (
      <CatalogueTable items={items} metaLabel={`${ui.codeCol}, ${ui.materialCol.toLowerCase()}`} thumb={{ width: 96, height: 72 }} />
    ) : (
      <NoCatalogueItems site={site} />
    )
  }
  <ReferenceBody show={page.hasBody}><Body /></ReferenceBody>
</IndexLayout>

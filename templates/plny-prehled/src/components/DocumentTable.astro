---
/** Dokumenty ke stažení: title (link) · PDF · Platí od. */
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import type { DocumentView } from "@core/content/view-models.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  documents: DocumentView[];
}

const { documents } = Astro.props;
---
<table class="t documents">
  <thead>
    <tr>
      <th scope="col">{ui.nameCol}</th>
      <th scope="col">{ui.fileCol}</th>
      <th scope="col" class="num">{ui.validFromCol}</th>
    </tr>
  </thead>
  <tbody>
    {
      documents.map((document) => (
        <tr>
          <th scope="row">
            <PlaceholderMark active={document.placeholder} as="span">
              <a href={document.href}>{document.title}</a>
            </PlaceholderMark>
          </th>
          <td class="mono">{ui.pdf}</td>
          <td class="num mono">{document.validFromText ?? ui.none}</td>
        </tr>
      ))
    }
  </tbody>
</table>

---
/**
 * The highlighted nonstop box in the header of every page except notices: highlight fill, a 2 px
 * ink border (the highlight alone fails 3 : 1 against the ground), the label in bold and the
 * number in mono, underlined, never wrapping. emergencyEmphasis "high" doubles its height (CSS,
 * html[data-emphasis="high"]). The only place the highlight colour is used.
 */
import EmergencyPhoneLink from "@core/components/EmergencyPhoneLink.astro";
import type { EmergencyTransport } from "@core/content/schemas.ts";

interface Props {
  emergency: EmergencyTransport;
}

const { emergency } = Astro.props;
---
<EmergencyPhoneLink
  emergency={emergency}
  variant="full"
  class="nonstop-box"
  labelClass="nonstop-label"
  numberClass="nonstop-number mono"
/>

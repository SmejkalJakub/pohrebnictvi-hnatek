---
/**
 * Price packages (groups with inclusion lists), two side by side under 3 px rules. A package
 * with one item shows its price in mono at the right of the title, as drawn; a package with more
 * items lists them under the title. Then "V ceně je zahrnuto" / "Není zahrnuto".
 */
import PriceValue from "@core/components/PriceValue.astro";
import type { PriceGroup } from "@core/content/schemas.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  groups: PriceGroup[];
}

const { groups } = Astro.props;
---
<div class="packages">
  {
    groups.map((group) => (
      <section id={group.id} class="package" aria-labelledby={`balicek-${group.id}`}>
        <div class="package-head">
          <h2 id={`balicek-${group.id}`} class="package-title">{group.title}</h2>
          {group.items.length === 1 && group.items[0] !== undefined ? (
            <PriceValue item={group.items[0]} class="mono package-price" />
          ) : null}
        </div>
        {group.description !== null ? <p class="package-note">{group.description}</p> : null}
        {group.items.length > 1 ? (
          <table class="kv package-items">
            <tbody>
              {group.items.map((item) => (
                <tr>
                  <th scope="row">{item.label}</th>
                  <td class="num">
                    <PriceValue item={item} class="mono" />
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : null}
        <div class="package-lists">
          {group.includes.length > 0 ? (
            <div>
              <h3 class="list-title">{ui.includes}</h3>
              <ul class="bullets">
                {group.includes.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            </div>
          ) : null}
          {group.excludes.length > 0 ? (
            <div>
              <h3 class="list-title">{ui.excludes}</h3>
              <ul class="bullets">
                {group.excludes.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            </div>
          ) : null}
        </div>
      </section>
    ))
  }
</div>

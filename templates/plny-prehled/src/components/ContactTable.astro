---
/** Kontakty as a key–value table: address with the map link, every phone in mono, e-mails. */
import PhoneLink from "@core/components/PhoneLink.astro";
import type { SiteContext } from "@core/content/view-models.ts";
import { formatAddressInline } from "@core/format/address.ts";
import Sep from "./Sep.astro";
import { mapLink, officeLocation } from "../lib/directory.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  site: SiteContext;
}

const { site } = Astro.props;
const location = officeLocation(site);
const map = mapLink(location);
---
<table class="t contacts">
  <tbody>
    <tr>
      <th scope="row" class="key">{ui.addressRow}</th>
      <td>
        {location.name}, {formatAddressInline(location.address)}
        {
          map !== null ? (
            <>
              <Sep />
              <a href={map}>{ui.mapLink}</a>
            </>
          ) : null
        }
      </td>
    </tr>
    {
      location.accessNote !== null ? (
        <tr>
          <th scope="row" class="key">{ui.accessRow}</th>
          <td>{location.accessNote}</td>
        </tr>
      ) : null
    }
    {
      site.contact.phones.map((phone) => (
        <tr>
          <th scope="row" class="key">{phone.label}</th>
          <td>
            <PhoneLink number={phone.number} class="mono nowrap" />
          </td>
        </tr>
      ))
    }
    {
      site.contact.emails.map((email) => (
        <tr>
          <th scope="row" class="key">{email.label}</th>
          <td>
            <a href={`mailto:${email.address}`}>{email.address}</a>
          </td>
        </tr>
      ))
    }
  </tbody>
</table>

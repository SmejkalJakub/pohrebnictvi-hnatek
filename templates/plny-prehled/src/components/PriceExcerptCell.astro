---
/**
 * "Ceník, výběr": the first item of each price group (at most five) with its price in mono,
 * the VAT note (research L9), and the link to the whole price list.
 */
import PriceValue from "@core/components/PriceValue.astro";
import VatNote from "@core/components/VatNote.astro";
import type { PriceItem } from "@core/content/schemas.ts";
import type { PricingView } from "@core/content/view-models.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  pricing: PricingView;
  items: PriceItem[];
}

const { pricing, items } = Astro.props;
---
<table class="kv">
  <tbody>
    {
      items.map((item) => (
        <tr>
          <th scope="row">{item.label}</th>
          <td class="num">
            <PriceValue item={item} class="mono" />
          </td>
        </tr>
      ))
    }
  </tbody>
</table>
<VatNote pricing={pricing} class="vat-note" />
<p class="cell-more"><a href="/cenik/">{ui.fullPriceList}</a></p>

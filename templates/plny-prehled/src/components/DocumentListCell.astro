---
/** "Dokumenty" on home: the PDF links, each followed by "PDF" in mono. */
import type { DocumentView } from "@core/content/view-models.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  documents: DocumentView[];
}

const { documents } = Astro.props;
---
<ul class="cell-list">
  {
    documents.map((document) => (
      <li>
        <a href={document.href}>{document.title}</a>{" "}<span class="mono muted">{ui.pdf}</span>
      </li>
    ))
  }
</ul>

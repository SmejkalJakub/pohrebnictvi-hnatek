---
/**
 * One notice as a reference sheet: name (h1) with an optional 4:5 photo thumbnail, the ceremony
 * sentence, then a fact table (Narozen(a), Zemřel(a), Rozloučení, Místo + mapa, Obřad, Přenos as a
 * plain link (research L14), Kondolence, Od rodiny), the notice text, the parte and the QR code.
 * Nothing promotional (research L1).
 */
import { Image } from "astro:assets";
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import type { LoadedNotice } from "@core/content/load.ts";
import { resolveOptionalImage } from "@core/media/resolve.ts";
import NoticeQrBlock from "./NoticeQrBlock.astro";
import Sep from "./Sep.astro";
import { ui, weekdayShort } from "../i18n/cs.ts";

interface Props {
  notice: LoadedNotice;
}

const { notice } = Astro.props;
const view = notice.view;
const ceremony = view.ceremony;
const photo = resolveOptionalImage(view.photo);
const parte = resolveOptionalImage(view.parteImage);
const Body = notice.Content;
let sentence: string | null = null;
if (ceremony !== null && ceremony.weekday !== null && ceremony.dateText !== null) {
  sentence = ui.ceremonySentence(ceremony.weekday, ceremony.dateText, ceremony.timeText, ceremony.placeName);
}
let farewell: string | null = null;
if (ceremony !== null && ceremony.dateText !== null) {
  farewell = ceremony.dateText;
  if (ceremony.weekday !== null) {
    farewell = `${weekdayShort[ceremony.weekday] ?? ceremony.weekday} ${farewell}`;
  }
  if (ceremony.timeText !== null) {
    farewell = `${farewell}, ${ceremony.timeText}`;
  }
}
let place: string | null = null;
if (ceremony !== null) {
  const parts = [ceremony.placeName, ceremony.address].filter((part): part is string => part !== null);
  if (parts.length > 0) {
    place = parts.join(", ");
  }
}
---
<article class="notice" data-notice={view.id}>
  <p class="notice-back no-print"><a href="/oznameni/">{ui.allNotices}</a></p>
  <PlaceholderMark active={view.placeholder} as="div">
    <div class="notice-head">
      <h1 class="sheet-title notice-title">{view.fullName}</h1>
      {
        photo !== null ? (
          <Image src={photo.src} alt={photo.alt} width={96} height={120} densities={[1, 2]} class="notice-photo" style={`object-position: ${photo.objectPosition}`} loading="eager" />
        ) : null
      }
    </div>
    {sentence !== null ? <p class="notice-sentence">{sentence}</p> : null}
    <table class="t facts">
      <tbody>
        {
          view.bornText !== null ? (
            <tr>
              <th scope="row" class="key">{ui.born}</th>
              <td class="mono">{view.bornText}</td>
            </tr>
          ) : null
        }
        <tr>
          <th scope="row" class="key">{ui.died}</th>
          <td class="mono">{view.diedText}</td>
        </tr>
        {
          farewell !== null ? (
            <tr>
              <th scope="row" class="key">{ui.farewell}</th>
              <td class="mono">{farewell}</td>
            </tr>
          ) : null
        }
        {
          place !== null ? (
            <tr>
              <th scope="row" class="key">{ui.place}</th>
              <td>
                {place}
                {ceremony !== null && ceremony.mapUrl !== null ? (
                  <>
                    <Sep />
                    <a href={ceremony.mapUrl}>{ui.mapLink}</a>
                  </>
                ) : null}
              </td>
            </tr>
          ) : null
        }
        {
          ceremony !== null ? (
            <tr>
              <th scope="row" class="key">{ui.ceremony}</th>
              <td>{ceremony.typeLabel}</td>
            </tr>
          ) : null
        }
        {
          view.livestreamUrl !== null ? (
            <tr>
              <th scope="row" class="key">{ui.stream}</th>
              <td>
                <a href={view.livestreamUrl}>{ui.streamLink}</a>
              </td>
            </tr>
          ) : null
        }
        {
          view.condolencesEmail !== null ? (
            <tr>
              <th scope="row" class="key">{ui.condolences}</th>
              <td>
                {ui.condolencesIntro}{" "}
                <a href={`mailto:${view.condolencesEmail}`}>{view.condolencesEmail}</a>
                {ui.condolencesOutro}
              </td>
            </tr>
          ) : null
        }
        {
          view.familyNote !== null ? (
            <tr>
              <th scope="row" class="key">{ui.fromFamily}</th>
              <td>{view.familyNote}</td>
            </tr>
          ) : null
        }
      </tbody>
    </table>
    {
      notice.hasBody ? (
        <div class="ref-body notice-body">
          <Body />
        </div>
      ) : null
    }
    {
      parte !== null ? (
        <figure class="notice-parte">
          <Image src={parte.src} alt={parte.alt} width={480} class="parte-image" />
        </figure>
      ) : null
    }
    {
      view.partePdfHref !== null ? (
        <p class="sheet-note">
          <a href={view.partePdfHref}>{ui.parteLink}</a>
        </p>
      ) : null
    }
  </PlaceholderMark>
  <NoticeQrBlock notice={view} />
</article>

---
/** The notice's QR code (core <NoticeQrCode>), the printable file, and the print instruction. */
import NoticeQrCode from "@core/components/NoticeQrCode.astro";
import type { NoticeView } from "@core/content/view-models.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  notice: NoticeView;
}

const { notice } = Astro.props;
---
<div class="qr-block">
  <NoticeQrCode notice={notice} class="qr-code" />
  <div>
    <p><a href={notice.qr.href}>{ui.qrFile}</a></p>
    <p class="muted no-print">{ui.printNotice}</p>
  </div>
</div>

---
/**
 * The situation matrix (desktop): rows are steps, columns are Doma · Nemocnice · Domov ·
 * Zahraničí with "ano" or "—" in words. Picking a situation hides the other columns and the rows
 * that do not apply (filter CSS in jak-postupovat). Step numbers come from a CSS counter, so they
 * stay continuous when rows are hidden. On phones a short "Krok / Platí pro" table replaces it.
 */
import type { CollectionEntry } from "astro:content";
import EmergencyPhoneLink from "@core/components/EmergencyPhoneLink.astro";
import { showsFor, situationsAttribute, type SpecificSituation } from "@core/content/guidance-flow.ts";
import type { SiteContext } from "@core/content/view-models.ts";
import { situationColumns, situationWords, ui } from "../i18n/cs.ts";

interface Props {
  site: SiteContext;
  steps: CollectionEntry<"guidance">[];
  situations: SpecificSituation[];
}

const { site, steps, situations } = Astro.props;

function appliesText(entry: CollectionEntry<"guidance">): string {
  if (entry.data.situations.includes("any")) {
    return ui.everyone;
  }
  const named = entry.data.situations.filter((situation) => situation !== "any") as SpecificSituation[];
  return named.map((situation) => situationWords[situation]).join(", ");
}
---
<div class="matrix-wrap">
  <table class="t matrix">
    <thead>
      <tr>
        <th scope="col">{ui.stepColumn}</th>
        <th scope="col">{ui.whatColumn}</th>
        {situations.map((situation) => <th scope="col" data-col={situation}>{situationColumns[situation]}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        steps.map((entry) => (
          <tr data-guide-step data-situations={situationsAttribute(entry)}>
            <th scope="row" class="strong">
              <a href={`#${entry.id}`} class="step-ref">
                <span class="step-n"></span>
                {entry.data.title}
              </a>
            </th>
            <td>
              {entry.data.summary}
              {entry.data.contactPrompt === "emergency" ? (
                <>
                  {" "}
                  <EmergencyPhoneLink emergency={site.emergency} variant="number" numberClass="mono nowrap" />
                </>
              ) : null}
            </td>
            {situations.map((situation) => (
              <td data-col={situation}>{showsFor(entry, situation) ? ui.yes : ui.none}</td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
<table class="t applies">
  <thead>
    <tr>
      <th scope="col">{ui.stepColumn}</th>
      <th scope="col">{ui.appliesColumn}</th>
    </tr>
  </thead>
  <tbody>
    {
      steps.map((entry) => (
        <tr data-guide-step data-situations={situationsAttribute(entry)}>
          <td>
            <a href={`#${entry.id}`} class="step-ref">
              <span class="step-n"></span>
              {entry.data.title}
            </a>
          </td>
          <td>{appliesText(entry)}</td>
        </tr>
      ))
    }
  </tbody>
</table>

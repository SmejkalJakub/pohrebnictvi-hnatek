---
/**
 * "Převoz zesnulých" on Kontakt: its own heading and table (data-emergency-block), never shared
 * with the office hours. Dostupnost, Oblast and the nonstop number.
 */
import EmergencyPhoneLink from "@core/components/EmergencyPhoneLink.astro";
import type { EmergencyTransport } from "@core/content/schemas.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  emergency: EmergencyTransport;
}

const { emergency } = Astro.props;
---
<section class="transport" aria-labelledby="prevoz" data-emergency-block>
  <h2 id="prevoz" class="sec">{emergency.label}</h2>
  <table class="t">
    <tbody>
      <tr>
        <th scope="row" class="key">{ui.availabilityRow}</th>
        <td>{ui.availability247}</td>
      </tr>
      {
        emergency.serviceArea !== null ? (
          <tr>
            <th scope="row" class="key">{ui.areaRow}</th>
            <td>{emergency.serviceArea}</td>
          </tr>
        ) : null
      }
      {
        emergency.shortNote !== null ? (
          <tr>
            <th scope="row" class="key">{ui.aboutCol}</th>
            <td>{emergency.shortNote}</td>
          </tr>
        ) : null
      }
      <tr>
        <th scope="row" class="key">{ui.callRow}</th>
        <td>
          <EmergencyPhoneLink emergency={emergency} variant="number" numberClass="mono nowrap" />
        </td>
      </tr>
    </tbody>
  </table>
</section>

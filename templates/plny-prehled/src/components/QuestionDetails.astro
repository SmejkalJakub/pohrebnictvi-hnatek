---
/** Časté otázky: one ruled block per topic, each question a <details> with its answer. */
import type { CollectionEntry } from "astro:content";
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import { render, type FaqGroup } from "@core/content/load.ts";

interface Props {
  groups: FaqGroup<CollectionEntry<"faq">>[];
}

const { groups } = Astro.props;
const rendered = await Promise.all(
  groups.map(async (group) => ({
    group,
    entries: await Promise.all(group.entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))),
  })),
);
---
{
  rendered.map(({ group, entries }) => (
    <section class="faq-topic" aria-labelledby={`tema-${group.topic}`}>
      <h3 id={`tema-${group.topic}`} class="faq-topic-title">{group.label}</h3>
      {entries.map(({ entry, Content }) => (
        <details id={`otazka-${entry.id}`} class="fold-row">
          <summary>{entry.data.question}</summary>
          <PlaceholderMark active={entry.data.placeholder} as="div">
            <div class="ref-body faq-answer">
              <Content />
            </div>
          </PlaceholderMark>
        </details>
      ))}
    </section>
  ))
}

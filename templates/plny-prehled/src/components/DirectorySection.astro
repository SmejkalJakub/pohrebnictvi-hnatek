---
/**
 * One cell of the home directory, and one homepage section (data-section = its id, in config
 * order). Rendered as <details open>: on wide screens it is a ruled column with its heading;
 * on phones the layout script folds every row but the first, as drawn. The first section's
 * heading is the page's h1, the others are h2.
 */
interface Props {
  section: string;
  heading: string;
  level: 1 | 2;
  /** Full-width row (the FAQ row): spans all directory columns. */
  wide?: boolean;
}

const { section, heading, level, wide = false } = Astro.props;
const Heading = `h${level}` as "h1" | "h2";
const headingId = `sekce-${section}`;
---
<details class:list={["dir-cell", { "dir-wide": wide }]} data-section={section} data-fold open>
  <summary class="dir-summary">
    <Heading id={headingId} class="dir-heading">{heading}</Heading>{
      Astro.slots.has("hint") ? (
        <span class="dir-hint mono">
          <slot name="hint" />
        </span>
      ) : null
    }
  </summary>
  <div class="dir-body">
    <slot />
  </div>
</details>

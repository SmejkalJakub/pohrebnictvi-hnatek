---
/**
 * Notices as a timetable. Desktop: Datum · Čas · Jméno · Místo · Obřad · Přenos, an em dash for
 * every missing value. Phones: each notice is a name and a small Kdy / Kde / Obřad table.
 * Recent notices: Jméno · Zemřel(a) · Rozloučení. Nothing promotional (research L1).
 */
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import type { NoticeView } from "@core/content/view-models.ts";
import Sep from "./Sep.astro";
import { ui, weekdayShort } from "../i18n/cs.ts";

interface Props {
  notices: NoticeView[];
  kind: "upcoming" | "recent";
}

const { notices, kind } = Astro.props;

function dateText(view: NoticeView, withYear: boolean): string {
  const ceremony = view.ceremony;
  if (ceremony === null || ceremony.dateText === null) {
    return ui.none;
  }
  let date = ceremony.dateText;
  if (!withYear) {
    date = date.replace(/\s*\d{4}$/, "");
  }
  if (ceremony.weekday !== null) {
    return `${weekdayShort[ceremony.weekday] ?? ceremony.weekday} ${date}`;
  }
  return date;
}

function whenText(view: NoticeView): string {
  const date = dateText(view, false);
  const time = view.ceremony?.timeText ?? null;
  if (time === null) {
    return date;
  }
  return `${date}, ${time}`;
}

function timeText(view: NoticeView): string {
  return view.ceremony?.timeText ?? ui.none;
}

function placeText(view: NoticeView): string {
  return view.ceremony?.placeName ?? ui.none;
}

function typeText(view: NoticeView): string {
  return view.ceremony?.typeLabel ?? ui.none;
}

function streamText(view: NoticeView): string {
  if (view.livestreamUrl !== null) {
    return ui.yes;
  }
  return "ne";
}
---
{
  kind === "upcoming" ? (
    <>
      <div class="timetable-wide">
        <table class="t timetable">
          <thead>
            <tr>
              <th scope="col">{ui.dateCol}</th>
              <th scope="col">{ui.timeCol}</th>
              <th scope="col">{ui.nameColumn}</th>
              <th scope="col">{ui.placeCol}</th>
              <th scope="col">{ui.ceremonyCol}</th>
              <th scope="col">{ui.streamCol}</th>
            </tr>
          </thead>
          <tbody>
            {notices.map((view) => (
              <tr>
                <td class="mono nowrap">{dateText(view, true)}</td>
                <td class="mono">{timeText(view)}</td>
                <th scope="row">
                  <PlaceholderMark active={view.placeholder} as="span">
                    <a href={view.href} class="notice-name">{view.fullName}</a>
                  </PlaceholderMark>
                </th>
                <td>{placeText(view)}</td>
                <td>{typeText(view)}</td>
                <td>{streamText(view)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <ul class="timetable-narrow plain-list">
        {notices.map((view) => (
          <li class="mini-notice">
            <PlaceholderMark active={view.placeholder} as="div">
              <a href={view.href} class="notice-name mini-name">{view.fullName}</a>
              <table class="t mini">
                <tbody>
                  <tr>
                    <th scope="row" class="key">{ui.when}</th>
                    <td class="mono">
                      {whenText(view)}
                    </td>
                  </tr>
                  <tr>
                    <th scope="row" class="key">{ui.where}</th>
                    <td>{placeText(view)}</td>
                  </tr>
                  <tr>
                    <th scope="row" class="key">{ui.ceremonyCol}</th>
                    <td>
                      {typeText(view)}
                      {view.livestreamUrl !== null ? (
                        <>
                          <Sep />
                          {ui.withStream}
                        </>
                      ) : null}
                    </td>
                  </tr>
                </tbody>
              </table>
            </PlaceholderMark>
          </li>
        ))}
      </ul>
    </>
  ) : (
    <div>
      <table class="t recent t-stack">
        <thead>
          <tr>
            <th scope="col">{ui.nameColumn}</th>
            <th scope="col">{ui.diedCol}</th>
            <th scope="col">{ui.farewellCol}</th>
          </tr>
        </thead>
        <tbody>
          {notices.map((view) => (
            <tr>
              <th scope="row">
                <PlaceholderMark active={view.placeholder} as="span">
                  <a href={view.href} class="notice-name">{view.fullName}</a>
                </PlaceholderMark>
              </th>
              <td class="mono nowrap" data-label={ui.diedCol}>{view.diedText}</td>
              <td class="mono nowrap" data-label={ui.farewellCol}>{view.ceremony?.dateText ?? ui.none}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}

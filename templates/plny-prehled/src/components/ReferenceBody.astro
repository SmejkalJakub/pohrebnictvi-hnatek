---
/**
 * A page's Markdown body as a reference sheet: each ## opens a ruled block (22 px heading with a
 * 1 px ink rule), lists become ruled rows, no prose decoration. Renders nothing without a body.
 */
interface Props {
  show: boolean;
}

const { show } = Astro.props;
---
{
  show ? (
    <div class="ref-body">
      <slot />
    </div>
  ) : null
}

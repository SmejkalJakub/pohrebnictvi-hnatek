---
/**
 * Služby: an index table. Služba · Co zahrnuje · Cena (the linked group's first item, mono) ·
 * Detail. The VAT note follows the table whenever a price shows (research L9).
 */
import PriceValue from "@core/components/PriceValue.astro";
import type { CollectionEntry } from "astro:content";
import type { PriceItem } from "@core/content/schemas.ts";
import { serviceHref } from "@core/content/view-models.ts";
import { ui } from "../i18n/cs.ts";

export interface ServiceRow {
  entry: CollectionEntry<"services">;
  price: PriceItem | null;
}

interface Props {
  rows: ServiceRow[];
}

const { rows } = Astro.props;
---
  <table class="t services t-stack">
    <thead>
      <tr>
        <th scope="col">{ui.serviceColumn}</th>
        <th scope="col">{ui.includesColumn}</th>
        <th scope="col" class="num">{ui.priceColumn}</th>
        <th scope="col"><span class="visually-hidden">{ui.detail}</span></th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map(({ entry, price }) => (
          <tr id={entry.id}>
            <th scope="row" class="strong">{entry.data.title}</th>
            <td>{entry.data.summary}</td>
            <td class="num" data-label={ui.priceColumn}>{price !== null ? <PriceValue item={price} class="mono" /> : ui.none}</td>
            <td class="num">
              <a href={serviceHref(entry.id, true)} aria-label={ui.detailOf(entry.data.title)}>
                {ui.detail}
              </a>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>

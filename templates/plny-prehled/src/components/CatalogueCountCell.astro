---
/**
 * Rakve and Květiny with their counts in mono and up to four small thumbnails each
 * (64 × 48 coffins, 48 × 48 flowers). Thumbnails repeat the linked item names, so they are
 * decorative (alt ""). Placeholder images are not shown here.
 */
import { Image } from "astro:assets";
import type { ImageRef } from "@core/content/schemas.ts";
import { resolveOptionalImage, type ResolvedImage } from "@core/media/resolve.ts";

export interface CatalogueLine {
  key: string;
  label: string;
  href: string;
  count: number;
  images: ImageRef[];
  thumb: { width: number; height: number };
}

interface Props {
  lines: CatalogueLine[];
}

const { lines } = Astro.props;
const resolved = lines.map((line) => ({
  line,
  thumbs: line.images
    .map((ref) => resolveOptionalImage(ref))
    .filter((image): image is ResolvedImage => image !== null && !image.isPlaceholder)
    .slice(0, 4),
}));
---
{
  resolved.map(({ line, thumbs }) => (
    <div class="count-line">
      <p class="cell-label">
        <a href={line.href}>{line.label}</a>{" "}<span class="mono muted count">{line.count}</span>
      </p>
      {thumbs.length > 0 ? (
        <div class="thumb-row">
          {thumbs.map((image) => (
            <Image
              src={image.src}
              alt=""
              width={line.thumb.width}
              height={line.thumb.height}
              densities={[1, 2]}
              class="thumb"
              style={`object-position: ${image.objectPosition}`}
            />
          ))}
        </div>
      ) : null}
    </div>
  ))
}

---
/**
 * O nás: the opening, the stamp line, the body as grid passages with one landscape band after
 * the middle passage. No photo of people (guardrail); the building belongs to Kontakt.
 */
import { getLandscapes, getPage, getSiteContext } from "@core/content/load.ts";
import QuietLayout from "../layouts/QuietLayout.astro";
import OpeningText from "../components/OpeningText.astro";
import StampLine from "../components/StampLine.astro";
import ProsePassages from "../components/ProsePassages.astro";
import { resolveOptions } from "../lib/options.ts";
import { photosForBands } from "../lib/bands.ts";
import { seoDescription, seoTitle } from "../lib/site.ts";

const site = await getSiteContext();
const options = resolveOptions(site.config);
const page = await getPage("o-nas");
const landscapes = await getLandscapes();
const [band] = photosForBands(landscapes, "o-nas", 1);
const Body = page.Content;
---
<QuietLayout site={site} title={seoTitle(page.data)} description={seoDescription(page.data)}>
  <OpeningText title={page.data.title} lead={page.data.lead} placeholder={page.data.placeholder} />
  <StampLine emergency={site.emergency} place="opening" high={options.emergencyEmphasis === "high"} />
  {
    page.hasBody ? (
      <ProsePassages idPrefix="o-nas-text" withBand band={band ?? null}>
        <Body />
      </ProsePassages>
    ) : null
  }
</QuietLayout>

---
/** 404: one sentence with two inline links (home, the guide), then the stamp line. */
import { getSiteContext } from "@core/content/load.ts";
import QuietLayout from "../layouts/QuietLayout.astro";
import OpeningText from "../components/OpeningText.astro";
import StampLine from "../components/StampLine.astro";
import { resolveOptions } from "../lib/options.ts";
import { ui } from "../i18n/cs.ts";

const site = await getSiteContext();
const options = resolveOptions(site.config);
---
<QuietLayout site={site} title={ui.notFoundTitle} description={ui.notFoundTitle} noindex>
  <OpeningText title={ui.notFoundTitle} kicker={ui.notFoundKicker}>
    <p>
      {ui.notFoundBefore} <a href="/">{ui.notFoundHome}</a> {ui.notFoundOr}{" "}
      <a href="/jak-postupovat/">{ui.notFoundGuide}</a>.
    </p>
  </OpeningText>
  <StampLine emergency={site.emergency} place="opening" high={options.emergencyEmphasis === "high"} />
</QuietLayout>

---
/**
 * Lidé. With photos: one person per row, the 3:4 portrait in columns 1–2, the name in light 36 px
 * serif in columns 4–11, the role and an optional direct line. Without any photo: names two per
 * row in the text column, no initials, no empty frames. A person without a photo among others
 * with photos gets no frame either.
 */
import { Image } from "astro:assets";
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import type { PersonView } from "@core/content/view-models.ts";
import { resolveOptionalImage } from "@core/media/resolve.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  people: PersonView[];
}

const { people } = Astro.props;
const rows = people.map((person) => ({ person, photo: resolveOptionalImage(person.photo) }));
const withPhotos = rows.some((row) => row.photo !== null);
---
<ul class="people" role="list" data-layout={withPhotos ? "rows" : "names"} data-people>
  {
    rows.map(({ person, photo }) => (
      <li class="person" data-person={person.id}>
        {photo !== null ? (
          <PlaceholderMark active={photo.isPlaceholder} kind="image" as="div" class="person-photo-wrap">
            <Image
              src={photo.src}
              alt={photo.alt}
              width={172}
              height={229}
              densities={[1, 2]}
              class="person-photo"
              style={`object-position: ${photo.objectPosition}`}
            />
          </PlaceholderMark>
        ) : null}
        <PlaceholderMark active={person.placeholder} as="div" class="person-text">
          <p class="person-name">{person.name}</p>
          <p class="label">{person.role}</p>
          {person.phone !== null ? (
            <p>
              <a href={person.phone.href} data-phone-link>
                {ui.directLine}{" "}<span class="nowrap">{person.phone.display}</span>
              </a>
            </p>
          ) : null}
        </PlaceholderMark>
      </li>
    ))
  }
</ul>

<style>
  .people {
    display: grid;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .people[data-layout="rows"] .person {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    column-gap: 1.25rem;
    align-items: center;
  }

  .people :global(.person-photo) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    background: var(--photo);
  }

  .people[data-layout="rows"] .person > :global(.person-text:only-child) {
    grid-column: 2;
  }

  .person-name {
    font-size: 1.75rem;
    line-height: 1.2;
  }

  @media (min-width: 48rem) {
    .people[data-layout="names"] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.5rem;
    }

    .people[data-layout="rows"] .person {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 1.5rem;
    }

    .people[data-layout="rows"] .person > :global(.person-photo-wrap) {
      grid-column: 1 / span 2;
    }

    .people[data-layout="rows"] .person > :global(.person-text),
    .people[data-layout="rows"] .person > :global(.person-text:only-child) {
      grid-column: 4 / span 7;
    }

    .person-name {
      font-size: 2.25rem;
    }
  }
</style>

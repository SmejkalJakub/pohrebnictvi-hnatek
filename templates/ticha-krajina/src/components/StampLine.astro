---
/**
 * The stamp line: the nonstop number as one long ruled line, the template's emergency pattern.
 * One tel: link between two 1 px ink rules: Figtree label · Spectral 600 number in the accent
 * colour, underlined (42 / 33 px), never wrapping · "ve dne, v noci i o svátcích".
 * Desktop: one baseline (grid cells, not flex text runs); phones: three lines.
 * `place`: "opening" after a page's opening (left out under high emphasis, which draws it at
 * "top" instead), "top" directly under the header, "footer", "menu" under the mobile menu list.
 * Label, number and note are separate inline-block spans with real spaces between them, so they
 * never glue together (QA test 9). The accessible name comes from core.
 */
import EmergencyPhoneLink from "@core/components/EmergencyPhoneLink.astro";
import type { EmergencyTransport } from "@core/content/schemas.ts";
import { formatPhone } from "@core/format/phone.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  emergency: EmergencyTransport;
  place: "opening" | "top" | "footer" | "menu";
  /** Under high emphasis the opening line is drawn at the top instead. */
  high?: boolean;
}

const { emergency, place, high = false } = Astro.props;
const phone = formatPhone(emergency.phone);
let show = emergency.enabled;
if (place === "opening" && high) {
  show = false;
}
const withNote = place !== "menu";
---
{
  show ? (
    <div class="stamp" data-interlude="stamp" data-place={place}>
      <EmergencyPhoneLink emergency={emergency} variant="custom" class="stamp-link">
        <span class="stamp-label">{emergency.label}</span>{" "}
        <span class="stamp-number" data-part="number">{phone.display}</span>
        {withNote ? (
          <>
            {" "}
            <span class="stamp-note">{ui.stampNote}</span>
          </>
        ) : null}
      </EmergencyPhoneLink>
    </div>
  ) : null
}

<style>
  .stamp {
    margin: 1.625rem var(--gutter) 0;
  }

  .stamp[data-place="footer"],
  .stamp[data-place="menu"] {
    margin-inline: 0;
  }

  .stamp :global(.stamp-link) {
    display: block;
    padding: 0.875rem 0 1rem;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    color: var(--ink);
    text-decoration: none;
  }

  .stamp-label,
  .stamp-note {
    display: block;
    font-family: var(--sans);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .stamp-note {
    color: var(--muted);
  }

  .stamp-number {
    display: inline-block;
    color: var(--accent);
    font-size: min(var(--num), 10vw);
    font-weight: 600;
    line-height: 1.25;
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .stamp :global(.stamp-link:hover) .stamp-number {
    text-decoration-thickness: 3px;
  }

  @media (min-width: 64rem) {
    .stamp {
      margin-top: 4rem;
    }

    .stamp[data-place="top"] {
      margin-top: 1rem;
    }

    .stamp :global(.stamp-link) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      column-gap: 1.5rem;
      align-items: baseline;
      padding: 1.125rem 0;
    }

    .stamp-label {
      font-size: 1.1875rem;
    }

    .stamp-number {
      line-height: 1.2;
      text-underline-offset: 0.19em;
    }

    .stamp-note {
      justify-self: end;
      text-align: right;
    }

    .stamp[data-place="menu"] {
      display: none;
    }
  }
</style>

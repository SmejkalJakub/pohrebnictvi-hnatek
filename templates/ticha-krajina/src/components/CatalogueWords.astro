---
/** Home `catalogue-links`: "Rakve a květiny" as plain words linking to the two catalogue pages. */
import type { NavItem } from "@core/content/view-models.ts";
import GridPassage from "./GridPassage.astro";
import { ui } from "../i18n/cs.ts";

interface Props {
  links: NavItem[];
}

const { links } = Astro.props;
---
{
  links.length > 0 ? (
    <GridPassage id="katalog-domu" heading={ui.catalogueHeading} data-section="catalogue-links">
      <ul class="words" role="list">
        {links.map((link) => (
          <li>
            <a href={link.href} class="go">{link.label}</a>
          </li>
        ))}
      </ul>
    </GridPassage>
  ) : null
}

<style>
  .words {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1.5rem;
  }
</style>

---
/**
 * The opening of a page, text only (never a photo in the first viewport): the light H1 in
 * columns 1–7 and the lead (or the "side" slot) in columns 9–12, bottom-aligned. One column on
 * phones. On home it is the `hero` section.
 */
import PlaceholderMark from "@core/components/PlaceholderMark.astro";

interface Props {
  title: string;
  lead?: string | null;
  placeholder?: boolean;
  /** Small muted line above the H1 (e.g. "Chyba 404"). */
  kicker?: string | null;
  /** Home only: marks the hero for the homepage order (data-section="hero"). */
  hero?: boolean;
  leadClass?: string;
}

const { title, lead = null, placeholder = false, kicker = null, hero = false, leadClass = "lead" } = Astro.props;
const hasSide = lead !== null || Astro.slots.has("default");
---
<section class="opening" data-section={hero ? "hero" : undefined} data-hero={hero ? "" : undefined}>
  <div class="opening-main">
    {kicker !== null ? <p class="label">{kicker}</p> : null}
    <PlaceholderMark active={placeholder} as="div">
      <h1 class="opening-title">{title}</h1>
    </PlaceholderMark>
  </div>
  {
    hasSide ? (
      <div class="opening-side">
        {lead !== null ? <p class={leadClass}>{lead}</p> : null}
        <slot />
      </div>
    ) : null
  }
</section>

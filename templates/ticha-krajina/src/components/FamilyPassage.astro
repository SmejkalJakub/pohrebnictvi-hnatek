---
/** Home `family-story`: the O nás excerpt (or lead), the tradition wording, a link to O nás. */
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import GridPassage from "./GridPassage.astro";
import { ui } from "../i18n/cs.ts";

interface Props {
  title: string;
  text: string | null;
  tradition: string | null;
  placeholder: boolean;
}

const { title, text, tradition, placeholder } = Astro.props;
---
<GridPassage id="o-nas-domu" heading={title} data-section="family-story">
  <PlaceholderMark active={placeholder} as="div">
    {tradition !== null ? <p class="label">{tradition}</p> : null}
    {text !== null ? <p>{text}</p> : null}
  </PlaceholderMark>
  <p><a href="/o-nas/" class="go">{ui.storyLink}</a></p>
</GridPassage>

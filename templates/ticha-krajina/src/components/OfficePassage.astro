---
/**
 * Home `contact-summary`: "Kancelář" with the address, map link and office phone, and the office
 * hours under their own heading. The nonstop number is never part of this passage.
 */
import PhoneLink from "@core/components/PhoneLink.astro";
import type { SiteContext } from "@core/content/view-models.ts";
import { formatAddressLines } from "@core/format/address.ts";
import { formatPhone } from "@core/format/phone.ts";
import GridPassage from "./GridPassage.astro";
import OfficeHoursHairlines from "./OfficeHoursHairlines.astro";
import { mainLocation, mapHref, primaryOfficePhone } from "../lib/site.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  site: SiteContext;
}

const { site } = Astro.props;
const location = mainLocation(site);
const [street, cityLine] = formatAddressLines(location.address);
const map = mapHref(location);
const office = primaryOfficePhone(site);
---
<GridPassage id="kancelar" heading={ui.officeHeading} data-section="contact-summary">
  <p>{street}<br />{cityLine}</p>
  {map !== null ? <p class="sans"><a href={map} class="go">{ui.mapLink}</a></p> : null}
  <p>
    <PhoneLink number={office.number}>{office.label}{" "}<span class="nowrap">{formatPhone(office.number).display}</span></PhoneLink>
  </p>
  <OfficeHoursHairlines site={site} id="kancelar-hodiny" />
  <p class="sans"><a href="/kontakt/" class="go">{ui.officeLink}</a></p>
</GridPassage>

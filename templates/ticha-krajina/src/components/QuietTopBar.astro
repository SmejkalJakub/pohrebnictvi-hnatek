---
/**
 * The plain top bar (not sticky): wordmark or logo on the left; on ≥ 64 rem the text navigation in
 * Figtree 18 px on the right (wrapping to a second line when long); below that a "Menu" button
 * (never a hamburger) that opens the list in the flow as large light serif words, closed by a
 * stamp line. Without JS the list is shown in the flow and the button is hidden.
 */
import { Image } from "astro:assets";
import type { SiteContext } from "@core/content/view-models.ts";
import { resolveOptionalImage } from "@core/media/resolve.ts";
import QuietNav from "./QuietNav.astro";
import type { QuietLink } from "../lib/site.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  site: SiteContext;
  links: QuietLink[];
  neutral: boolean;
}

const { site, links, neutral } = Astro.props;
const logo = resolveOptionalImage(site.company.logo);
---
<header class="top" data-neutral={neutral ? "true" : "false"}>
  <div class="top-row">
    <a href="/" class="wordmark">
      {
        logo !== null ? (
          <Image src={logo.src} alt={site.company.brandName} height={48} densities={[1, 2]} class="logo" loading="eager" />
        ) : (
          site.company.brandName
        )
      }
    </a>
    <button type="button" class="menu-btn" aria-expanded="false" aria-controls="menu" data-menu-toggle>
      {ui.menuOpen}
    </button>
  </div>
  <QuietNav id="menu" links={links} emergency={site.emergency} neutral={neutral} />
</header>

<style>
  .top {
    padding: 0.75rem var(--gutter) 0;
  }

  .top-row {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    min-height: 2.75rem;
  }

  .wordmark {
    display: inline-block;
    padding-block: 0.5rem;
    color: var(--ink);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
  }

  .top :global(.logo) {
    width: auto;
    height: 2.5rem;
  }

  .menu-btn {
    flex: none;
    min-height: 2.75rem;
    padding: 0 0.875rem;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    font: 500 1.125rem/1 var(--sans);
    cursor: pointer;
  }

  :global(.no-js) .menu-btn {
    display: none;
  }

  @media (min-width: 64rem) {
    .top {
      display: grid;
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
      column-gap: 1.5rem;
      align-items: start;
      padding-top: 1.75rem;
    }

    .wordmark {
      font-size: 1.5rem;
    }

    .top :global(.logo) {
      height: 3rem;
    }

    .menu-btn {
      display: none;
    }
  }
</style>

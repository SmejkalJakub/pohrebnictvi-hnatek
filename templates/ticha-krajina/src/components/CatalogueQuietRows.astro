---
/**
 * Rakve and Květiny, built from the Lidé page: one item per row (the 4:3 or 1:1 image in columns
 * 1–2, the name in light 36 px serif in 4–11, then code, material or type and the summary).
 * Without any image, the names sit two per row; an item without an image gets no empty frame.
 * Zero items: one sentence and the office phone.
 */
import { Image } from "astro:assets";
import PhoneLink from "@core/components/PhoneLink.astro";
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import type { ImageRef } from "@core/content/schemas.ts";
import type { SiteContext } from "@core/content/view-models.ts";
import { formatPhone } from "@core/format/phone.ts";
import { resolveOptionalImage } from "@core/media/resolve.ts";
import { primaryOfficePhone } from "../lib/site.ts";
import { ui } from "../i18n/cs.ts";

export interface QuietItem {
  id: string;
  name: string;
  detail: string | null;
  summary: string | null;
  image: ImageRef | null;
  placeholder: boolean;
}

interface Props {
  site: SiteContext;
  items: QuietItem[];
  aspect: "4:3" | "1:1";
}

const { site, items, aspect } = Astro.props;
const rows = items.map((item) => ({ item, photo: resolveOptionalImage(item.image) }));
const withImages = rows.some((row) => row.photo !== null);
const width = 172;
let height = 129;
if (aspect === "1:1") {
  height = 172;
}
const office = primaryOfficePhone(site);
---
{
  rows.length === 0 ? (
    <div class="passage">
      <div class="passage-body">
        <p>{ui.catalogueEmpty}</p>
        <p>
          <PhoneLink number={office.number}>{office.label}{" "}<span class="nowrap">{formatPhone(office.number).display}</span></PhoneLink>
        </p>
      </div>
    </div>
  ) : (
    <div class="passage">
      <ul class="items passage-full" role="list" data-layout={withImages ? "rows" : "names"}>
        {rows.map(({ item, photo }) => (
          <li id={item.id} class="item">
            {photo !== null ? (
              <PlaceholderMark active={photo.isPlaceholder} kind="image" as="div" class="item-image-wrap">
                <Image
                  src={photo.src}
                  alt={photo.alt}
                  width={width}
                  height={height}
                  densities={[1, 2]}
                  class="item-image"
                  style={`object-position: ${photo.objectPosition}`}
                />
              </PlaceholderMark>
            ) : null}
            <PlaceholderMark active={item.placeholder} as="div" class="item-text">
              <h2 class="item-name">{item.name}</h2>
              {item.detail !== null ? <p class="label">{item.detail}</p> : null}
              {item.summary !== null ? <p class="item-summary">{item.summary}</p> : null}
            </PlaceholderMark>
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .items {
    display: grid;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .items[data-layout="rows"] .item {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    column-gap: 1.25rem;
    align-items: start;
  }

  .items[data-layout="rows"] .item > :global(.item-text:only-child) {
    grid-column: 2;
  }

  .items :global(.item-image) {
    width: 100%;
    height: auto;
    object-fit: cover;
    background: var(--photo);
  }

  .item-name {
    font-size: 1.75rem;
    line-height: 1.2;
  }

  .item-summary {
    margin-top: 0.375rem;
  }

  @media (min-width: 48rem) {
    .items[data-layout="names"] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.5rem;
    }

    .items[data-layout="rows"] .item {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 1.5rem;
    }

    .items[data-layout="rows"] .item > :global(.item-image-wrap) {
      grid-column: 1 / span 2;
    }

    .items[data-layout="rows"] .item > :global(.item-text),
    .items[data-layout="rows"] .item > :global(.item-text:only-child) {
      grid-column: 4 / span 8;
    }

    .item-name {
      font-size: 2.25rem;
    }
  }
</style>

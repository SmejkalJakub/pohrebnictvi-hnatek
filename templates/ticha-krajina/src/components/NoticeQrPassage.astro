---
/** The notice's build-time QR code (core) with the print instruction and the printable file. */
import NoticeQrCode from "@core/components/NoticeQrCode.astro";
import type { NoticeView } from "@core/content/view-models.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  view: NoticeView;
}

const { view } = Astro.props;
---
<section class="qr" aria-labelledby="qr-nadpis">
  <h2 id="qr-nadpis" class="visually-hidden">{ui.qrHeading}</h2>
  <NoticeQrCode notice={view} class="qr-code" />
  <div>
    <p class="label no-print">{ui.qrText}</p>
    <p class="sans no-print"><a href={view.qr.href} class="go">{ui.qrFile}</a></p>
  </div>
</section>

<style>
  .qr {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    column-gap: 1rem;
    align-items: start;
    margin-top: 2.5rem;
  }

  .qr :global(.qr-code) {
    display: block;
    width: 6.5rem;
    padding: 0.25rem;
    border: 1px solid var(--ink);
    background: #fff;
  }
</style>

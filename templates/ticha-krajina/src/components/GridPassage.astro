---
/**
 * One passage on the 12-column grid: heading in columns 1–4 (with an optional small Figtree label
 * above it and the "head" slot under it), the text in columns 6–11. One column below 48 rem.
 * Passages are separated by space only: no rules, boxes or tinted backgrounds.
 */
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  id: string;
  heading: string;
  level?: 2 | 3;
  /** Small Figtree label above the heading (price group name, phase). */
  label?: string | null;
  headingClass?: string;
}

const { id, heading, level = 2, label = null, headingClass, class: className, ...rest } = Astro.props;
const Heading = `h${level}` as "h2" | "h3";
const headingId = `${id}-nadpis`;
---
<section id={id} class:list={["passage", className]} aria-labelledby={headingId} {...rest}>
  <div class="passage-head">
    {label !== null ? <p class="label">{label}</p> : null}
    <Heading id={headingId} class:list={["passage-heading", headingClass]}>{heading}</Heading>
    <slot name="head" />
  </div>
  <div class="passage-body">
    <slot />
  </div>
</section>

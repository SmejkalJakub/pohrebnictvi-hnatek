---
/**
 * Home `next-steps`: "Když někdo zemřel", the guide's lead, the place picker as a running
 * sentence (or the first-hours steps when the guide names no situations), and the full guide link.
 */
import type { CollectionEntry } from "astro:content";
import type { SpecificSituation } from "@core/content/guidance-flow.ts";
import GridPassage from "./GridPassage.astro";
import PickerSentence from "./PickerSentence.astro";
import { ui } from "../i18n/cs.ts";

interface Props {
  lead: string | null;
  situations: SpecificSituation[];
  firstHours: CollectionEntry<"guidance">[];
}

const { lead, situations, firstHours } = Astro.props;
---
<GridPassage id="kdyz-nekdo-zemrel" heading={ui.firstHoursHeading} data-section="next-steps">
  {lead !== null ? <p>{lead}</p> : null}
  {
    situations.length > 0 ? (
      <PickerSentence situations={situations} base="/jak-postupovat/" questionId="domu-kde" inline />
    ) : (
      <ul class="dot-list">
        {firstHours.map((entry) => (
          <li>
            <a href={`/jak-postupovat/#${entry.id}`} class="go">{entry.data.title}</a>
          </li>
        ))}
      </ul>
    )
  }
  <p class="sans"><a href="/jak-postupovat/" class="go">{ui.fullGuide}</a></p>
</GridPassage>

---
/**
 * The guide as a narrative timeline: the place picker as a sentence of words, a one-line tally
 * per situation ("5 kroků pro úmrtí doma. Zobrazit vše"), then one grid passage per phase (the
 * phase as a small Figtree label in columns 1–4, the steps in 6–11). Picking a word filters the
 * steps with core's :has(:target) mechanism (no JavaScript); phases with nothing left hide too.
 */
import type { CollectionEntry } from "astro:content";
import {
  SITUATION_ANCHOR,
  SPECIFIC_SITUATIONS,
  chooserSituations,
  showsFor,
  type SpecificSituation,
} from "@core/content/guidance-flow.ts";
import { GUIDANCE_PHASES } from "@core/content/schemas.ts";
import type { SiteContext } from "@core/content/view-models.ts";
import PickerSentence from "./PickerSentence.astro";
import StepPassage from "./StepPassage.astro";
import { guidancePhaseLabels, situationWords, ui } from "../i18n/cs.ts";

interface Props {
  site: SiteContext;
  guidance: CollectionEntry<"guidance">[];
}

const { site, guidance } = Astro.props;
const ALL_ANCHOR = "postup";
const situations = chooserSituations(guidance);

const phases = GUIDANCE_PHASES.map((phase) => {
  const steps = guidance.filter((entry) => entry.data.phase === phase);
  const shownFor = SPECIFIC_SITUATIONS.filter((situation) => steps.some((entry) => showsFor(entry, situation)));
  return { phase, steps, shownFor };
}).filter((group) => group.steps.length > 0);

const counts: Partial<Record<SpecificSituation, number>> = {};
for (const situation of situations) {
  counts[situation] = guidance.filter((entry) => showsFor(entry, situation)).length;
}

/* Filter rules, one block per offered situation (the selectors depend on the anchors). */
const filterCss = situations
  .map((situation) => {
    const target = `[data-guide]:has(#${SITUATION_ANCHOR[situation]}:target)`;
    return [
      `${target} [data-guide-step]:not([data-situations~="any"]):not([data-situations~="${situation}"]) { display: none; }`,
      `${target} [data-guide-phase]:not([data-shown-for~="${situation}"]) { display: none; }`,
      `${target} [data-tally="${situation}"] { display: block; }`,
      `${target} [data-place="${situation}"] { text-decoration: none; border-bottom: 3px solid var(--accent); padding-bottom: calc(0.625rem - 3px); }`,
      `${target} [data-place="${situation}"] .pick-mark { display: inline; }`,
    ].join("\n");
  })
  .join("\n");
---
<div data-guide class="guide">
  <style is:inline set:html={filterCss}></style>
  {situations.map((situation) => <span id={SITUATION_ANCHOR[situation]} class="guide-target"></span>)}
  <span id={ALL_ANCHOR} class="guide-target"></span>
  {
    situations.length > 0 ? (
      <div class="passage guide-pick">
        <div class="passage-full">
          <PickerSentence situations={situations} base="" questionId="kde-zemrel" />
          {situations.map((situation) => (
            <p class="tally sans" data-tally={situation}>
              {ui.tally(counts[situation] ?? 0, situationWords[situation])}{" "}
              <a href={`#${ALL_ANCHOR}`} class="go">{ui.showAll}</a>
            </p>
          ))}
        </div>
      </div>
    ) : null
  }
  {
    phases.map((group) => (
      <section
        class="passage guide-phase"
        aria-labelledby={`faze-${group.phase}`}
        data-guide-phase
        data-shown-for={group.shownFor.join(" ")}
      >
        <div class="passage-head">
          <h2 id={`faze-${group.phase}`} class="label phase-label">{guidancePhaseLabels[group.phase]}</h2>
        </div>
        <ol class="passage-body steps">
          {group.steps.map((entry) => (
            <StepPassage site={site} entry={entry} />
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .guide-target {
    display: block;
    scroll-margin-top: 1rem;
  }

  .guide-pick {
    padding-top: 1.5rem;
  }

  .tally {
    display: none;
  }

  .guide-phase {
    padding-top: 2.5rem;
  }

  .phase-label {
    font-weight: 500;
  }

  .steps {
    margin: 0.5rem 0 0;
    padding: 0;
  }

  @media (min-width: 48rem) {
    .steps {
      margin-top: 0;
    }
  }

  @media (min-width: 64rem) {
    .guide-pick {
      padding-top: 3rem;
    }

    .guide-phase {
      padding-top: 4.5rem;
    }
  }
</style>

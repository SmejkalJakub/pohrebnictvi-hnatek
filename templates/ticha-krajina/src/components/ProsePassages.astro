---
/**
 * A page's Markdown body as grid passages: each `##` heading opens a passage (heading in columns
 * 1–4, its text in 6–11); text before the first heading becomes an untitled passage. Optionally
 * one landscape band after the middle passage (long text pages, at least three passages).
 * The body is rendered by core (restricted Markdown); this component only splits the HTML.
 */
import type { LandscapeImage } from "@core/content/schemas.ts";
import LandscapeBand from "./LandscapeBand.astro";
import { bandAfterMiddle, bandCaption } from "../lib/bands.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  /** One photo for the middle band, or null for 96 px of space; omit for no band at all. */
  band?: LandscapeImage | null | undefined;
  withBand?: boolean;
  idPrefix: string;
}

const { band = null, withBand = false, idPrefix } = Astro.props;
const html = (await Astro.slots.render("default")).trim();

interface Part {
  id: string;
  headingHtml: string | null;
  bodyHtml: string;
}

const parts: Part[] = [];
const chunks = html.split(/(?=<h2[\s>])/);
chunks.forEach((chunk, index) => {
  const trimmed = chunk.trim();
  if (trimmed === "") {
    return;
  }
  const match = /^<h2([^>]*)>([\s\S]*?)<\/h2>/.exec(trimmed);
  if (match === null) {
    parts.push({ id: `${idPrefix}-${index}`, headingHtml: null, bodyHtml: trimmed });
    return;
  }
  const attributes = match[1] ?? "";
  const idMatch = /\sid="([^"]+)"/.exec(attributes);
  let id = `${idPrefix}-${index}`;
  if (idMatch !== null && idMatch[1] !== undefined) {
    id = idMatch[1];
  }
  parts.push({ id, headingHtml: match[2] ?? "", bodyHtml: trimmed.slice(match[0].length).trim() });
});

let caption: string | null = null;
if (band !== null) {
  caption = bandCaption(band, ui.photoBy);
}
---
{
  parts.map((part, index) => (
    <>
      {part.headingHtml !== null ? (
        <section id={part.id} class="passage" aria-labelledby={`${part.id}-nadpis`}>
          <div class="passage-head">
            <h2 id={`${part.id}-nadpis`} class="passage-heading" set:html={part.headingHtml} />
          </div>
          <div class="passage-body prose" set:html={part.bodyHtml} />
        </section>
      ) : (
        <div class="passage">
          <div class="passage-body prose" set:html={part.bodyHtml} />
        </div>
      )}
      {withBand && bandAfterMiddle(index, parts.length) ? (
        <LandscapeBand image={band === null ? null : band.image} caption={caption} />
      ) : null}
    </>
  ))
}

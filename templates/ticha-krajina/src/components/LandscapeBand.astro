---
/**
 * A full-bleed landscape band between passages (site/landscapes.json, or the Kontakt building):
 * 1280 × 440 on desktop (32:11), 375 × 240 on phones (25:16), cropped around the image's focus,
 * with a Figtree caption line under it (place · caption · credit). Never in the first viewport
 * (pages place bands only after a full passage), lazy-loaded, so the largest paint stays text.
 * Without a photo the band is 96 px of space and the page still reads as complete.
 * No text on the photo, ever.
 */
import { Picture } from "astro:assets";
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import type { ImageRef } from "@core/content/schemas.ts";
import { resolveImage } from "@core/media/resolve.ts";

interface Props {
  image: ImageRef | null;
  caption?: string | null;
}

const { image, caption = null } = Astro.props;
const photo = image === null ? null : resolveImage(image);
---
{
  photo !== null ? (
    <figure class="band" data-interlude="band" data-band>
      <PlaceholderMark active={photo.isPlaceholder} kind="image" as="div" class="band-frame">
        <Picture
          src={photo.src}
          alt={photo.alt}
          formats={["avif", "webp"]}
          fallbackFormat="jpg"
          widths={[480, 750, 1280, 1920, 2560]}
          sizes="100vw"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          class="band-img"
          style={`object-position: ${photo.objectPosition}`}
        />
      </PlaceholderMark>
      {caption !== null ? <figcaption class="band-caption">{caption}</figcaption> : null}
    </figure>
  ) : (
    <div class="band band-space" data-interlude="band" aria-hidden="true"></div>
  )
}

<style>
  .band {
    margin-top: 3.5rem;
  }

  .band-space {
    height: 6rem;
    margin-top: 0;
  }

  .band :global(.band-frame) {
    position: relative;
  }

  .band :global([data-placeholder-label]) {
    margin: 0 var(--gutter) 0.5rem;
  }

  .band :global(.band-img) {
    width: 100%;
    height: auto;
    aspect-ratio: 25 / 16;
    object-fit: cover;
    background: var(--photo);
  }

  .band-caption {
    padding: 0.625rem var(--gutter) 0;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.5;
  }

  @media (min-width: 48rem) {
    .band :global(.band-img) {
      aspect-ratio: 32 / 11;
    }
  }

  @media (min-width: 64rem) {
    .band {
      margin-top: var(--s4);
    }

    .band-space {
      margin-top: 0;
    }
  }
</style>

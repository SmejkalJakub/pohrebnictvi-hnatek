---
/**
 * Footer, every page. Opens with the second stamp line (its own emergency block with a heading
 * for assistive technology), then three columns: Kancelář (address, office hours under their own
 * heading, office phone) · Dokumenty (when documents are on) · Právní informace; then the legal
 * row (research L8, L10): legal name, sídlo, IČO, register entry and the ADR body.
 * Neutral form (notice pages): no stamp line and no Dokumenty column; Kancelář, Právní informace
 * and the legal row stay.
 */
import MissingFact from "@core/components/MissingFact.astro";
import PhoneLink from "@core/components/PhoneLink.astro";
import type { DocumentView, SiteContext } from "@core/content/view-models.ts";
import { formatAddressInline, formatAddressLines } from "@core/format/address.ts";
import { formatPhone } from "@core/format/phone.ts";
import StampLine from "./StampLine.astro";
import { mainLocation, mapHref, primaryOfficePhone } from "../lib/site.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  site: SiteContext;
  neutral: boolean;
  documents: DocumentView[];
  hasPrivacyPage: boolean;
}

const { site, neutral, documents, hasPrivacyPage } = Astro.props;
const location = mainLocation(site);
const [street, cityLine] = formatAddressLines(location.address);
const map = mapHref(location);
const office = primaryOfficePhone(site);
const officeDisplay = formatPhone(office.number).display;
const ids = site.company.legalIds;
const showStamp = !neutral && site.emergency.enabled;
const showDocuments = !neutral && documents.length > 0;
const showLegal = site.legalLink !== null || hasPrivacyPage;
---
<footer class="foot" data-neutral={neutral ? "true" : "false"}>
  {
    showStamp ? (
      <section class="foot-stamp" aria-labelledby="pata-nonstop" data-emergency-block>
        <h2 id="pata-nonstop" class="visually-hidden">{site.emergency.label}</h2>
        <StampLine emergency={site.emergency} place="footer" />
      </section>
    ) : null
  }
  <div class="foot-cols">
    <section class="foot-col" aria-labelledby="pata-kancelar">
      <h2 id="pata-kancelar" class="foot-heading">{ui.officeHeading}</h2>
      <p>{street}<br />{cityLine}</p>
      {map !== null ? <p><a href={map} class="go sans">{ui.mapLink}</a></p> : null}
      <div class="foot-hours" data-office-hours>
        <h3 class="visually-hidden">{ui.hoursHeading}</h3>
        <ul class="foot-hour-list muted">
          {
            site.officeHoursRows.map((row) => (
              <li>
                <abbr title={row.daysLong}>{row.days}</abbr> <span class="nowrap">{row.text}</span>
                {row.note !== null ? <span class="foot-note">, {row.note}</span> : null}
              </li>
            ))
          }
        </ul>
      </div>
      <p>
        <PhoneLink number={office.number}>{office.label}{" "}<span class="nowrap">{officeDisplay}</span></PhoneLink>
      </p>
    </section>
    {
      showDocuments ? (
        <section class="foot-col" aria-labelledby="pata-dokumenty">
          <h2 id="pata-dokumenty" class="foot-heading">{ui.documentsHeading}</h2>
          <ul class="foot-links sans">
            {documents.map((document) => (
              <li>
                <a href={document.href} class="go">{document.title}</a> ({ui.pdf})
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }
    {
      showLegal ? (
        <section class="foot-col" aria-labelledby="pata-pravni">
          <h2 id="pata-pravni" class="foot-heading">{ui.legalHeading}</h2>
          <ul class="foot-links sans">
            {site.legalLink !== null ? (
              <li>
                <a href={site.legalLink.href} class="go">{site.legalLink.label}</a>
              </li>
            ) : null}
            {hasPrivacyPage ? (
              <li>
                <a href="/ochrana-osobnich-udaju/" class="go">{ui.privacy}</a>
              </li>
            ) : null}
          </ul>
        </section>
      ) : null
    }
  </div>
  <p class="foot-legal sans muted" data-legal-identification>
    {site.company.legalName}
    {", "}
    {
      ids.registeredOffice !== null ? (
        formatAddressInline(ids.registeredOffice)
      ) : (
        <MissingFact name="sídlo společnosti" />
      )
    }
    {". "}
    {ui.ico}{" "}
    {ids.ico !== null ? <span class="nowrap">{ids.ico}</span> : <MissingFact name="IČO" />}
    {". "}
    {ids.registryEntry !== null ? ids.registryEntry : <MissingFact name="zápis v obchodním rejstříku" />}
    {". "}
    {
      site.legal !== null ? (
        <>
          {ui.adrFooter} {site.legal.adr.name},{" "}
          <a href={site.legal.adr.url} class="go">{site.legal.adr.url.replace(/^https?:\/\//, "")}</a>
        </>
      ) : null
    }
  </p>
</footer>

<style>
  .foot {
    padding: 0 var(--gutter) var(--s3);
  }

  .foot[data-neutral="true"] {
    margin-top: var(--s3);
  }

  .foot-cols {
    display: grid;
    gap: 2rem;
    margin-top: 2.5rem;
  }

  .foot[data-neutral="true"] .foot-cols {
    margin-top: 0;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }

  .foot-heading {
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .foot-col > * + * {
    margin-top: 0.375rem;
  }

  .foot-col > .foot-heading + * {
    margin-top: 0.5rem;
  }

  .foot-hour-list,
  .foot-links {
    padding: 0;
    list-style: none;
  }

  .foot-hour-list abbr {
    text-decoration: none;
  }

  .foot-legal {
    margin-top: 2.5rem;
  }

  @media (min-width: 48rem) {
    .foot-cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 1.5rem;
    }
  }

  @media (min-width: 64rem) {
    .foot {
      padding-bottom: var(--s4);
    }
  }
</style>

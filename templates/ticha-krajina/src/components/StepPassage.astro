---
/**
 * One guide step in the narrative: a Spectral 600 heading, a muted line saying when it applies,
 * the summary, native checkboxes, the body in <details>, and the contact prompt (the nonstop link
 * in ink, or the office phone). Hidden by the guide's :target filter when it does not apply.
 */
import type { CollectionEntry } from "astro:content";
import EmergencyPhoneLink from "@core/components/EmergencyPhoneLink.astro";
import PhoneLink from "@core/components/PhoneLink.astro";
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import UnreviewedMark from "@core/components/UnreviewedMark.astro";
import { render } from "@core/content/load.ts";
import { situationsAttribute, type SpecificSituation } from "@core/content/guidance-flow.ts";
import type { SiteContext } from "@core/content/view-models.ts";
import { formatPhone } from "@core/format/phone.ts";
import { primaryOfficePhone } from "../lib/site.ts";
import { situationWords, ui } from "../i18n/cs.ts";

interface Props {
  site: SiteContext;
  entry: CollectionEntry<"guidance">;
}

const { site, entry } = Astro.props;
const data = entry.data;
const office = primaryOfficePhone(site);
const named = data.situations.filter((situation) => situation !== "any") as SpecificSituation[];
let applies: string = ui.appliesAlways;
if (named.length > 0) {
  applies = `${ui.appliesWhen} ${named.map((situation) => situationWords[situation]).join(", ")}`;
}
const { Content } = await render(entry);
const hasBody = (entry.body ?? "").trim() !== "";
---
<li id={entry.id} class="step" data-guide-step data-situations={situationsAttribute(entry)}>
  <h3 class="step-title">{data.title}</h3>
  <PlaceholderMark active={data.placeholder} as="div">
    <p class="step-when label">{applies}</p>
    <p class="step-text">{data.summary}</p>
    <UnreviewedMark reviewedAt={data.review.reviewedAt} />
  </PlaceholderMark>
  {
    data.checklist.length > 0 ? (
      <ul class="step-checks" aria-label={ui.checklist}>
        {data.checklist.map((item, index) => (
          <li>
            <label class="tick">
              <input type="checkbox" name={`${entry.id}-${index}`} />
              <span>{item}</span>
            </label>
          </li>
        ))}
      </ul>
    ) : null
  }
  {
    hasBody ? (
      <details class="more">
        <summary>{ui.readMore}</summary>
        <div class="prose step-body">
          <Content />
        </div>
      </details>
    ) : null
  }
  {
    data.contactPrompt === "emergency" && site.emergency.enabled ? (
      <p class="step-call">
        <EmergencyPhoneLink emergency={site.emergency} variant="custom" class="step-call-link">
          {site.emergency.label}{" "}<span class="nowrap">{formatPhone(site.emergency.phone).display}</span>
        </EmergencyPhoneLink>
      </p>
    ) : null
  }
  {
    data.contactPrompt === "office" ? (
      <p class="step-call">
        {ui.officePrompt}:{" "}
        <PhoneLink number={office.number}>{office.label}{" "}<span class="nowrap">{formatPhone(office.number).display}</span></PhoneLink>
      </p>
    ) : null
  }
</li>

<style>
  .step {
    list-style: none;
  }

  .step + .step {
    margin-top: 2.25rem;
  }

  .step-title {
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .step-when {
    margin-top: 0.125rem;
  }

  .step-text {
    margin-top: 0.375rem;
  }

  .step-checks {
    margin-top: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .step-body {
    margin-top: 0.25rem;
  }

  .step-call {
    margin-top: 0.25rem;
  }

  .step-call :global(.step-call-link) {
    display: inline-block;
    padding-block: 0.625rem;
    color: var(--ink);
    font-weight: 600;
  }
</style>

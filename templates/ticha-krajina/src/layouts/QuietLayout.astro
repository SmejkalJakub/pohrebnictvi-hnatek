---
/**
 * Page shell for Template E "Tichá krajina". Options become data attributes on <html>.
 * A plain top bar (wordmark, text navigation, "Menu" below 64 rem), then the page as one long
 * read on the 12-column grid, then the footer, which opens with the second stamp line.
 * High emphasis moves the page's first stamp line directly under the header, before the H1.
 * `neutral` switches the chrome to its notice form (research L1): a muted publisher sentence with
 * the nonstop link, reduced navigation, no stamp lines, a footer without the stamp line.
 */
import "../styles/fonts.css";
import "../styles/global.css";
import "../styles/print.css";
import SeoHead from "@core/components/SeoHead.astro";
import StructuredData from "@core/components/StructuredData.astro";
import PrototypeBanner from "@core/components/PrototypeBanner.astro";
import type { ImageMetadata } from "astro";
import { getDocuments, getFaq, getOptionalPage, getPeople, hasPage } from "@core/content/load.ts";
import type { NavItem, SiteContext } from "@core/content/view-models.ts";
import spectralLatin from "@fontsource/spectral/files/spectral-latin-400-normal.woff2?url";
import spectralLatinExt from "@fontsource/spectral/files/spectral-latin-ext-400-normal.woff2?url";
import gelasioLatin from "@fontsource/gelasio/files/gelasio-latin-400-normal.woff2?url";
import gelasioLatinExt from "@fontsource/gelasio/files/gelasio-latin-ext-400-normal.woff2?url";
import QuietTopBar from "../components/QuietTopBar.astro";
import QuietFooter from "../components/QuietFooter.astro";
import NoticePublisherLine from "../components/NoticePublisherLine.astro";
import StampLine from "../components/StampLine.astro";
import { resolveOptions } from "../lib/options.ts";
import { fullNav, neutralNav } from "../lib/site.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  site: SiteContext;
  /** Page title without the brand name; null on the homepage. */
  title?: string | null;
  description: string;
  noindex?: boolean;
  image?: ImageMetadata | null;
  /** Notice list and notice pages: publisher line, reduced nav, no stamp lines, neutral footer. */
  neutral?: boolean;
}

const { site, title = null, description, noindex = false, image = null, neutral = false } = Astro.props;
const options = resolveOptions(site.config);
const path = Astro.url.pathname;

async function optionalNavItem(id: "pro-ucastniky" | "pohreb-predem", enabled: boolean): Promise<NavItem | null> {
  if (!enabled) {
    return null;
  }
  const page = await getOptionalPage(id);
  if (page === null) {
    return null;
  }
  return { id, label: page.data.navLabel, href: `/${id}/` };
}

const documents = await getDocuments();
const people = await getPeople();
const faq = await getFaq();
const hasLegalPage = await hasPage("pravni-informace");
const hasPrivacyPage = await hasPage("ochrana-osobnich-udaju");
let links = fullNav(site, path, {
  guestInfo: await optionalNavItem("pro-ucastniky", site.config.features.guestInfo),
  prePlanning: await optionalNavItem("pohreb-predem", site.config.features.prePlanning),
  hasPeople: people.length > 0,
  hasFaq: faq.length > 0,
  hasDocuments: documents.length > 0 && hasLegalPage,
});
if (neutral) {
  links = neutralNav(site, path);
}
const high = options.emergencyEmphasis === "high";

/* Preload the 400 face: the H1, the largest paint, is text (Czech titles need latin-ext too). */
let preloads = [spectralLatin, spectralLatinExt];
if (options.fontPair === "gelasio-figtree") {
  preloads = [gelasioLatin, gelasioLatinExt];
}
const menuLabels = JSON.stringify({ open: ui.menuOpen, close: ui.menuClose });
---
<html
  lang="cs"
  class="no-js"
  data-palette={options.palette}
  data-font={options.fontPair}
  data-emphasis={options.emergencyEmphasis}
>
  <head>
    {preloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <SeoHead site={site} title={title} description={description} noindex={noindex} image={image} />
    <script is:inline>
      document.documentElement.classList.replace("no-js", "js");
    </script>
    <StructuredData site={site} />
  </head>
  <body>
    <PrototypeBanner />
    <a href="#obsah" class="skip-link">{ui.skipLink}</a>
    <QuietTopBar site={site} links={links} neutral={neutral} />
    {neutral ? <NoticePublisherLine site={site} /> : null}
    <main id="obsah" tabindex="-1" data-neutral={neutral ? "true" : "false"}>
      {!neutral && high ? <StampLine emergency={site.emergency} place="top" /> : null}
      <slot />
    </main>
    <QuietFooter site={site} neutral={neutral} documents={documents} hasPrivacyPage={hasPrivacyPage} />
    <script is:inline define:vars={{ menuLabels }}>
      const labels = JSON.parse(menuLabels);
      const toggle = document.querySelector("[data-menu-toggle]");
      const panel = toggle === null ? null : document.getElementById(toggle.getAttribute("aria-controls"));
      if (toggle !== null && panel !== null) {
        const setOpen = (open) => {
          toggle.setAttribute("aria-expanded", String(open));
          toggle.textContent = open ? labels.close : labels.open;
          panel.toggleAttribute("data-open", open);
        };
        toggle.addEventListener("click", () => {
          setOpen(toggle.getAttribute("aria-expanded") !== "true");
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
            setOpen(false);
            toggle.focus();
          }
        });
      }
    </script>
  </body>
</html>

<style>
  main {
    display: block;
    padding-bottom: var(--s4);
  }

  main:focus {
    outline: none;
  }
</style>

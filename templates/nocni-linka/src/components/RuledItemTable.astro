---
/** Price items as a ruled two-column table: label (and description) left, price right, no wrap. */
import type { PriceItem } from "@core/content/schemas.ts";
import PriceValue from "@core/components/PriceValue.astro";

interface Props {
  items: PriceItem[];
  caption: string;
}

const { items, caption } = Astro.props;
---
<table class="items">
  <caption class="visually-hidden">{caption}</caption>
  <tbody>
    {
      items.map((item) => (
        <tr>
          <th scope="row" class="item-label">
            {item.label}
            {item.description !== null ? <span class="item-desc">{item.description}</span> : null}
          </th>
          <td class="item-price">
            <PriceValue item={item} />
          </td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .items {
    width: 100%;
    margin-top: 1.5rem;
    border-collapse: collapse;
  }

  .items th,
  .items td {
    padding: 0.875rem 0;
    border-top: 1px solid var(--rule);
    vertical-align: top;
    text-align: left;
  }

  .items tr:last-child th,
  .items tr:last-child td {
    border-bottom: 1px solid var(--rule);
  }

  .item-label {
    font-weight: 400;
  }

  .item-desc {
    display: block;
    color: var(--muted);
    font-size: 1.125rem;
  }

  .item-price {
    padding-left: 1.5rem !important;
    text-align: right !important;
    font-weight: 700;
  }

  .item-price :global([data-price-amount]) {
    white-space: nowrap;
  }

  @media (min-width: 64rem) {
    .items {
      font-size: 1.375rem;
    }
  }
</style>

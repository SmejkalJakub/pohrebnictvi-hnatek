---
/**
 * The nonstop number in its default form: label in ink, the number large in --signal (the only
 * amber on the site) with a 3 px underline, never wrapping. In the rail on desktop, as a panel on
 * the rail colour under the name row on mobile. Also repeated inside guide steps with an
 * emergency contact prompt (`inline`). Size follows emergencyEmphasis via --num-rail/--num-panel.
 */
import EmergencyPhoneLink from "@core/components/EmergencyPhoneLink.astro";
import type { EmergencyTransport } from "@core/content/schemas.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  emergency: EmergencyTransport;
  /** Inside page content (guide steps, contact): no rail layout, smaller number. */
  inline?: boolean;
}

const { emergency, inline = false } = Astro.props;
let note: string = ui.emergencyAround;
if (emergency.shortNote !== null) {
  note = emergency.shortNote;
}
---
{
  emergency.enabled ? (
    <div class="call" data-inline={inline ? "true" : "false"}>
      <EmergencyPhoneLink emergency={emergency} class="call-link" labelClass="call-label" numberClass="call-number" />
      {inline ? null : <p class="call-note">{note}</p>}
    </div>
  ) : null
}

<style>
  .call {
    padding: 1rem var(--gutter) 1.125rem;
    background: var(--rail);
  }

  .call :global(.call-link) {
    display: block;
    color: var(--signal);
    text-decoration: none;
  }

  .call :global(.call-label) {
    display: block;
    color: var(--ink);
    font-size: 1.1875rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .call :global(.call-number) {
    display: block;
    font-size: var(--num-panel);
    font-weight: 700;
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.2em;
  }

  .call :global(.call-link:hover .call-number) {
    text-decoration-thickness: 5px;
  }

  .call-note {
    margin-top: 0.375rem;
    color: var(--muted);
    font-size: 1.125rem;
  }

  .call[data-inline="true"] {
    margin-top: 0.875rem;
  }

  .call[data-inline="true"] :global(.call-number) {
    font-size: 1.875rem;
  }

  @media (min-width: 64rem) {
    .call[data-inline="false"] {
      margin-top: 3.25rem;
      padding: 0;
      background: transparent;
    }

    .call[data-inline="false"] :global(.call-label) {
      font-size: 1.25rem;
    }

    .call[data-inline="false"] :global(.call-number) {
      margin-top: 0.25rem;
      font-size: var(--num-rail);
      line-height: 1.15;
      text-underline-offset: 0.21em;
    }

    .call[data-inline="false"] .call-note {
      margin-top: 0.75rem;
    }

    .call[data-inline="true"] {
      padding: 1.25rem 1.5rem;
    }
  }
</style>

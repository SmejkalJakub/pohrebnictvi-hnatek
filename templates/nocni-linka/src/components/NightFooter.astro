---
/**
 * Footer on the rail colour, every page. Four columns at desktop width: name and address ·
 * Kancelář (office hours under their own heading, office phone) · the nonstop line under its own
 * heading · Dokumenty (when documents are on). Below, the legal row (research L8, L10): legal
 * name, sídlo, IČO, register entry, the ADR body, Právní informace and the privacy page.
 * Neutral form (notice pages): no Dokumenty column, "Telefon nonstop" in ink, no amber.
 * Compact form (home ending with the office statement): no address and office columns, which the
 * page shows just above; the nonstop line, documents and the legal row stay.
 */
import { Image } from "astro:assets";
import EmergencyPhoneLink from "@core/components/EmergencyPhoneLink.astro";
import { brandMark } from "@core/brand/runtime.ts";
import MissingFact from "@core/components/MissingFact.astro";
import PhoneLink from "@core/components/PhoneLink.astro";
import type { DocumentView, SiteContext } from "@core/content/view-models.ts";
import { formatAddressInline, formatAddressLines } from "@core/format/address.ts";
import { mainLocation, mapHref, primaryOfficePhone } from "../lib/site.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  site: SiteContext;
  neutral: boolean;
  documents: DocumentView[];
  hasPrivacyPage: boolean;
  compact?: boolean;
}

const { site, neutral, documents, hasPrivacyPage, compact = false } = Astro.props;
const location = mainLocation(site);
const [street, cityLine] = formatAddressLines(location.address);
const map = mapHref(location);
const office = primaryOfficePhone(site);
const ids = site.company.legalIds;
const showDocuments = !neutral && documents.length > 0;
/* The brand mark (light emblem) signs the legal row, quietly; not on neutral notice pages. */
let mark = brandMark();
if (neutral) {
  mark = null;
}
let emergencyHeading = site.emergency.label;
if (neutral) {
  emergencyHeading = ui.neutralPhone;
}
---
<footer class="night-footer" data-neutral={neutral ? "true" : "false"} data-compact={compact ? "true" : "false"}>
  <div class="foot-cols">
    {
      compact ? null : (
        <div class="foot-col">
          <p class="foot-brand">{site.company.brandName}</p>
          <p class="foot-muted">{street}<br />{cityLine}</p>
          {map !== null ? <p class="foot-gap"><a href={map}>{ui.mapLink}</a></p> : null}
        </div>
      )
    }
    {
      compact ? null : (
        <section class="foot-col" aria-labelledby="pata-kancelar" data-office-hours>
          <h2 id="pata-kancelar" class="foot-heading">{site.officeHours.label}</h2>
          <ul class="foot-hours">
            {site.officeHoursRows.map((row) => (
              <li>
                <span>{row.days}</span> <span class="nowrap">{row.text}</span>
                {row.note !== null ? <span class="foot-note">{row.note}</span> : null}
              </li>
            ))}
          </ul>
          <p class="foot-gap"><PhoneLink number={office.number} class="foot-phone" /></p>
        </section>
      )
    }
    {
      site.emergency.enabled ? (
        <section class="foot-col" aria-labelledby="pata-nonstop" data-emergency-block>
          <h2 id="pata-nonstop" class="foot-heading">{emergencyHeading}</h2>
          <p class="foot-gap">
            <EmergencyPhoneLink emergency={site.emergency} variant="number" class="foot-emergency" />
          </p>
        </section>
      ) : null
    }
    {
      showDocuments ? (
        <section class="foot-col" aria-labelledby="pata-dokumenty">
          <h2 id="pata-dokumenty" class="foot-heading">{ui.documentsFooter}</h2>
          <ul class="foot-docs">
            {documents.map((document) => (
              <li>
                <a href={document.href}>{document.title}</a> ({ui.pdf})
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }
  </div>
  <div class="foot-legal" data-mark={mark !== null ? "true" : "false"}>
    {mark !== null ? <Image src={mark} alt="" width={44} class="foot-mark" loading="lazy" /> : null}
    <p class="foot-muted" data-legal-identification>
      {site.company.legalName}
      {", "}
      {
        ids.registeredOffice !== null ? (
          formatAddressInline(ids.registeredOffice)
        ) : (
          <MissingFact name="sídlo společnosti" />
        )
      }
      {". "}
      {ui.ico}{" "}
      {ids.ico !== null ? <span class="nowrap">{ids.ico}</span> : <MissingFact name="IČO" />}
      {". "}
      {ids.registryEntry !== null ? ids.registryEntry : <MissingFact name="zápis v obchodním rejstříku" />}
      {site.legal !== null ? (
        <>
          {" "}
          {ui.adrFooter} {site.legal.adr.name}, <a href={site.legal.adr.url}>{site.legal.adr.url.replace(/^https?:\/\//, "")}</a>.
        </>
      ) : null}
    </p>
    <p class="foot-links">
      {site.legalLink !== null ? <a href={site.legalLink.href}>{site.legalLink.label}</a> : null}
      {site.legalLink !== null && hasPrivacyPage ? <span aria-hidden="true"> · </span> : null}
      {hasPrivacyPage ? <a href="/ochrana-osobnich-udaju/">{ui.privacy}</a> : null}
    </p>
  </div>
</footer>

<style>
  .night-footer {
    padding: 2.5rem var(--gutter) 3rem;
    background: var(--rail);
    font-size: 1.125rem;
    line-height: 1.45;
  }

  .foot-cols {
    display: grid;
    gap: 2rem;
  }

  .foot-brand {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .foot-heading {
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .foot-muted,
  .foot-hours {
    margin-top: 0.375rem;
    color: var(--muted);
  }

  .foot-hours,
  .foot-docs {
    padding: 0;
    list-style: none;
  }

  .foot-docs {
    margin-top: 0.375rem;
    line-height: 1.7;
  }

  .foot-note {
    display: block;
  }

  .foot-gap {
    margin-top: 0.375rem;
  }

  .night-footer :global(.foot-phone),
  .night-footer :global(.foot-emergency) {
    display: inline-block;
    padding-block: 0.6rem;
  }

  .night-footer :global(.foot-emergency) {
    color: var(--signal);
    font-size: 1.5rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .night-footer[data-neutral="true"] :global(.foot-emergency) {
    color: var(--ink);
    font-size: 1.25rem;
  }

  .foot-legal {
    display: grid;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }

  .foot-links a {
    display: inline-block;
    padding-block: 0.375rem;
  }

  .foot-legal :global(.foot-mark) {
    width: 2.75rem;
    height: auto;
    opacity: 0.85;
  }

  @media (min-width: 48rem) {
    .foot-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem;
    }
  }

  @media (min-width: 64rem) {
    .night-footer {
      padding: 3.5rem 4rem 4rem;
    }

    .foot-cols {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .foot-legal {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 2rem;
      margin-top: 2.5rem;
    }

    .foot-legal[data-mark="true"] {
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: start;
    }

    .foot-legal .foot-muted {
      max-width: 47.5rem;
      margin-top: 0;
    }
  }
</style>

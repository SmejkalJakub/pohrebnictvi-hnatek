---
/**
 * One guide step as one statement: kicker "Krok n z N · phase" (n from a CSS counter, so it
 * stays continuous when the filter hides steps; N per situation), heading, who it applies to,
 * the summary, the guided list ("Postupně": calm numbered sentences in the signal colour, never
 * tick boxes; design-differentiation §1.3), the body in <details>, the contact prompt and
 * "Potom: <next step>" (data-guide-next: core scrolls there without dropping the situation filter).
 * The step reached shows a quiet arrival mark (:target or core's data-guide-arrived).
 */
import type { CollectionEntry } from "astro:content";
import PhoneLink from "@core/components/PhoneLink.astro";
import { render } from "@core/content/load.ts";
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import UnreviewedMark from "@core/components/UnreviewedMark.astro";
import { guideSentence, situationsAttribute, type SpecificSituation } from "@core/content/guidance-flow.ts";
import type { SiteContext } from "@core/content/view-models.ts";
import { formatPhone } from "@core/format/phone.ts";
import RailNumber from "./RailNumber.astro";
import { guidancePhaseLabels, situationPhrases, ui } from "../i18n/cs.ts";
import { primaryOfficePhone } from "../lib/site.ts";

interface Props {
  site: SiteContext;
  entry: CollectionEntry<"guidance">;
  /** Steps shown for each situation, and in total ("z N"). */
  totals: { all: number; bySituation: Partial<Record<SpecificSituation, number>> };
  next: CollectionEntry<"guidance"> | null;
}

const { site, entry, totals, next } = Astro.props;
const data = entry.data;
const office = primaryOfficePhone(site);
const officeDisplay = formatPhone(office.number).display;
const named = data.situations.filter((situation) => situation !== "any") as SpecificSituation[];
let appliesTo: string | null = null;
if (named.length > 0) {
  appliesTo = `${ui.appliesTo} ${named.map((situation) => situationPhrases[situation]).join(", ")}.`;
}
const headingId = `${entry.id}-nadpis`;
const listHeadingId = `${entry.id}-postupne`;
const { Content } = await render(entry);
---
<li id={entry.id} class="step st" data-guide-step data-situations={situationsAttribute(entry)}>
  <p class="kicker">
    {ui.step}{" "}<span class="step-n"></span>{" "}<span class="step-of" data-of="all">{ui.stepOf(totals.all)}</span>{
      Object.entries(totals.bySituation).map(([situation, total]) => (
        <span class="step-of" data-of={situation}>
          {ui.stepOf(total ?? 0)}
        </span>
      ))
    }{" · "}{guidancePhaseLabels[data.phase]}
  </p>
  <h2 id={headingId} class="st-heading step-title">{data.title}</h2>
  <PlaceholderMark active={data.placeholder} as="div">
    {appliesTo !== null ? <p class="muted small step-applies">{appliesTo}</p> : null}
    <p class="st-text">{data.summary}</p>
    <UnreviewedMark reviewedAt={data.review.reviewedAt} />
  </PlaceholderMark>
  {
    data.checklist.length > 0 ? (
      <div class="guide-list">
        <h3 id={listHeadingId} class="guide-list-heading">{ui.guideListHeading}</h3>
        <ol class="guide-items" aria-labelledby={listHeadingId}>
          {data.checklist.map((item) => (
            <li>{guideSentence(item)}</li>
          ))}
        </ol>
      </div>
    ) : null
  }
  <details class="step-more">
    <summary>{ui.readMore}</summary>
    <div class="prose step-body"><Content /></div>
  </details>
  {data.contactPrompt === "emergency" ? <RailNumber emergency={site.emergency} inline /> : null}
  {
    data.contactPrompt === "office" ? (
      <p class="st-text">
        {ui.officePrompt}:{" "}
        <PhoneLink number={office.number}>{office.label}{" "}<span class="nowrap">{officeDisplay}</span></PhoneLink>
      </p>
    ) : null
  }
  {
    next !== null ? (
      <a href={`#${next.id}`} class="st-link" data-guide-next>
        {ui.then}: {next.data.title}
      </a>
    ) : null
  }
</li>

<style>
  .step {
    counter-increment: step;
    list-style: none;
  }

  .step-n::before {
    content: counter(step);
  }

  .step-of:not([data-of="all"]) {
    display: none;
  }

  .step-title {
    font-size: 1.875rem;
  }

  .step-applies {
    margin-top: 0.25rem;
  }

  .guide-list {
    max-width: 34em;
    margin-top: 1.25rem;
  }

  .guide-list-heading {
    color: var(--muted);
    font-family: var(--font);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .guide-items {
    margin: 0.375rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: guide-item;
  }

  /* One instruction per line, its number large and in the signal colour: read at a glance. */
  .guide-items li {
    counter-increment: guide-item;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    align-items: baseline;
    padding-block: 0.375rem;
  }

  .guide-items li::before {
    content: counter(guide-item);
    color: var(--signal);
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: var(--display-weight);
    line-height: 1;
    font-variant-numeric: lining-nums tabular-nums;
  }

  /* Arriving through a "Potom" link (core sets data-guide-arrived and keeps the situation
     filter; without JS the hash makes it :target): the step's rule and kicker take the signal
     colour. Core focuses the step (tabindex=-1); the arrival mark replaces a focus ring. */
  .step:target,
  .step[data-guide-arrived] {
    border-top-color: var(--signal);
  }

  .step:target .kicker,
  .step[data-guide-arrived] .kicker {
    color: var(--signal);
  }

  .step:focus,
  .step:focus-visible {
    outline: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .step,
    .step .kicker {
      transition:
        border-top-color 180ms ease,
        color 180ms ease;
    }
  }

  .step-more {
    margin-top: 0.75rem;
  }

  .step-more summary {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 55%, transparent);
    text-underline-offset: 0.3125em;
    cursor: pointer;
    transition:
      text-decoration-color 150ms ease,
      text-underline-offset 150ms ease;
  }

  .step-more summary:hover {
    text-decoration-color: currentColor;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .step-body {
    margin-top: 0.5rem;
  }

  @media (min-width: 64rem) {
    .step-title {
      font-size: 3rem;
    }

    .guide-list {
      margin-top: 1.5rem;
    }

    .guide-list-heading {
      font-size: 1.25rem;
    }

    .guide-items li {
      grid-template-columns: 3rem minmax(0, 1fr);
      font-size: 1.375rem;
    }

    .guide-items li::before {
      font-size: 2.25rem;
    }
  }
</style>

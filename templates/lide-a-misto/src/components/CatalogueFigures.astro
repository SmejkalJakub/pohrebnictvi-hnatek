---
/**
 * Coffins or flowers with photos: numbered figures in four columns (name in the caption, then
 * code / material / type and the summary). An item without a photo is a text cell under a 1 px
 * rule. Zero items: one sentence (the page adds the office phone).
 */
import type { ImageRef } from "@core/content/schemas.ts";
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import NumberedFigure from "./NumberedFigure.astro";
import { figureNumber } from "../lib/figures.ts";

export interface CatalogueItem {
  id: string;
  name: string;
  detail: string | null;
  summary: string | null;
  image: ImageRef | null;
  placeholder: boolean;
}

interface Props {
  items: CatalogueItem[];
  ratio: string;
}

const { items, ratio } = Astro.props;
---
<ul class="catalogue" role="list">
  {
    items.map((item, index) => (
      <li id={item.id} class="item">
        <PlaceholderMark active={item.placeholder} as="div">
          {item.image !== null ? (
            <NumberedFigure
              image={item.image}
              number={figureNumber(index + 1)}
              name={item.name}
              text={item.detail}
              ratio={ratio}
              widths={[280, 420, 560]}
              sizes="(min-width: 64rem) 17rem, (min-width: 48rem) 45vw, 100vw"
            />
          ) : (
            <div class="item-text">
              <span class="fig-num" data-figure-number>{figureNumber(index + 1)}</span>
              <b class="item-name">{item.name}</b>
              {item.detail !== null ? <span class="muted">{item.detail}</span> : null}
            </div>
          )}
          {item.summary !== null ? <p class="item-summary">{item.summary}</p> : null}
        </PlaceholderMark>
      </li>
    ))
  }
</ul>

<style>
  .catalogue {
    display: grid;
    gap: 2rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .item-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-top: 0.875rem;
    border-top: 1px solid var(--ink);
  }

  .item-name {
    font-size: 1.25rem;
  }

  .item-summary {
    margin-top: 0.375rem;
  }

  /*
   * Product photos come on white: multiplied into the ground they sit on the page instead of as
   * white boxes (the photo tone behind cropped images is dropped for the same reason).
   */
  .catalogue :global(.photo) {
    background: transparent;
    mix-blend-mode: multiply;
  }

  @media (min-width: 48rem) {
    .catalogue {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .catalogue {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>

---
/**
 * One guide step under a 3 px rule with a large green numeral (a step, not a figure): title,
 * summary, a bold-led muted line naming where it applies, native checkboxes, the body in
 * <details>, and the contact prompt (the nonstop link, or the office phone). Hidden by the
 * guide's :target filter when it does not apply.
 */
import type { CollectionEntry } from "astro:content";
import EmergencyPhoneLink from "@core/components/EmergencyPhoneLink.astro";
import PhoneLink from "@core/components/PhoneLink.astro";
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import UnreviewedMark from "@core/components/UnreviewedMark.astro";
import { render } from "@core/content/load.ts";
import { situationsAttribute, type SpecificSituation } from "@core/content/guidance-flow.ts";
import type { SiteContext } from "@core/content/view-models.ts";
import { formatPhone } from "@core/format/phone.ts";
import { primaryOfficePhone } from "../lib/site.ts";
import { situationWords, ui } from "../i18n/cs.ts";

interface Props {
  site: SiteContext;
  entry: CollectionEntry<"guidance">;
  numeral: number;
}

const { site, entry, numeral } = Astro.props;
const data = entry.data;
const office = primaryOfficePhone(site);
const named = data.situations.filter((situation) => situation !== "any") as SpecificSituation[];
let applies: string | null = null;
if (named.length > 0) {
  applies = named.map((situation) => situationWords[situation]).join(", ");
}
const { Content } = await render(entry);
const hasBody = (entry.body ?? "").trim() !== "";
---
<li id={entry.id} class="step" data-guide-step data-situations={situationsAttribute(entry)}>
  <span class="step-numeral" aria-hidden="true">{numeral}</span>
  <div class="step-text">
    <h3 class="step-title">{data.title}</h3>
    <PlaceholderMark active={data.placeholder} as="div" class="step-summary">
      <p>{data.summary}</p>
      <UnreviewedMark reviewedAt={data.review.reviewedAt} />
    </PlaceholderMark>
    {applies !== null ? <p class="step-when"><b>{ui.appliesWhen}</b> {applies}.</p> : null}
    {
      data.checklist.length > 0 ? (
        <ul class="step-checks" aria-label={ui.checklist}>
          {data.checklist.map((item, index) => (
            <li>
              <label class="tick">
                <input type="checkbox" name={`${entry.id}-${index}`} />
                <span>{item}</span>
              </label>
            </li>
          ))}
        </ul>
      ) : null
    }
    {
      hasBody ? (
        <details class="more">
          <summary>{ui.readMore}</summary>
          <div class="prose">
            <Content />
          </div>
        </details>
      ) : null
    }
    {
      data.contactPrompt === "emergency" && site.emergency.enabled ? (
        <EmergencyPhoneLink emergency={site.emergency} variant="custom" class="go step-call">
          {site.emergency.label}{" "}<span class="nowrap">{formatPhone(site.emergency.phone).display}</span>
        </EmergencyPhoneLink>
      ) : null
    }
    {
      data.contactPrompt === "office" ? (
        <PhoneLink number={office.number} class="step-call">
          {ui.officePrompt}{" "}<span class="nowrap">{formatPhone(office.number).display}</span>
        </PhoneLink>
      ) : null
    }
  </div>
</li>

<style>
  .step {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    column-gap: 0.5rem;
    padding-top: 0.625rem;
    border-top: 3px solid var(--ink);
  }

  .step-numeral {
    color: var(--green);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1;
  }

  .step-text {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 0.375rem;
    min-width: 0;
  }

  .step-title {
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .step-when {
    color: var(--muted);
    font-size: 1.0625rem;
  }

  .step-when b {
    color: var(--ink);
  }

  .step-checks {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tick {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: 0.5rem;
    align-items: start;
    padding-block: 0.375rem;
    cursor: pointer;
  }

  .tick input {
    width: 1.25rem;
    height: 1.25rem;
    margin: 0.2rem 0 0;
    accent-color: var(--green);
  }

  .more summary {
    display: inline-block;
    padding-block: 0.625rem;
    text-decoration: underline;
    cursor: pointer;
  }

  @media (min-width: 64rem) {
    .step {
      grid-template-columns: 3.5rem minmax(0, 1fr);
      padding-top: 0.875rem;
    }

    .step-numeral {
      font-size: 2.5rem;
    }
  }
</style>

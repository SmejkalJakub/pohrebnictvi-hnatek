---
/**
 * One guide step under a 3 px rule with a large green numeral (a step, not a figure): title,
 * summary, a bold-led muted line naming where it applies, the step's short guided list
 * ("Krok za krokem", sub-numbered 3.1, 3.2 in Archivo like the figure index; never tick boxes,
 * design-differentiation §1.3), the body in <details>, the contact prompt (the nonstop link, or
 * the office phone) and "Potom: …" to the step that follows. Hidden by the guide's :target filter
 * when it does not apply. Arriving through a "Potom" link turns the rule green.
 */
import type { CollectionEntry } from "astro:content";
import EmergencyPhoneLink from "@core/components/EmergencyPhoneLink.astro";
import PhoneLink from "@core/components/PhoneLink.astro";
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import UnreviewedMark from "@core/components/UnreviewedMark.astro";
import { render } from "@core/content/load.ts";
import { guideSentence, situationsAttribute, type SpecificSituation } from "@core/content/guidance-flow.ts";
import type { SiteContext } from "@core/content/view-models.ts";
import { formatPhone } from "@core/format/phone.ts";
import { primaryOfficePhone } from "../lib/site.ts";
import { situationWords, ui } from "../i18n/cs.ts";

interface Props {
  site: SiteContext;
  entry: CollectionEntry<"guidance">;
  numeral: number;
  /** The step "Potom" links to (nextGuidanceStep), or null for the last step. */
  next: { id: string; title: string } | null;
}

const { site, entry, numeral, next } = Astro.props;
const data = entry.data;
const office = primaryOfficePhone(site);
const named = data.situations.filter((situation) => situation !== "any") as SpecificSituation[];
let applies: string | null = null;
if (named.length > 0) {
  applies = named.map((situation) => situationWords[situation]).join(", ");
}
const { Content } = await render(entry);
const hasBody = (entry.body ?? "").trim() !== "";
const sequenceLabelId = `${entry.id}-postupne`;
---
<li id={entry.id} class="step" data-guide-step data-situations={situationsAttribute(entry)}>
  <span class="step-numeral" aria-hidden="true">{numeral}</span>
  <div class="step-text">
    <h3 class="step-title">{data.title}</h3>
    <PlaceholderMark active={data.placeholder} as="div" class="step-summary">
      <p>{data.summary}</p>
      <UnreviewedMark reviewedAt={data.review.reviewedAt} />
    </PlaceholderMark>
    {applies !== null ? <p class="step-when"><b>{ui.appliesWhen}</b> {applies}.</p> : null}
    {
      data.checklist.length > 0 ? (
        <div class="step-guide">
          <p class="step-guide-label caps" id={sequenceLabelId}>{ui.guideSequence}</p>
          <ol class="step-sequence" role="list" aria-labelledby={sequenceLabelId}>
            {data.checklist.map((item, index) => (
              <li>
                <span class="seq-num" aria-hidden="true">{numeral}.{index + 1}</span>
                <span>{guideSentence(item)}</span>
              </li>
            ))}
          </ol>
        </div>
      ) : null
    }
    {
      hasBody ? (
        <details class="more">
          <summary>{ui.readMore}</summary>
          <div class="prose">
            <Content />
          </div>
        </details>
      ) : null
    }
    {
      data.contactPrompt === "emergency" && site.emergency.enabled ? (
        <EmergencyPhoneLink emergency={site.emergency} variant="custom" class="go step-call">
          {site.emergency.label}{" "}<span class="nowrap">{formatPhone(site.emergency.phone).display}</span>
        </EmergencyPhoneLink>
      ) : null
    }
    {
      data.contactPrompt === "office" ? (
        <PhoneLink number={office.number} class="step-call">
          {ui.officePrompt}{" "}<span class="nowrap">{formatPhone(office.number).display}</span>
        </PhoneLink>
      ) : null
    }
    {
      next !== null ? (
        <a href={`#${next.id}`} class="step-next" data-guide-next>{ui.nextStep(next.title)}</a>
      ) : null
    }
  </div>
</li>

<style>
  .step {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    column-gap: 0.5rem;
    padding-top: 0.625rem;
    border-top: 3px solid var(--ink);
  }

  .step-numeral {
    color: var(--green);
    font-family: var(--font-num);
    font-variant-numeric: tabular-nums;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1;
  }

  .step-text {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 0.375rem;
    min-width: 0;
  }

  .step-title {
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .step-when {
    color: var(--muted);
    font-size: 1.0625rem;
  }

  .step-when b {
    color: var(--ink);
  }

  .step-guide {
    width: 100%;
    margin-top: 0.5rem;
  }

  .step-guide-label {
    font-size: 0.9375rem;
  }

  .step-sequence {
    margin: 0.375rem 0 0;
    padding: 0;
    list-style: none;
  }

  /* 1 px rules between rows, the sub-number in the figure-index column. */
  .step-sequence li {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    column-gap: 0.5rem;
    padding-block: 0.5rem;
    border-top: 1px solid var(--ink);
  }

  .step-sequence li:last-child {
    border-bottom: 1px solid var(--ink);
  }

  .seq-num {
    padding-top: 0.125rem;
    color: var(--green);
    font-family: var(--font-num);
    font-size: 0.9375rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .step-next {
    display: inline-block;
    padding-block: 0.625rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .step-next:hover {
    color: var(--green);
    text-decoration-thickness: 2px;
  }

  /* Arriving through "Potom": the rule turns green, quietly (off under reduced motion, global.css). */
  .step {
    scroll-margin-top: 1rem;
    transition: border-color 200ms var(--ease);
  }

  .step:target,
  .step[data-guide-arrived] {
    border-top-color: var(--green-fill);
  }

  .step:target .step-numeral,
  .step[data-guide-arrived] .step-numeral {
    color: var(--green);
  }

  .more summary {
    display: inline-block;
    padding-block: 0.625rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
    transition: color 140ms var(--ease);
  }

  .more summary:hover {
    color: var(--green);
    text-decoration-thickness: 2px;
  }

  @media (min-width: 64rem) {
    .step {
      grid-template-columns: 3.5rem minmax(0, 1fr);
      padding-top: 0.875rem;
    }

    .step-numeral {
      font-size: 2.5rem;
    }
  }
</style>

---
/**
 * One documentary photo with its numbered caption: "01  Name. One sentence." with an optional
 * muted address line and "Foto: credit". The number means a figure or a place, nothing else
 * (plan s11 §4.2). Cropped around the image's focus to `ratio`; `ratioWide` applies from 64 rem.
 * Rendered with <Picture> (AVIF + WebP); `priority` makes it the eager, high-priority LCP image.
 * No text on the photo, ever.
 */
import { Picture } from "astro:assets";
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import type { ImageRef } from "@core/content/schemas.ts";
import { resolveImage } from "@core/media/resolve.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  image: ImageRef;
  number: string;
  /** Bold lead of the caption (a place or a person); null to use only `text`. */
  name?: string | null;
  /** Makes the bold lead a link (e.g. the home people photo → O nás). */
  nameHref?: string | null;
  /** Element id and data-xref value, so references to this number highlight the figure. */
  xref?: boolean;
  text?: string | null;
  address?: string | null;
  /** CSS aspect-ratio, e.g. "3 / 2". */
  ratio: string;
  ratioWide?: string | null;
  widths: number[];
  sizes: string;
  priority?: boolean;
  class?: string;
}

const {
  image,
  number,
  name = null,
  nameHref = null,
  xref = false,
  text = null,
  address = null,
  ratio,
  ratioWide = null,
  widths,
  sizes,
  priority = false,
  class: className,
} = Astro.props;
const photo = resolveImage(image);
let wide = ratio;
if (ratioWide !== null) {
  wide = ratioWide;
}
let loading: "eager" | "lazy" = "lazy";
let fetchpriority: "high" | "low" | "auto" = "auto";
if (priority) {
  loading = "eager";
  fetchpriority = "high";
}
let lead = "";
if (name !== null) {
  lead = name;
  if (text !== null) {
    lead += ".";
  }
}
---
<figure
  class:list={["fig", className]}
  data-figure
  id={xref ? `obrazek-${number}` : undefined}
  data-xref={xref ? number : undefined}
  style={`--ratio: ${ratio}; --ratio-wide: ${wide}`}
>
  <PlaceholderMark active={photo.isPlaceholder} kind="image" as="div" class="fig-frame">
    <Picture
      src={photo.src}
      alt={photo.alt}
      formats={["avif", "webp"]}
      widths={widths}
      sizes={sizes}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      class="photo fig-img"
      style={`object-position: ${photo.objectPosition}`}
    />
  </PlaceholderMark>
  <figcaption class="fig-caption">
    <span class="fig-num" data-figure-number>{number}</span>
    {lead !== "" && nameHref === null ? <b class="fig-name">{lead}</b> : null}
    {lead !== "" && nameHref !== null ? (
      <a href={nameHref} class="fig-name fig-name-link">
        {lead}
      </a>
    ) : null}
    {text !== null ? <span>{text}</span> : null}
    {address !== null ? <span class="fig-address">{address}</span> : null}
    {photo.credit !== null ? <span class="fig-credit">{ui.photoBy}: {photo.credit}</span> : null}
  </figcaption>
</figure>

<style>
  .fig :global(.fig-img) {
    aspect-ratio: var(--ratio);
  }

  .fig-caption {
    padding-top: 0.625rem;
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .fig-num {
    margin-right: 0.625rem;
  }

  .fig-name {
    margin-right: 0.25rem;
  }

  .fig-name-link {
    font-weight: 700;
  }

  .fig-address,
  .fig-credit {
    display: block;
    color: var(--muted);
  }

  @media (min-width: 64rem) {
    .fig :global(.fig-img) {
      aspect-ratio: var(--ratio-wide);
    }
  }
</style>

---
/**
 * The header (not sticky): wordmark or logo with the firm's own tradition wording as a muted
 * subtitle; at ≥ 64 rem the text navigation in one row beside it (wrapping when long), with a
 * 1 px rule under the bar. Below 64 rem an outlined "Menu" button opens, in the flow, the list of
 * 24 px bold links between 1 px rules, the nonstop block and the office phone under its own
 * heading. Without JS the list shows in the flow and the button is hidden.
 * `neutral` (notice pages): the reduced list only, no nonstop block in the menu (the publisher
 * sentence carries the number).
 */
import { Image } from "astro:assets";
import PhoneLink from "@core/components/PhoneLink.astro";
import type { SiteContext } from "@core/content/view-models.ts";
import { formatPhone } from "@core/format/phone.ts";
import { resolveOptionalImage } from "@core/media/resolve.ts";
import NonstopRuleBlock from "./NonstopRuleBlock.astro";
import type { EssayLink } from "../lib/site.ts";
import { primaryOfficePhone } from "../lib/site.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  site: SiteContext;
  links: EssayLink[];
  neutral: boolean;
}

const { site, links, neutral } = Astro.props;
const logo = resolveOptionalImage(site.company.logo);
const subtitle = site.company.tradition.publicWording;
const office = primaryOfficePhone(site);
---
<header class="masthead">
  <div class="frame bar">
    <div class="brand">
      <a href="/" class="wordmark" aria-label={logo === null ? undefined : site.company.brandName}>
        {
          logo !== null ? (
            <Image src={logo.src} alt="" height={48} class="logo" loading="eager" />
          ) : (
            site.company.brandName
          )
        }
      </a>
      {subtitle !== null ? <span class="subtitle">{subtitle}</span> : null}
    </div>
    <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="menu" data-menu-toggle>
      {ui.menuOpen}
    </button>
    <nav aria-label={ui.mainNav} class="menu-nav">
      <div id="menu" class="menu" data-menu-panel>
        <ul class="nav-list">
          {
            links.map((link) => (
              <li>
                <a href={link.href} class="nav-link" aria-current={link.current ? "page" : undefined}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        {
          neutral ? null : (
            <div class="menu-extra">
              <NonstopRuleBlock emergency={site.emergency} size="menu" />
              <div class="menu-office">
                <p class="menu-office-heading">{ui.officeHeading}</p>
                <PhoneLink number={office.number}>
                  {office.label}{" "}<span class="nowrap">{formatPhone(office.number).display}</span>
                </PhoneLink>
              </div>
            </div>
          )
        }
      </div>
    </nav>
  </div>
</header>

<style>
  .masthead {
    border-bottom: 1px solid var(--ink);
  }

  .bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 1rem;
    padding-block: 0.875rem;
  }

  .brand {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }

  .wordmark {
    align-self: start;
    font-size: 1.1875rem;
    font-weight: 700;
    line-height: 1.25;
    text-decoration: none;
  }

  .wordmark :global(.logo) {
    width: auto;
    height: 2.5rem;
  }

  .subtitle {
    color: var(--muted-2);
    font-size: 1rem;
    line-height: 1.4;
  }

  .menu-toggle {
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 2px solid var(--ink);
    background: transparent;
    color: var(--ink);
    font-weight: 700;
    cursor: pointer;
  }

  .menu-toggle[aria-expanded="true"] {
    background: var(--ink);
    color: var(--ground);
  }

  :global(.no-js) .menu-toggle {
    display: none;
  }

  /* The <nav> landmark stays rendered on phones; only the panel inside it is hidden. */
  .menu-nav {
    grid-column: 1 / -1;
  }

  :global(.js) .menu:not([data-open]) {
    display: none;
  }

  .nav-list {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .nav-list li {
    border-bottom: 1px solid var(--ink);
  }

  .nav-link {
    display: block;
    padding-block: 0.875rem;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.25;
    text-decoration: none;
  }

  .nav-link[aria-current="page"] {
    text-decoration: underline;
    text-decoration-thickness: 3px;
  }

  .menu-extra {
    display: grid;
    gap: 1.75rem;
    padding: 1.75rem 0 1rem;
  }

  .menu-office {
    border-top: 1px solid var(--ink);
    padding-top: 0.75rem;
  }

  .menu-office-heading {
    font-size: 1.25rem;
    font-weight: 700;
  }

  @media (min-width: 64rem) {
    .bar {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 3rem;
      padding-block: 1.375rem;
    }

    .wordmark {
      font-size: 1.5rem;
    }

    .wordmark :global(.logo) {
      height: 3rem;
    }

    .subtitle {
      font-size: 1.0625rem;
    }

    .menu-toggle {
      display: none;
    }

    .menu-nav {
      grid-column: auto;
    }

    .menu,
    :global(.js) .menu:not([data-open]) {
      display: block;
    }

    .nav-list {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      column-gap: 1.75rem;
      margin: 0;
    }

    .nav-list li {
      border-bottom: 0;
    }

    .nav-link {
      padding-block: 0.625rem;
      font-size: 1.125rem;
      font-weight: 400;
      text-decoration: underline;
      text-decoration-thickness: 1px;
    }

    .nav-link[aria-current="page"] {
      font-weight: 700;
      text-decoration-thickness: 3px;
    }

    .menu-extra {
      display: none;
    }
  }
</style>

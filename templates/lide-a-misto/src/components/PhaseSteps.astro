---
/**
 * The guide: the place picker rows, a tally line per picked place, then one block per phase (the
 * phase as small caps in the label column, the steps on the right with green numerals counted
 * across the page). Picking a row filters the steps with core's :has(:target) mechanism (no
 * JavaScript); phases with nothing left hide too.
 */
import type { CollectionEntry } from "astro:content";
import {
  SITUATION_ANCHOR,
  SPECIFIC_SITUATIONS,
  chooserSituations,
  showsFor,
  type SpecificSituation,
} from "@core/content/guidance-flow.ts";
import { GUIDANCE_PHASES } from "@core/content/schemas.ts";
import type { SiteContext } from "@core/content/view-models.ts";
import DeathPlacePicker from "./DeathPlacePicker.astro";
import StepBlock from "./StepBlock.astro";
import { guidancePhaseLabels, situationWords, ui } from "../i18n/cs.ts";

interface Props {
  site: SiteContext;
  guidance: CollectionEntry<"guidance">[];
}

const { site, guidance } = Astro.props;
const ALL_ANCHOR = "postup";
const situations = chooserSituations(guidance);

let counter = 0;
const phases = GUIDANCE_PHASES.map((phase) => {
  const steps = guidance
    .filter((entry) => entry.data.phase === phase)
    .map((entry) => {
      counter += 1;
      return { entry, numeral: counter };
    });
  const shownFor = SPECIFIC_SITUATIONS.filter((situation) => steps.some((step) => showsFor(step.entry, situation)));
  return { phase, steps, shownFor };
}).filter((group) => group.steps.length > 0);

/* Filter rules, one block per offered situation (the selectors depend on the anchors). */
const filterCss = situations
  .map((situation: SpecificSituation) => {
    const target = `[data-guide]:has(#${SITUATION_ANCHOR[situation]}:target)`;
    return [
      `${target} [data-guide-step]:not([data-situations~="any"]):not([data-situations~="${situation}"]) { display: none; }`,
      `${target} [data-guide-phase]:not([data-shown-for~="${situation}"]) { display: none; }`,
      `${target} [data-tally="${situation}"] { display: block; }`,
      `${target} [data-tally="none"] { display: none; }`,
      `${target} [data-place="${situation}"] { background: var(--green); color: var(--on-green); }`,
      `${target} [data-place="${situation}"] .picker-word { text-decoration: none; }`,
      `${target} [data-place="${situation}"] .pick-mark { display: inline; }`,
      `${target} [data-place="${situation}"]:focus-visible { outline-color: var(--on-green); outline-offset: -6px; }`,
    ].join("\n");
  })
  .join("\n");
---
<div data-guide class="guide">
  <style is:inline set:html={filterCss}></style>
  {situations.map((situation) => <span id={SITUATION_ANCHOR[situation]} class="guide-target"></span>)}
  <span id={ALL_ANCHOR} class="guide-target"></span>
  {
    situations.length > 0 ? (
      <div class="frame guide-pick">
        <DeathPlacePicker situations={situations} />
        <p class="tally" data-tally="none">{ui.pickHint}</p>
        {situations.map((situation) => (
          <p class="tally" data-tally={situation}>
            {ui.tally(situationWords[situation])}{" "}
            <a href={`#${ALL_ANCHOR}`} class="go">{ui.showAll}</a>
          </p>
        ))}
      </div>
    ) : null
  }
  {
    phases.map((group) => (
      <section
        class="frame split guide-phase"
        aria-labelledby={`faze-${group.phase}`}
        data-guide-phase
        data-shown-for={group.shownFor.join(" ")}
      >
        <h2 id={`faze-${group.phase}`} class="caps">{guidancePhaseLabels[group.phase]}</h2>
        <ol class="steps" role="list">
          {group.steps.map((step) => (
            <StepBlock site={site} entry={step.entry} numeral={step.numeral} />
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .guide-target {
    display: block;
    scroll-margin-top: 1rem;
  }

  .guide-pick {
    margin-top: 2.25rem;
  }

  .tally {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 1.0625rem;
  }

  .tally:not([data-tally="none"]) {
    display: none;
  }

  .tally a {
    color: var(--ink);
  }

  .guide-phase {
    margin-top: 2.25rem;
  }

  .steps {
    display: grid;
    gap: 1.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 64rem) {
    .guide-pick {
      margin-top: 4rem;
    }

    .guide-phase {
      margin-top: 3.5rem;
    }

    .steps {
      gap: 2rem;
      max-width: 45rem;
    }
  }
</style>

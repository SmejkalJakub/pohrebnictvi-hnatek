---
/** Pohřeb předem (only while features.prePlanning is on): the opening, then the body as ruled prose. */
import { getOptionalPage, getSiteContext } from "@core/content/load.ts";
import EssayLayout from "../../layouts/EssayLayout.astro";
import PageOpening from "../../components/PageOpening.astro";
import RuledProse from "../../components/RuledProse.astro";
import { seoDescription, seoTitle } from "../../lib/site.ts";

export async function getStaticPaths() {
  const site = await getSiteContext();
  const page = await getOptionalPage("pohreb-predem");
  if (!site.config.features.prePlanning || page === null) {
    return [];
  }
  return [{ params: { path: undefined } }];
}

const site = await getSiteContext();
const page = await getOptionalPage("pohreb-predem");
if (page === null) {
  throw new Error("unreachable: page missing");
}
const Body = page.Content;
---
<EssayLayout site={site} title={seoTitle(page.data)} description={seoDescription(page.data)}>
  <PageOpening title={page.data.title} lead={page.data.lead} placeholder={page.data.placeholder} emergency={site.emergency} />
  {page.hasBody ? <RuledProse id="pohreb-predem-text"><Body /></RuledProse> : null}
</EssayLayout>

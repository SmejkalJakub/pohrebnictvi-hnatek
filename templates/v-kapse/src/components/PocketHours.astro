---
/**
 * Office hours as a hairline table under their own heading (data-office-hours, never shared with
 * the nonstop line), then the holiday and outside-hours notes and any exceptions.
 */
import type { SiteContext } from "@core/content/view-models.ts";
import { formatCzechDate } from "@core/format/date.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  site: SiteContext;
  id: string;
  level?: 2 | 3;
  /** False when the surrounding panel (itself marked data-office-hours) carries the heading. */
  withHeading?: boolean;
}

const { site, id, level = 3, withHeading = true } = Astro.props;
const Heading = `h${level}` as "h2" | "h3";
const hours = site.officeHours;
---
<div class="hours" data-office-hours={withHeading ? "" : undefined}>
  {withHeading ? <Heading id={id} class="hours-heading">{ui.hoursHeading}</Heading> : null}
  <table class="hairlines hours-table">
    <caption class="visually-hidden">{ui.hoursHeading}</caption>
    <tbody>
      {
        site.officeHoursRows.map((row) => (
          <tr>
            <th scope="row">
              <abbr title={row.daysLong}>{row.days}</abbr>
            </th>
            <td class="num">
              {row.text}
              {row.note !== null ? <span class="hours-note">{row.note}</span> : null}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
  {hours.holidayNote !== null ? <p class="muted hours-after">{hours.holidayNote}</p> : null}
  {hours.outsideHoursNote !== null ? <p class="muted hours-after">{hours.outsideHoursNote}</p> : null}
  {
    hours.exceptions.length > 0 ? (
      <div class="hours-after">
        <p>{ui.exceptionsHeading}</p>
        <ul class="dot-list muted">
          {hours.exceptions.map((exception) => (
            <li>
              {formatCzechDate(exception.from)}–{formatCzechDate(exception.to)}
              {exception.note !== null ? ` · ${exception.note}` : ""}
            </li>
          ))}
        </ul>
      </div>
    ) : null
  }
</div>

<style>
  .hours-heading {
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .hours-table {
    margin-top: 0.75rem;
  }

  .hours-table abbr {
    text-decoration: none;
  }

  .hours-note {
    display: block;
    color: var(--muted);
    font-weight: 400;
  }

  .hours-after {
    margin-top: 0.75rem;
  }
</style>

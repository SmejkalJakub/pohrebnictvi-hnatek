---
/**
 * A real photo as a press photo (design-differentiation §1.4, F): square corners, shown whole,
 * never wider than the file (no upscaling, the office photo is 722 px), lazy-loaded. An optional
 * italic caption under a hairline. Optionally the whole photo is a link (the catalogue pictures).
 */
import { Image } from "astro:assets";
import type { ImageRef } from "@core/content/schemas.ts";
import { resolveImage } from "@core/media/resolve.ts";

interface Props {
  image: ImageRef;
  caption?: string | null;
  href?: string | null;
  /** Largest display width in CSS px; the file width caps it further. */
  maxWidth?: number;
  class?: string;
}

const { image, caption = null, href = null, maxWidth = 560, class: className } = Astro.props;
const photo = resolveImage(image);
const fileWidth = photo.src.width;
const displayWidth = Math.min(maxWidth, fileWidth);
const widths = [280, 360, 480, 560, 722, 960].filter((width) => width <= fileWidth);
if (!widths.includes(fileWidth) && fileWidth < 960) {
  widths.push(fileWidth);
}
const sizes = `(min-width: 48rem) ${displayWidth}px, calc(100vw - 4rem)`;
const Wrapper = href === null ? "div" : "a";
---
<figure class:list={["stop-photo", className]} style={`--photo-max: ${displayWidth}px`} data-home-photo>
  <Wrapper class="stop-photo-frame" href={href ?? undefined}>
    <Image
      src={photo.src}
      alt={photo.alt}
      widths={widths}
      sizes={sizes}
      loading="lazy"
      decoding="async"
      class="stop-photo-img"
    />
  </Wrapper>
  {caption !== null ? <figcaption class="stop-photo-caption">{caption}</figcaption> : null}
</figure>

<style>
  .stop-photo {
    max-width: var(--photo-max);
    margin: 0;
  }

  .stop-photo-frame {
    display: block;
  }

  .stop-photo-img {
    display: block;
    width: 100%;
    height: auto;
    background: var(--photo);
  }

  a.stop-photo-frame {
    transition: opacity 160ms ease;
  }

  a.stop-photo-frame:hover {
    opacity: 0.88;
  }

  a.stop-photo-frame:focus-visible {
    outline: 3px solid var(--primary);
    outline-offset: 3px;
  }

  .stop-photo-caption {
    margin-top: 0.5rem;
    padding-top: 0.375rem;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.9375rem;
    font-style: italic;
    line-height: 1.45;
  }
</style>

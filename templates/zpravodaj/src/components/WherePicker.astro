---
/**
 * "Kde blízký člověk zemřel? doma · v nemocnici · …": the situation picker as a sentence of
 * words, each a ≥ 44 px target linking to the filtered guide (/jak-postupovat/#situace-…, CSS
 * :has(:target), no JavaScript). On the guide the picked word gets a thick underline in the primary and
 * says "(vybráno)" (rules in GuideArticle's filter CSS) and the words carry data-vt-anchor, so
 * core animates the filter as a view transition. On the home's first stop it is one running
 * sentence ("Zemřel jinde? v nemocnici · v domově pro seniory").
 */
import { SITUATION_ANCHOR, type SpecificSituation } from "@core/content/guidance-flow.ts";
import { situationWords, ui } from "../i18n/cs.ts";

interface Props {
  situations: SpecificSituation[];
  /** "" on the guide itself, "/jak-postupovat/" elsewhere. */
  base: string;
  questionId: string;
  /** Home: one running sentence with middle dots; guide: the question on its own line. */
  inline?: boolean;
  question?: string;
}

const { situations, base, questionId, inline = false, question = ui.pickerQuestion } = Astro.props;
const onGuide = base === "";
---
<div class="pick" data-inline={inline ? "true" : "false"}>
  <p id={questionId} class="pick-question">{question}</p>
  <ul class="pick-words" role="list" aria-labelledby={questionId}>
    {
      situations.map((situation, index) => (
        <li>
          <a
            href={`${base}#${SITUATION_ANCHOR[situation]}`}
            class="pick-word"
            data-place={situation}
            data-vt-anchor={onGuide ? "" : undefined}
          >
            <span>{situationWords[situation]}</span>
            <span class="pick-mark"> {ui.picked}</span>
          </a>
          {inline && index < situations.length - 1 ? <span class="pick-sep" aria-hidden="true">·</span> : null}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .pick {
    font-size: 1.125rem;
    line-height: 1.5;
  }

  .pick[data-inline="true"] {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.375rem;
    align-items: baseline;
  }

  .pick-question {
    padding-block: 0.625rem;
  }

  .pick[data-inline="false"] .pick-question {
    padding-bottom: 0;
  }

  .pick-words {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pick[data-inline="true"] .pick-words {
    column-gap: 0.375rem;
  }

  .pick-sep {
    margin-left: 0.375rem;
  }

  .pick-word {
    display: inline-block;
    padding-block: 0.625rem;
    text-underline-offset: 0.25em;
    transition:
      color 160ms ease,
      text-decoration-thickness 160ms ease,
      text-underline-offset 160ms ease,
      border-color 160ms ease;
  }

  .pick-word:hover {
    color: var(--ink);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }

  .pick-question {
    transition: color 200ms ease;
  }

  .pick-mark {
    display: none;
  }
</style>

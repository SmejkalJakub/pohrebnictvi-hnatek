---
/**
 * Časté otázky (#caste-otazky): one newsletter section under a rule in ink, the topics on the article measure,
 * each question a <details> with its Markdown answer, separated by hairlines.
 */
import type { CollectionEntry } from "astro:content";
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import { render } from "@core/content/load.ts";
import type { FaqGroup } from "@core/content/view-models.ts";
import ColumnSection from "./ColumnSection.astro";
import { ui } from "../i18n/cs.ts";

interface Props {
  groups: FaqGroup<CollectionEntry<"faq">>[];
}

const { groups } = Astro.props;
const answers = new Map<string, Awaited<ReturnType<typeof render>>["Content"]>();
for (const group of groups) {
  for (const entry of group.entries) {
    answers.set(entry.id, (await render(entry)).Content);
  }
}
---
<ColumnSection id="caste-otazky" heading={ui.faqHeading}>
  {
    groups.map((group) => (
      <div class="topic">
        <h3 class="topic-title">{group.label}</h3>
        <ul class="questions">
          {group.entries.map((entry) => {
            const Answer = answers.get(entry.id);
            return (
              <li>
                <PlaceholderMark active={entry.data.placeholder} as="div">
                  <details class="question">
                    <summary>{entry.data.question}</summary>
                    <div class="prose answer">{Answer !== undefined ? <Answer /> : null}</div>
                  </details>
                </PlaceholderMark>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</ColumnSection>

<style>
  .topic + .topic {
    margin-top: 2rem;
  }

  .topic-title {
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .questions {
    margin-top: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .questions > li {
    border-top: 1px solid var(--rule);
  }

  .questions > li:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .question summary {
    padding-block: 0.625rem;
    min-height: 2.75rem;
  }

  .answer {
    padding-bottom: 1rem;
  }
</style>

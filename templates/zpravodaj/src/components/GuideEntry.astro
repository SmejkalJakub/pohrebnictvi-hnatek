---
/**
 * One step of the guide (Jak postupovat) as a short newspaper article: "Krok n" as the kicker
 * (its number is a CSS counter over the steps shown, so it stays right under the place filter;
 * orientation, not a count of what is left), the title, when it applies (only for steps tied to
 * a place) in italic, the summary, the guided list ("Postupně": plain numbered sentences, never
 * tick boxes: design-differentiation §1.3), the body in <details>, the contact prompt and
 * "Potom: …" to the step that follows.
 * "Potom" links carry the full path (/jak-postupovat/#…) and data-guide-next, so with JavaScript
 * core moves to the next step without clearing the place filter and marks it data-guide-arrived;
 * without JavaScript it is a plain link (:target). Either way the arrived step gets a rule in the
 * primary along its top that fades in (≤ 200 ms, off under reduced motion).
 */
import type { CollectionEntry } from "astro:content";
import EmergencyPhoneLink from "@core/components/EmergencyPhoneLink.astro";
import PhoneLink from "@core/components/PhoneLink.astro";
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import UnreviewedMark from "@core/components/UnreviewedMark.astro";
import { render } from "@core/content/load.ts";
import { guideSentence, situationsAttribute, type SpecificSituation } from "@core/content/guidance-flow.ts";
import type { SiteContext } from "@core/content/view-models.ts";
import { formatPhone } from "@core/format/phone.ts";
import { primaryOfficePhone } from "../lib/site.ts";
import { situationWords, ui } from "../i18n/cs.ts";

interface Props {
  site: SiteContext;
  entry: CollectionEntry<"guidance">;
  /** The step that follows (nextGuidanceStep), or null for the last one. */
  next: CollectionEntry<"guidance"> | null;
  /** Path of the guide page, for the full-path "Potom" links. */
  base: string;
}

const { site, entry, next, base } = Astro.props;
const data = entry.data;
const office = primaryOfficePhone(site);
const named = data.situations.filter((situation) => situation !== "any") as SpecificSituation[];
let applies: string | null = null;
if (named.length > 0) {
  applies = `${ui.appliesWhen} ${named.map((situation) => situationWords[situation]).join(", ")}`;
}
const { Content } = await render(entry);
const hasBody = (entry.body ?? "").trim() !== "";
const listLabelId = `${entry.id}-postup`;
---
<article
  id={entry.id}
  class="guide-entry"
  data-guide-step
  data-situations={situationsAttribute(entry)}
  aria-labelledby={`${entry.id}-nadpis`}
>
  <p class="kicker">{ui.stepWord} <span class="entry-count"></span></p>
  <h3 id={`${entry.id}-nadpis`} class="headline entry-title">{data.title}</h3>
  {applies !== null ? <p class="entry-when">{applies}</p> : null}
  <PlaceholderMark active={data.placeholder} as="div">
    <p class="entry-text">{data.summary}</p>
    <UnreviewedMark reviewedAt={data.review.reviewedAt} />
  </PlaceholderMark>
  {
    data.checklist.length > 0 ? (
      <div class="entry-guide">
        <p id={listLabelId} class="stop-list-label">{ui.guideListLabel}</p>
        <ol class="stop-list" aria-labelledby={listLabelId}>
          {data.checklist.map((item) => (
            <li>{guideSentence(item)}</li>
          ))}
        </ol>
      </div>
    ) : null
  }
  {
    hasBody ? (
      <details class="more">
        <summary>{ui.readMore}</summary>
        <div class="prose entry-body">
          <Content />
        </div>
      </details>
    ) : null
  }
  {
    data.contactPrompt === "emergency" && site.emergency.enabled ? (
      <p class="entry-call">
        <EmergencyPhoneLink emergency={site.emergency} variant="custom" class="entry-call-link">
          {site.emergency.label}{" "}<span class="nowrap">{formatPhone(site.emergency.phone).display}</span>
        </EmergencyPhoneLink>
      </p>
    ) : null
  }
  {
    data.contactPrompt === "office" ? (
      <p class="entry-call">
        {ui.officePrompt}:{" "}
        <PhoneLink number={office.number}>
          {office.label}{" "}<span class="nowrap">{formatPhone(office.number).display}</span>
        </PhoneLink>
      </p>
    ) : null
  }
  {
    next !== null ? (
      <p class="entry-next">
        <a href={`${base}#${next.id}`} data-guide-next>{ui.nextStep(next.data.title)}</a>
      </p>
    ) : null
  }
</article>

<style>
  .guide-entry {
    position: relative;
    padding-top: 1rem;
    counter-increment: guide-step;
    scroll-margin-top: var(--scroll-offset);
    /* Named only so the guide's same-document view transition can slide the steps that stay. */
    view-transition-name: match-element;
    view-transition-class: guide-step;
  }

  /* Arrival through "Potom": a rule in the primary along the top (nothing moves). */
  .guide-entry::before {
    content: "";
    position: absolute;
    top: -1px;
    right: 0;
    left: 0;
    height: 3px;
    background: var(--primary-fill);
    opacity: 0;
  }

  .guide-entry:target::before,
  .guide-entry[data-guide-arrived]::before {
    opacity: 1;
  }

  /* Core focuses the arrived step (tabindex="-1"); the rule marks it, so no ring around it. */
  .guide-entry:focus-visible,
  .guide-entry:focus {
    outline: none;
  }

  .entry-count::before {
    content: counter(guide-step);
  }

  .guide-entry > * + * {
    margin-top: 0.625rem;
  }

  .guide-entry > .kicker + * {
    margin-top: 0.25rem;
  }

  .entry-title {
    font-size: var(--h3);
    line-height: 1.15;
  }

  .entry-title + .entry-when {
    margin-top: 0.25rem;
  }

  .entry-when {
    color: var(--muted);
    font-size: 1rem;
    font-style: italic;
  }

  .entry-guide {
    font-size: 1rem;
  }

  .entry-body {
    margin-top: 0.25rem;
  }

  .entry-call :global(.entry-call-link) {
    display: inline-block;
    padding-block: 0.625rem;
    font-weight: 600;
  }

  .entry-next a {
    display: inline-block;
    padding-block: 0.625rem;
    font-size: 1rem;
    font-style: italic;
  }

  @media (prefers-reduced-motion: no-preference) {
    .guide-entry::before {
      transition: opacity 200ms ease;
    }
  }
</style>

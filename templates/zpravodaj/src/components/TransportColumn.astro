---
/**
 * Převoz zesnulých on Kontakt: its own heading and emergency block (data-emergency-block), the
 * service note and area, and the nonstop link in ink. Office hours never share it.
 */
import EmergencyPhoneLink from "@core/components/EmergencyPhoneLink.astro";
import type { EmergencyTransport } from "@core/content/schemas.ts";
import { formatPhone } from "@core/format/phone.ts";
import ColumnSection from "./ColumnSection.astro";
import { ui } from "../i18n/cs.ts";

interface Props {
  emergency: EmergencyTransport;
}

const { emergency } = Astro.props;
---
{
  emergency.enabled ? (
    <ColumnSection id="prevoz" heading={ui.transportHeading} data-emergency-block>
      {emergency.shortNote !== null ? <p>{emergency.shortNote}</p> : null}
      {emergency.serviceArea !== null ? <p>{emergency.serviceArea}</p> : null}
      <p>
        <EmergencyPhoneLink emergency={emergency} variant="custom" class="transport-link">
          {emergency.label}{" "}<span class="nowrap">{formatPhone(emergency.phone).display}</span>
        </EmergencyPhoneLink>
      </p>
    </ColumnSection>
  ) : null
}

<style>
  :global(.transport-link) {
    display: inline-block;
    padding-block: 0.625rem;
    color: var(--ink);
    font-weight: 600;
  }
</style>

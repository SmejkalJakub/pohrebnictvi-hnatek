---
/**
 * The colophon, every page (F): a double rule, then the newsletter's imprint on the ground (never
 * a dark footer). Columns: Kancelář (address, map, office and flower phones, e-mail) · Úřední
 * hodiny (their own section with [data-office-hours], never beside the nonstop line: contract §6)
 * · Na webu (documents and legal links). Then one "Vydává …" line: the legal name, sídlo, IČO, the
 * register entry and the ADR body (research L8, L10), with the brand mark as a quiet signature,
 * and below it the nonstop line once more in its own block.
 * Neutral form (notice pages): no nonstop line, no documents and no mark; office, hours and the
 * imprint stay. `officeOnPage` (home with contact-summary): the Kancelář and hours columns go.
 */
import { Image } from "astro:assets";
import { brandMark } from "@core/brand/runtime.ts";
import EmergencyPhoneLink from "@core/components/EmergencyPhoneLink.astro";
import MissingFact from "@core/components/MissingFact.astro";
import PhoneLink from "@core/components/PhoneLink.astro";
import type { DocumentView, SiteContext } from "@core/content/view-models.ts";
import { formatAddressInline, formatAddressLines } from "@core/format/address.ts";
import { formatPhone } from "@core/format/phone.ts";
import { flowerPhones, mainLocation, mapHref, officePhones } from "../lib/site.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  site: SiteContext;
  neutral: boolean;
  documents: DocumentView[];
  hasPrivacyPage: boolean;
  officeOnPage?: boolean;
}

const { site, neutral, documents, hasPrivacyPage, officeOnPage = false } = Astro.props;
const showOffice = neutral || !officeOnPage;
let mark = null;
if (!neutral) {
  mark = brandMark();
}
const location = mainLocation(site);
const [street, cityLine] = formatAddressLines(location.address);
const map = mapHref(location);
/* Notice pages list the office only: no flower orders next to a notice (research L1). */
let phones = [...officePhones(site), ...flowerPhones(site)];
if (neutral) {
  phones = officePhones(site);
}
const emails = site.contact.emails;
const ids = site.company.legalIds;
const showEmergency = !neutral && site.emergency.enabled;
const emergencyDisplay = formatPhone(site.emergency.phone).display;
let emergencyNote: string = ui.emergencyAlways;
if (site.emergency.shortNote !== null) {
  emergencyNote = site.emergency.shortNote;
}
const showDocuments = !neutral && documents.length > 0;
const showLinks = showDocuments || site.legalLink !== null || hasPrivacyPage;
const showColumns = showOffice || showLinks;
---
<footer class="colophon" data-neutral={neutral ? "true" : "false"}>
  {showColumns ? (
  <div class="colophon-columns">
    {
      showOffice ? (
        <section class="colophon-col" aria-labelledby="tiraz-kancelar">
          <h2 id="tiraz-kancelar" class="colophon-heading">{ui.officeHeading}</h2>
          <p>
            {street}
            <br />
            {cityLine}
          </p>
          {map !== null ? (
            <p>
              <a href={map} class="go">{ui.mapLink}</a>
            </p>
          ) : null}
          <ul class="colophon-list" role="list">
            {phones.map((phone) => (
              <li>
                <PhoneLink number={phone.number}>
                  {phone.label}{" "}<span class="nowrap">{formatPhone(phone.number).display}</span>
                </PhoneLink>
              </li>
            ))}
            {emails.map((email) => (
              <li>
                <a href={`mailto:${email.address}`} class="go">{email.address}</a>
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }
    {
      showOffice ? (
        <section class="colophon-col" aria-labelledby="tiraz-hodiny">
          <h2 id="tiraz-hodiny" class="colophon-heading">{ui.officeHoursHeading}</h2>
          <div data-office-hours>
            <ul class="colophon-list" role="list">
              {site.officeHoursRows.map((row) => (
                <li>
                  <abbr title={row.daysLong}>{row.days}</abbr> <span class="nowrap">{row.text}</span>
                  {row.note !== null ? <span class="colophon-quiet">, {row.note}</span> : null}
                </li>
              ))}
            </ul>
          </div>
        </section>
      ) : null
    }
    {
      showLinks ? (
        <section class="colophon-col" aria-labelledby="tiraz-web">
          <h2 id="tiraz-web" class="colophon-heading">{ui.onWebHeading}</h2>
          <ul class="colophon-list" role="list">
            {showDocuments
              ? documents.map((document) => (
                  <li>
                    <a href={document.href} class="go">{document.title}</a> ({ui.pdf})
                  </li>
                ))
              : null}
            {site.legalLink !== null ? (
              <li>
                <a href={site.legalLink.href} class="go">{site.legalLink.label}</a>
              </li>
            ) : null}
            {hasPrivacyPage ? (
              <li>
                <a href="/ochrana-osobnich-udaju/" class="go">{ui.privacy}</a>
              </li>
            ) : null}
          </ul>
        </section>
      ) : null
    }
  </div>
  ) : null}
  <div class="colophon-imprint">
    {mark !== null ? <Image src={mark} alt="" width={36} densities={[1, 2]} class="colophon-mark" /> : null}
    <p class="colophon-legal" data-legal-identification>
      {ui.publishedBy}{" "}
      {site.company.legalName}
      {", "}
      {ids.registeredOffice !== null ? formatAddressInline(ids.registeredOffice) : <MissingFact name="sídlo společnosti" />}
      {", "}
      {ui.ico}{" "}
      {ids.ico !== null ? <span class="nowrap">{ids.ico}</span> : <MissingFact name="IČO" />}
      {". "}
      {ids.registryEntry !== null ? ids.registryEntry : <MissingFact name="zápis v obchodním rejstříku" />}
      {". "}
      {
        site.legal !== null ? (
          <>
            {ui.adrFooter} {site.legal.adr.name},{" "}
            <a href={site.legal.adr.url} class="go">{site.legal.adr.url.replace(/^https?:\/\//, "")}</a>
          </>
        ) : null
      }
    </p>
  </div>
  {
    showEmergency ? (
      <div class="colophon-nonstop" data-emergency-block>
        <h2 class="visually-hidden">{site.emergency.label}</h2>
        <p>
          <EmergencyPhoneLink emergency={site.emergency} variant="custom" class="colophon-nonstop-link">
            {site.emergency.label}{" "}<span class="colophon-number nowrap">{emergencyDisplay}</span>
          </EmergencyPhoneLink>
          <span class="colophon-quiet"> · {emergencyNote}</span>
        </p>
      </div>
    ) : null
  }
</footer>

<style>
  .colophon {
    width: 100%;
    max-width: calc(var(--page) + 2 * var(--gutter));
    margin-inline: auto;
    padding: 0 var(--gutter) 2rem;
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.55;
  }

  .colophon-columns {
    display: grid;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 3px double var(--rule-strong);
  }

  .colophon-heading {
    color: var(--kicker);
    font-family: var(--serif);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .colophon-heading + * {
    margin-top: 0.375rem;
  }

  .colophon-col > * + * {
    margin-top: 0.25rem;
  }

  .colophon-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .colophon-quiet {
    color: var(--muted);
  }

  .colophon-imprint {
    display: flex;
    gap: 0.875rem;
    align-items: flex-start;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule-strong);
  }

  .colophon-imprint:first-child {
    margin-top: 0;
    border-top: 3px double var(--rule-strong);
  }

  .colophon-imprint :global(.colophon-mark) {
    flex: none;
    width: 1.75rem;
    height: auto;
    margin-top: 0.25rem;
  }

  .colophon-legal {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .colophon-nonstop {
    margin-top: 0.75rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--rule);
    font-size: 0.9375rem;
  }

  .colophon-nonstop :global(.colophon-nonstop-link) {
    display: inline-block;
    padding-block: 0.625rem;
    color: var(--ink);
    text-decoration: none;
  }

  .colophon-number {
    color: var(--primary);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .colophon-nonstop :global(.colophon-nonstop-link):hover .colophon-number {
    text-decoration-thickness: 2px;
  }

  @media (min-width: 48rem) {
    .colophon-columns {
      grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
      column-gap: 0;
    }

    .colophon-col + .colophon-col {
      padding-left: 1.75rem;
      border-left: 1px solid var(--rule);
    }

    .colophon-col {
      padding-right: 1.75rem;
    }
  }
</style>

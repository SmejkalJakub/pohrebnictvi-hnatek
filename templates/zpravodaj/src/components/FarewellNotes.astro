---
/**
 * Home `services` (F): "Jak se můžete rozloučit", the featured ceremonies (at most three, not the
 * transport) as short notes side by side between column rules: the title linking to its article
 * on /sluzby/, then the summary; then "Všechny služby". Phones: the notes one under another on
 * hairlines.
 */
import type { CollectionEntry } from "astro:content";
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import { serviceHref } from "@core/content/view-models.ts";
import { nbsp } from "../lib/site.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  services: CollectionEntry<"services">[];
}

const { services } = Astro.props;
---
<section id="rozlouceni" class="farewell" data-section="services" aria-labelledby="rozlouceni-nadpis">
  <h2 id="rozlouceni-nadpis" class="headline farewell-heading">{ui.farewellHeading}</h2>
  <ul class="farewell-notes" role="list">
    {
      services.map((service) => (
        <li>
          <h3 class="farewell-title">
            <a href={serviceHref(service.id, false)}>{service.data.title}</a>
          </h3>
          <PlaceholderMark active={service.data.placeholder} as="div">
            <p class="farewell-text">{nbsp(service.data.summary)}</p>
          </PlaceholderMark>
        </li>
      ))
    }
  </ul>
  <p class="farewell-more">
    <a href="/sluzby/" class="go">{ui.allServices}</a>
  </p>
</section>

<style>
  .farewell-heading {
    font-size: var(--h2);
  }

  .farewell-notes {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .farewell-notes > li {
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--rule-soft);
  }

  .farewell-title {
    font-size: 1.125rem;
    line-height: 1.3;
  }

  .farewell-title a {
    color: var(--ink);
    text-decoration-color: var(--rule);
  }

  .farewell-title a:hover {
    color: var(--primary);
    text-decoration-color: currentColor;
  }

  .farewell-text {
    margin-top: 0.25rem;
    font-size: 1rem;
  }

  .farewell-more {
    font-size: 1rem;
  }

  @media (min-width: 48rem) {
    .farewell-notes {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    }

    .farewell-notes > li {
      padding: 0.25rem 1.5rem 0.75rem;
      border-bottom: 0;
      border-left: 1px solid var(--rule);
    }

    .farewell-notes > li:first-child {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>

---
/**
 * Služby as one newsletter page with anchors (no detail pages), F: first "V tomto přehledu", every
 * service as a link in ruled columns (an in-page contents list); then one section per featured
 * service (`id` = the service id, so /sluzby/#<id> lands on it): the summary as the italic
 * standfirst, the body, and in the side column the inclusion lists of its price group and the
 * "Co je v ceně" link; then one "Další služby" section holding the other services under their own
 * anchors. No prices on this page.
 */
import type { CollectionEntry } from "astro:content";
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import { render } from "@core/content/load.ts";
import type { PricingView } from "@core/content/view-models.ts";
import ColumnSection from "./ColumnSection.astro";
import InclusionBriefs from "./InclusionBriefs.astro";
import { priceGroupFor } from "../lib/site.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  services: CollectionEntry<"services">[];
  pricing: PricingView | null;
}

const { services, pricing } = Astro.props;
let featured = services.filter((service) => service.data.featured);
if (featured.length === 0) {
  featured = services.slice(0, 1);
}
const others = services.filter((service) => !featured.includes(service));

const items = [];
for (const service of services) {
  const { Content } = await render(service);
  const group = priceGroupFor(pricing, service.data.priceGroupId);
  items.push({
    service,
    Content,
    hasBody: (service.body ?? "").trim() !== "",
    group,
  });
}
const byId = new Map(items.map((item) => [item.service.id, item]));
const ordered = [...featured, ...others];
---
<nav class="service-index" aria-labelledby="sluzby-prehled">
  <h2 id="sluzby-prehled" class="list-label">{ui.contentsHeading}</h2>
  <ol class="service-index-list" role="list">
    {
      ordered.map((service) => (
        <li>
          <a href={`#${service.id}`} class="service-index-link">{service.data.title}</a>
        </li>
      ))
    }
  </ol>
</nav>
{
  featured.map((service) => {
    const item = byId.get(service.id);
    if (item === undefined) {
      return null;
    }
    const Body = item.Content;
    return (
      <>
        <ColumnSection id={service.id} heading={service.data.title}>
          <PlaceholderMark active={service.data.placeholder} as="div">
            <p class="standfirst">{service.data.summary}</p>
            {item.hasBody ? (
              <div class="prose">
                <Body />
              </div>
            ) : null}
          </PlaceholderMark>
          {item.group !== null ? (
            <div slot="aside">
              <InclusionBriefs includes={item.group.includes} excludes={item.group.excludes} />
              <p class="sans">
                <a href={`/cenik/#${item.group.id}`} class="go">{ui.includesLink}</a>
              </p>
            </div>
          ) : null}
        </ColumnSection>
      </>
    );
  })
}
{
  others.length > 0 ? (
    <ColumnSection id="dalsi-sluzby" heading={ui.moreServices}>
      {others.map((service) => {
        const item = byId.get(service.id);
        if (item === undefined) {
          return null;
        }
        const Body = item.Content;
        return (
          <article id={service.id} class="other" aria-labelledby={`${service.id}-nadpis`}>
            <h3 id={`${service.id}-nadpis`} class="other-title">{service.data.title}</h3>
            <PlaceholderMark active={service.data.placeholder} as="div">
              <p>{service.data.summary}</p>
              {item.hasBody ? (
                <details class="more">
                  <summary>{ui.readMore}</summary>
                  <div class="prose">
                    <Body />
                  </div>
                </details>
              ) : null}
            </PlaceholderMark>
            {item.group !== null ? (
              <p class="sans">
                <a href={`/cenik/#${item.group.id}`} class="go">{ui.includesLink}</a>
              </p>
            ) : null}
          </article>
        );
      })}
    </ColumnSection>
  ) : null
}

<style>
  .service-index {
    width: 100%;
    max-width: calc(var(--page) + 2 * var(--gutter));
    margin-inline: auto;
    padding: 1.75rem var(--gutter) 0;
  }

  .service-index-list {
    margin: 0.375rem 0 0;
    padding: 0;
    border-top: 1px solid var(--rule-strong);
    list-style: none;
  }

  .service-index-list > li {
    border-bottom: 1px solid var(--rule-soft);
  }

  .service-index-link {
    display: block;
    padding-block: 0.5rem;
    font-family: var(--display);
    font-size: 1.125rem;
    font-weight: var(--display-weight);
  }

  @media (min-width: 48rem) {
    .service-index-list {
      column-count: 2;
      column-gap: 2.25rem;
      column-rule: 1px solid var(--rule);
    }

    .service-index-list > li {
      break-inside: avoid;
    }
  }

  @media (min-width: 64rem) {
    .service-index-list {
      column-count: 3;
    }
  }

  .other + .other {
    margin-top: 1.75rem;
  }

  .other-title {
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .other {
    scroll-margin-top: 1rem;
  }
</style>

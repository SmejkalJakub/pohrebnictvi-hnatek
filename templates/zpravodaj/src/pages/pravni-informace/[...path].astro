---
/**
 * Právní informace (research L10), built from Kontakt: passages Mimosoudní řešení sporů,
 * Reklamace and Dokumenty (#dokumenty), then the page body. Emitted only when the page
 * exists (the manifest declares pageFields["pravni-informace"]).
 */
import { getDocuments, getOptionalPage, getSiteContext } from "@core/content/load.ts";
import GazetteLayout from "../../layouts/GazetteLayout.astro";
import PageHeadline from "../../components/PageHeadline.astro";
import ColumnSection from "../../components/ColumnSection.astro";
import AdrImprint from "../../components/AdrImprint.astro";
import DocumentIndex from "../../components/DocumentIndex.astro";
import ProseColumns from "../../components/ProseColumns.astro";
import { seoDescription, seoTitle } from "../../lib/site.ts";
import { ui } from "../../i18n/cs.ts";

export async function getStaticPaths() {
  const page = await getOptionalPage("pravni-informace");
  if (page === null) {
    return [];
  }
  return [{ params: { path: undefined } }];
}

const site = await getSiteContext();
const page = await getOptionalPage("pravni-informace");
if (page === null) {
  throw new Error("unreachable: page missing");
}
const documents = await getDocuments();
const Body = page.Content;
---
<GazetteLayout site={site} title={seoTitle(page.data)} description={seoDescription(page.data)}>
  <PageHeadline title={page.data.title} lead={page.data.lead} placeholder={page.data.placeholder} />
  {site.legal !== null ? <AdrImprint legal={site.legal} /> : null}
  {
    documents.length > 0 ? (
      <ColumnSection id="dokumenty" heading={ui.documentsHeading}>
        <DocumentIndex documents={documents} />
      </ColumnSection>
    ) : null
  }
  {page.hasBody ? <ProseColumns idPrefix="pravni-text"><Body /></ProseColumns> : null}
</GazetteLayout>

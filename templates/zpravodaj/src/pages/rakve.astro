---
/** Rakve: the opening, the body, the coffins as a grid of whole photos; handles zero entries. */
import { getCoffins, getPage, getSiteContext } from "@core/content/load.ts";
import GazetteLayout from "../layouts/GazetteLayout.astro";
import PageHeadline from "../components/PageHeadline.astro";
import CataloguePlates from "../components/CataloguePlates.astro";
import ProseColumns from "../components/ProseColumns.astro";
import { seoDescription, seoTitle } from "../lib/site.ts";
import { ui } from "../i18n/cs.ts";

const site = await getSiteContext();
const page = await getPage("rakve");
const coffins = await getCoffins();
const items = coffins.map((entry) => {
  const parts: string[] = [];
  if (entry.data.material !== null) {
    parts.push(entry.data.material);
  }
  if (entry.data.code !== null) {
    parts.push(`${ui.code} ${entry.data.code}`);
  }
  let detail: string | null = null;
  if (parts.length > 0) {
    detail = parts.join(" · ");
  }
  return {
    id: entry.id,
    name: entry.data.name,
    detail,
    summary: entry.data.summary,
    image: entry.data.image,
    placeholder: entry.data.placeholder,
  };
});
const Body = page.Content;
---
<GazetteLayout site={site} title={seoTitle(page.data)} description={seoDescription(page.data)}>
  <PageHeadline title={page.data.title} lead={page.data.lead} placeholder={page.data.placeholder} />
  {page.hasBody ? <ProseColumns idPrefix="rakve-text"><Body /></ProseColumns> : null}
  <CataloguePlates site={site} items={items} />
</GazetteLayout>

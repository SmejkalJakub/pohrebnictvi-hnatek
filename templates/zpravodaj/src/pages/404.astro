---
/** 404: one sentence with two inline links (home, the guide), under the opening. */
import { getSiteContext } from "@core/content/load.ts";
import GazetteLayout from "../layouts/GazetteLayout.astro";
import PageHeadline from "../components/PageHeadline.astro";
import { ui } from "../i18n/cs.ts";

const site = await getSiteContext();
---
<GazetteLayout site={site} title={ui.notFoundTitle} description={ui.notFoundTitle} noindex>
  <PageHeadline title={ui.notFoundTitle} kicker={ui.notFoundKicker}>
    <p>
      {ui.notFoundBefore} <a href="/">{ui.notFoundHome}</a> {ui.notFoundOr}{" "}
      <a href="/jak-postupovat/">{ui.notFoundGuide}</a>.
    </p>
  </PageHeadline>
</GazetteLayout>

---
/**
 * O nás: the opening, the firm's own photo (heroImage, slot about.story) on the content column,
 * then the body as axis passages. The same photo stands at the home thread's "Sjednání" stop.
 */
import { getPage, getSiteContext } from "@core/content/load.ts";
import ThreadLayout from "../layouts/ThreadLayout.astro";
import ThreadOpening from "../components/ThreadOpening.astro";
import ProsePassages from "../components/ProsePassages.astro";
import StopPhoto from "../components/StopPhoto.astro";
import { seoDescription, seoTitle } from "../lib/site.ts";

const site = await getSiteContext();
const page = await getPage("o-nas");
const Body = page.Content;
---
<ThreadLayout site={site} title={seoTitle(page.data)} description={seoDescription(page.data)}>
  <ThreadOpening site={site} title={page.data.title} lead={page.data.lead} placeholder={page.data.placeholder} />
  {
    page.data.heroImage !== null ? (
      <div class="passage">
        <div class="passage-body">
          <StopPhoto image={page.data.heroImage} maxWidth={722} />
        </div>
      </div>
    ) : null
  }
  {
    page.hasBody ? (
      <ProsePassages idPrefix="o-nas-text">
        <Body />
      </ProsePassages>
    ) : null
  }
</ThreadLayout>

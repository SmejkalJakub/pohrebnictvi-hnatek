---
/**
 * Jak postupovat: the opening, the place picker as a sentence of words, the whole thread (every
 * step by phase, the guide's stops), then Časté otázky (#caste-otazky).
 */
import { getFaq, getGuidance, getPage, getSiteContext } from "@core/content/load.ts";
import ThreadLayout from "../layouts/ThreadLayout.astro";
import ThreadOpening from "../components/ThreadOpening.astro";
import GuideThread from "../components/GuideThread.astro";
import ProsePassages from "../components/ProsePassages.astro";
import QuestionsPassage from "../components/QuestionsPassage.astro";
import { seoDescription, seoTitle } from "../lib/site.ts";

const site = await getSiteContext();
const page = await getPage("jak-postupovat");
const guidance = await getGuidance();
const faq = await getFaq();
const Body = page.Content;
---
<ThreadLayout site={site} title={seoTitle(page.data)} description={seoDescription(page.data)}>
  <ThreadOpening site={site} title={page.data.title} lead={page.data.lead} placeholder={page.data.placeholder} />
  <GuideThread site={site} guidance={guidance} />
  {page.hasBody ? <ProsePassages idPrefix="postup-text"><Body /></ProsePassages> : null}
  {faq.length > 0 ? <QuestionsPassage groups={faq} /> : null}
</ThreadLayout>

---
/**
 * Právní informace (research L10), built from Kontakt: passages Mimosoudní řešení sporů,
 * Reklamace and Dokumenty (#dokumenty), then the page body. Emitted only when the page
 * exists (the manifest declares pageFields["pravni-informace"]).
 */
import { getDocuments, getOptionalPage, getSiteContext } from "@core/content/load.ts";
import ThreadLayout from "../../layouts/ThreadLayout.astro";
import ThreadOpening from "../../components/ThreadOpening.astro";
import AxisSection from "../../components/AxisSection.astro";
import AdrPassage from "../../components/AdrPassage.astro";
import DocumentLines from "../../components/DocumentLines.astro";
import ProsePassages from "../../components/ProsePassages.astro";
import { seoDescription, seoTitle } from "../../lib/site.ts";
import { ui } from "../../i18n/cs.ts";

export async function getStaticPaths() {
  const page = await getOptionalPage("pravni-informace");
  if (page === null) {
    return [];
  }
  return [{ params: { path: undefined } }];
}

const site = await getSiteContext();
const page = await getOptionalPage("pravni-informace");
if (page === null) {
  throw new Error("unreachable: page missing");
}
const documents = await getDocuments();
const Body = page.Content;
---
<ThreadLayout site={site} title={seoTitle(page.data)} description={seoDescription(page.data)}>
  <ThreadOpening site={site} title={page.data.title} lead={page.data.lead} placeholder={page.data.placeholder} />
  {site.legal !== null ? <AdrPassage legal={site.legal} /> : null}
  {
    documents.length > 0 ? (
      <AxisSection id="dokumenty" heading={ui.documentsHeading}>
        <DocumentLines documents={documents} />
      </AxisSection>
    ) : null
  }
  {page.hasBody ? <ProsePassages idPrefix="pravni-text"><Body /></ProsePassages> : null}
</ThreadLayout>

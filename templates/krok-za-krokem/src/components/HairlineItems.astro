---
/** Price items as a hairline table: label (and description) left, price right in the body serif at 600; the amount never wraps, a demo mark may drop under it. */
import PriceValue from "@core/components/PriceValue.astro";
import type { PriceItem } from "@core/content/schemas.ts";

interface Props {
  items: PriceItem[];
  caption: string;
}

const { items, caption } = Astro.props;
---
<table class="hairlines price-items">
  <caption class="visually-hidden">{caption}</caption>
  <tbody>
    {
      items.map((item) => (
        <tr>
          <th scope="row">
            {item.label}
            {item.description !== null ? <span class="item-desc">{item.description}</span> : null}
          </th>
          <td class="num">
            <PriceValue item={item} />
          </td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .price-items tr:last-child th,
  .price-items tr:last-child td {
    border-bottom: 1px solid var(--rule);
  }

  .item-desc {
    display: block;
    color: var(--muted);
    font-size: 1.125rem;
  }

  /* The cell may wrap (UKÁZKA under the amount at 320 px); the amount itself never does. */
  .price-items .num {
    white-space: normal;
  }

  .price-items :global([data-price-amount]) {
    white-space: nowrap;
  }
</style>

---
/**
 * The header (not sticky), E1: wordmark or logo on the left; from 64 rem the text navigation in
 * the middle and the nonstop line on the right (the label small, the number large, one link);
 * below 64 rem an outlined "Menu" button opens the list in the flow (the nonstop strip above the
 * header carries the number there). Without JS the list is shown in the flow and the button hides.
 * The button comes before the list in the DOM, so Tab after opening enters the menu; the grid
 * areas place it. Notice pages leave the nonstop line out (NoticePublisherLine carries it).
 */
import { Image } from "astro:assets";
import EmergencyPhoneLink from "@core/components/EmergencyPhoneLink.astro";
import type { SiteContext } from "@core/content/view-models.ts";
import { formatPhone } from "@core/format/phone.ts";
import { resolveOptionalImage } from "@core/media/resolve.ts";
import ThreadNav from "./ThreadNav.astro";
import type { ThreadLink } from "../lib/site.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  site: SiteContext;
  links: ThreadLink[];
  neutral: boolean;
}

const { site, links, neutral } = Astro.props;
const logo = resolveOptionalImage(site.company.logo);
const showNonstop = !neutral && site.emergency.enabled;
const emergencyDisplay = formatPhone(site.emergency.phone).display;
---
<header class="top" data-neutral={neutral ? "true" : "false"}>
  <a href="/" class="wordmark">
    {
      logo !== null ? (
        <Image src={logo.src} alt={site.company.brandName} height={48} densities={[1, 2]} class="logo" loading="eager" />
      ) : (
        site.company.brandName
      )
    }
  </a>
  <button type="button" class="menu-btn" aria-expanded="false" aria-controls="menu" data-menu-toggle>
    {ui.menuOpen}
  </button>
  <ThreadNav id="menu" links={links} />
  {
    showNonstop ? (
      <p class="top-nonstop">
        <EmergencyPhoneLink emergency={site.emergency} variant="custom" class="top-nonstop-link">
          <span class="top-nonstop-label">{site.emergency.label}</span>{" "}
          <span class="top-nonstop-number nowrap">{emergencyDisplay}</span>
        </EmergencyPhoneLink>
      </p>
    ) : null
  }
</header>

<style>
  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "mark menu"
      "nav nav";
    column-gap: 1rem;
    align-items: center;
    width: 100%;
    max-width: calc(var(--page) + 2 * var(--gutter));
    margin-inline: auto;
    padding: 0.75rem var(--gutter) 0;
  }

  .wordmark {
    grid-area: mark;
    justify-self: start;
    display: inline-block;
    padding-block: 0.5rem;
    color: var(--primary);
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: var(--display-weight);
    line-height: 1.25;
    text-decoration: none;
  }

  .top :global(.logo) {
    width: auto;
    height: 2.5rem;
  }

  .top > :global(nav) {
    grid-area: nav;
  }

  .top-nonstop {
    display: none;
  }

  /* An outlined word button (E1 phone board), 44 px tall. */
  .menu-btn {
    grid-area: menu;
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 1px solid var(--primary);
    border-radius: 0.25rem;
    background: transparent;
    color: var(--primary);
    font: 400 1.0625rem/1 var(--serif);
    cursor: pointer;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .menu-btn:hover,
  .menu-btn[aria-expanded="true"] {
    background: var(--primary-fill);
    color: var(--on-primary);
  }

  .menu-btn:active {
    opacity: 0.8;
  }

  :global(.no-js) .menu-btn {
    display: none;
  }

  @media (min-width: 64rem) {
    .top {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas: "mark nav nonstop";
      column-gap: 2.5rem;
      padding-top: 1.375rem;
      padding-bottom: 0.5rem;
    }

    .wordmark {
      font-size: 1.5rem;
    }

    .top :global(.logo) {
      height: 2.75rem;
    }

    .menu-btn {
      display: none;
    }

    .top-nonstop {
      grid-area: nonstop;
      display: block;
      text-align: right;
      line-height: 1.3;
    }

    .top-nonstop :global(.top-nonstop-link) {
      display: inline-block;
      min-height: 2.75rem;
      padding-block: 0.25rem;
      color: var(--primary);
      text-decoration: none;
    }

    .top-nonstop :global(.top-nonstop-link):hover .top-nonstop-number {
      text-decoration: underline;
      text-decoration-thickness: 2px;
    }

    .top-nonstop-label {
      display: block;
      color: var(--ink);
      font-size: 1rem;
    }

    .top-nonstop-number {
      display: block;
      font-size: 1.3125rem;
      font-weight: 600;
    }
  }
</style>

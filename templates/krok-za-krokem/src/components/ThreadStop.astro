---
/**
 * One stop of the guide's thread (Jak postupovat): the phase in small gold capitals in the label
 * column, the ring on the thread, and in the content column the heading, when it applies (only
 * for steps tied to a place), the summary, the guided list ("Co je potřeba": plain numbered
 * sentences, never tick boxes: design-differentiation §1.3), the body in <details>, the contact
 * prompt and "Potom: …" to the step that follows.
 * The ring is an aria-hidden link (tabindex -1) to the stop itself, so core's scroll spy on the
 * thread fills the ring of the stop being read. "Potom" links carry the full path
 * (/jak-postupovat/#…), which keeps them out of the spy (it reads a[href^="#"] only), and
 * data-guide-next, so with JavaScript core moves to the next step without clearing the place
 * filter and marks it data-guide-arrived; without JavaScript it is a plain link (:target).
 * Either way the arrived stop gets a quiet tint.
 */
import type { CollectionEntry } from "astro:content";
import EmergencyPhoneLink from "@core/components/EmergencyPhoneLink.astro";
import PhoneLink from "@core/components/PhoneLink.astro";
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import UnreviewedMark from "@core/components/UnreviewedMark.astro";
import { render } from "@core/content/load.ts";
import { guideSentence, situationsAttribute, type SpecificSituation } from "@core/content/guidance-flow.ts";
import type { SiteContext } from "@core/content/view-models.ts";
import { formatPhone } from "@core/format/phone.ts";
import { primaryOfficePhone } from "../lib/site.ts";
import { guidancePhaseLabels, situationWords, ui } from "../i18n/cs.ts";

interface Props {
  site: SiteContext;
  entry: CollectionEntry<"guidance">;
  /** The step that follows (nextGuidanceStep), or null for the last one. */
  next: CollectionEntry<"guidance"> | null;
  /** Path of the guide page, for the full-path "Potom" links. */
  base: string;
}

const { site, entry, next, base } = Astro.props;
const data = entry.data;
const office = primaryOfficePhone(site);
const named = data.situations.filter((situation) => situation !== "any") as SpecificSituation[];
let applies: string | null = null;
if (named.length > 0) {
  applies = `${ui.appliesWhen} ${named.map((situation) => situationWords[situation]).join(", ")}`;
}
const { Content } = await render(entry);
const hasBody = (entry.body ?? "").trim() !== "";
const listLabelId = `${entry.id}-potreba`;
---
<li id={entry.id} class="stop guide-stop" data-guide-step data-situations={situationsAttribute(entry)}>
  <p class="label stop-label">{guidancePhaseLabels[data.phase]}</p>
  <a href={`#${entry.id}`} class="stop-ring" tabindex="-1" aria-hidden="true"></a>
  <div class="stop-body">
    <h2 class="stop-title">{data.title}</h2>
    {applies !== null ? <p class="step-when">{applies}</p> : null}
    <PlaceholderMark active={data.placeholder} as="div">
      <p class="stop-text">{data.summary}</p>
      <UnreviewedMark reviewedAt={data.review.reviewedAt} />
    </PlaceholderMark>
    {
      data.checklist.length > 0 ? (
        <div class="stop-guide">
          <p id={listLabelId} class="stop-list-label">{ui.guideListLabel}</p>
          <ol class="stop-list" aria-labelledby={listLabelId}>
            {data.checklist.map((item) => (
              <li>{guideSentence(item)}</li>
            ))}
          </ol>
        </div>
      ) : null
    }
    {
      hasBody ? (
        <details class="more">
          <summary>{ui.readMore}</summary>
          <div class="prose step-body">
            <Content />
          </div>
        </details>
      ) : null
    }
    {
      data.contactPrompt === "emergency" && site.emergency.enabled ? (
        <p class="step-call">
          <EmergencyPhoneLink emergency={site.emergency} variant="custom" class="step-call-link">
            {site.emergency.label}{" "}<span class="nowrap">{formatPhone(site.emergency.phone).display}</span>
          </EmergencyPhoneLink>
        </p>
      ) : null
    }
    {
      data.contactPrompt === "office" ? (
        <p class="step-call">
          {ui.officePrompt}:{" "}
          <PhoneLink number={office.number}>
            {office.label}{" "}<span class="nowrap">{formatPhone(office.number).display}</span>
          </PhoneLink>
        </p>
      ) : null
    }
    {
      next !== null ? (
        <p class="step-next">
          <a href={`${base}#${next.id}`} data-guide-next>{ui.nextStep(next.data.title)}</a>
        </p>
      ) : null
    }
  </div>
</li>

<style>
  .guide-stop {
    /* Named only so the guide's same-document view transition can slide the stops that stay. */
    view-transition-name: match-element;
    view-transition-class: guide-step;
  }

  .step-when {
    color: var(--muted);
    font-size: 1rem;
    font-style: italic;
  }

  .stop-title + .step-when {
    margin-top: 0.25rem;
  }

  .stop-guide {
    margin-top: 1.125rem;
  }

  .step-body {
    margin-top: 0.25rem;
  }

  .step-call :global(.step-call-link) {
    display: inline-block;
    padding-block: 0.625rem;
    color: var(--primary);
    font-weight: 600;
  }

  .step-next {
    margin-top: 0.25rem;
  }

  .step-next a {
    display: inline-block;
    padding-block: 0.625rem;
    font-size: 1.0625rem;
  }

  /*
   * Arrival through "Potom": a quiet tint behind the content column (padding is constant, so
   * nothing moves); the ring is filled by the spy at the same time.
   */
  .guide-stop .stop-body {
    margin: -0.75rem -1rem 0;
    padding: 0.75rem 1rem;
    border-radius: 0.375rem;
    background-color: transparent;
  }

  .guide-stop:target .stop-body,
  .guide-stop[data-guide-arrived] .stop-body {
    background-color: color-mix(in oklab, var(--primary-fill) 7%, var(--ground));
  }

  /* Core focuses the arrived stop (tabindex="-1"); the tint marks it, so no ring around it. */
  .guide-stop:focus-visible,
  .guide-stop:focus {
    outline: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .guide-stop .stop-body {
      transition: background-color 200ms ease;
    }
  }
</style>

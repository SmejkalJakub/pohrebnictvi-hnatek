---
/**
 * Služby as one long page with anchors (no detail pages): one axis section per featured service
 * (`id` = the service id, so /sluzby/#<id> lands on it), then one "Další služby" passage holding
 * the other services under their own anchors. Each shows its summary, body, the inclusion lists
 * of its price group and a "Co je v ceně" link to the price list; no prices on this page.
 */
import type { CollectionEntry } from "astro:content";
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import { render } from "@core/content/load.ts";
import type { PricingView } from "@core/content/view-models.ts";
import AxisSection from "./AxisSection.astro";
import InclusionLists from "./InclusionLists.astro";
import { priceGroupFor } from "../lib/site.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  services: CollectionEntry<"services">[];
  pricing: PricingView | null;
}

const { services, pricing } = Astro.props;
let featured = services.filter((service) => service.data.featured);
if (featured.length === 0) {
  featured = services.slice(0, 1);
}
const others = services.filter((service) => !featured.includes(service));

const items = [];
for (const service of services) {
  const { Content } = await render(service);
  const group = priceGroupFor(pricing, service.data.priceGroupId);
  items.push({
    service,
    Content,
    hasBody: (service.body ?? "").trim() !== "",
    group,
  });
}
const byId = new Map(items.map((item) => [item.service.id, item]));
---
{
  featured.map((service) => {
    const item = byId.get(service.id);
    if (item === undefined) {
      return null;
    }
    const Body = item.Content;
    return (
      <>
        <AxisSection id={service.id} heading={service.data.title}>
          <PlaceholderMark active={service.data.placeholder} as="div">
            <p>{service.data.summary}</p>
            {item.hasBody ? (
              <div class="prose">
                <Body />
              </div>
            ) : null}
          </PlaceholderMark>
          {item.group !== null ? <InclusionLists includes={item.group.includes} excludes={item.group.excludes} /> : null}
          {item.group !== null ? (
            <p class="sans">
              <a href={`/cenik/#${item.group.id}`} class="go">{ui.includesLink}</a>
            </p>
          ) : null}
        </AxisSection>
      </>
    );
  })
}
{
  others.length > 0 ? (
    <AxisSection id="dalsi-sluzby" heading={ui.moreServices}>
      {others.map((service) => {
        const item = byId.get(service.id);
        if (item === undefined) {
          return null;
        }
        const Body = item.Content;
        return (
          <article id={service.id} class="other" aria-labelledby={`${service.id}-nadpis`}>
            <h3 id={`${service.id}-nadpis`} class="other-title">{service.data.title}</h3>
            <PlaceholderMark active={service.data.placeholder} as="div">
              <p>{service.data.summary}</p>
              {item.hasBody ? (
                <details class="more">
                  <summary>{ui.readMore}</summary>
                  <div class="prose">
                    <Body />
                  </div>
                </details>
              ) : null}
            </PlaceholderMark>
            {item.group !== null ? (
              <p class="sans">
                <a href={`/cenik/#${item.group.id}`} class="go">{ui.includesLink}</a>
              </p>
            ) : null}
          </article>
        );
      })}
    </AxisSection>
  ) : null
}

<style>
  .other + .other {
    margin-top: 1.75rem;
  }

  .other-title {
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .other {
    scroll-margin-top: 1rem;
  }
</style>

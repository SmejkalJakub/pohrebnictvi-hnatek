---
/** "V ceně je zahrnuto" / "Není zahrnuto": two plain bulleted lists side by side from 48 rem. */
import { ui } from "../i18n/cs.ts";

interface Props {
  includes: string[];
  excludes: string[];
  level?: 3 | 4;
}

const { includes, excludes, level = 3 } = Astro.props;
const Heading = `h${level}` as "h3" | "h4";
---
{
  includes.length > 0 || excludes.length > 0 ? (
    <div class="lists" data-inclusions>
      {includes.length > 0 ? (
        <div>
          <Heading class="list-heading">{ui.included}</Heading>
          <ul class="dot-list">
            {includes.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ) : null}
      {excludes.length > 0 ? (
        <div>
          <Heading class="list-heading">{ui.excluded}</Heading>
          <ul class="dot-list">
            {excludes.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ) : null}
    </div>
  ) : null
}

<style>
  .lists {
    display: grid;
    gap: 1.5rem;
  }

  .list-heading {
    margin-bottom: 0.5rem;
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.3;
  }

  @media (min-width: 48rem) {
    .lists {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.5rem;
    }
  }
</style>

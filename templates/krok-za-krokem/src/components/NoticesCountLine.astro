---
/**
 * Home `notices`: a link with the count of upcoming ceremonies only. Never names on home (research
 * L1, as approved for D).
 */
import AxisSection from "./AxisSection.astro";
import { ui } from "../i18n/cs.ts";

interface Props {
  title: string;
  upcoming: number;
}

const { title, upcoming } = Astro.props;
---
<AxisSection id="oznameni-domu" heading={title} data-section="notices">
  <p><a href="/oznameni/" class="go">{ui.noticesCount(upcoming)}</a></p>
</AxisSection>

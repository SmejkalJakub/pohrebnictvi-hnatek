---
/**
 * Jak postupovat: the whole thread (E1 rules for pages not drawn). On the content column the place
 * picker as a sentence of words and the reassurance lead; then one stop per published step in
 * phase order on the thread, the phase in the label column; then the closing line and the office
 * phone. Picking a word filters the stops with core's :has(:target) mechanism (no JavaScript)
 * and rewrites the picker into a sentence ("Blízký člověk zemřel doma. Ukazujeme 6 kroků ze 7.
 * Zobrazit vše"); with JavaScript and view transitions the words carry data-vt-anchor, so the
 * stops that stay slide into place (≤ 220 ms, off under prefers-reduced-motion).
 * The signature (design-differentiation §1.1): the ring of the stop being read fills with the
 * primary: core's data-spy-nav on the <ol>, whose only #-links are the rings.
 * A guide, not a checklist (§1.3): nothing is ticked, counted or remembered.
 */
import type { CollectionEntry } from "astro:content";
import PhoneLink from "@core/components/PhoneLink.astro";
import {
  SITUATION_ANCHOR,
  chooserSituations,
  nextGuidanceStep,
  showsFor,
  type SpecificSituation,
} from "@core/content/guidance-flow.ts";
import type { SiteContext } from "@core/content/view-models.ts";
import { formatPhone } from "@core/format/phone.ts";
import PlaceSentence from "./PlaceSentence.astro";
import ThreadStop from "./ThreadStop.astro";
import { situationWords, ui } from "../i18n/cs.ts";
import { primaryOfficePhone } from "../lib/site.ts";

interface Props {
  site: SiteContext;
  guidance: CollectionEntry<"guidance">[];
}

const { site, guidance } = Astro.props;
const ALL_ANCHOR = "postup";
const BASE = "/jak-postupovat/";
const situations = chooserSituations(guidance);
const office = primaryOfficePhone(site);

function nextOf(entry: CollectionEntry<"guidance">): CollectionEntry<"guidance"> | null {
  return nextGuidanceStep(guidance, guidance.indexOf(entry));
}

const total = guidance.length;
const counts: Partial<Record<SpecificSituation, number>> = {};
for (const situation of situations) {
  counts[situation] = guidance.filter((entry) => showsFor(entry, situation)).length;
}

/* Filter rules, one block per offered situation (the selectors depend on the anchors). */
const filterCss = situations
  .map((situation) => {
    const target = `[data-guide]:has(#${SITUATION_ANCHOR[situation]}:target)`;
    return [
      `${target} [data-guide-step]:not([data-situations~="any"]):not([data-situations~="${situation}"]) { display: none; }`,
      `${target} [data-tally="${situation}"] { display: block; }`,
      `${target} .pick-question { color: var(--muted); }`,
      `${target} [data-place="${situation}"] { color: var(--ink); text-decoration-thickness: 3px; text-decoration-color: var(--ornament); }`,
      `${target} [data-place="${situation}"] .pick-mark { display: inline; }`,
    ].join("\n");
  })
  .join("\n");
---
<div data-guide class="guide">
  <style is:inline set:html={filterCss}></style>
  {situations.map((situation) => <span id={SITUATION_ANCHOR[situation]} class="guide-target"></span>)}
  <span id={ALL_ANCHOR} class="guide-target"></span>
  <div class="guide-intro">
    {
      situations.length > 0 ? (
        <div class="guide-pick">
          <PlaceSentence situations={situations} base="" questionId="kde-zemrel" />
          {situations.map((situation) => (
            <p class="composed" data-tally={situation}>
              <span class="composed-place">{ui.composedPlace(situationWords[situation])}</span>{" "}
              <span class="composed-count">
                {ui.composedCount(counts[situation] ?? 0, total)}{" "}
                <a href={`#${ALL_ANCHOR}`} class="go" data-vt-anchor>{ui.showAll}</a>
              </span>
            </p>
          ))}
        </div>
      ) : null
    }
    <p class="guide-lead">{ui.guideLead}</p>
  </div>
  <ol class="thread" data-spy-nav>
    {guidance.map((entry) => <ThreadStop site={site} entry={entry} next={nextOf(entry)} base={BASE} />)}
  </ol>
  <div class="thread-close">
    <p class="thread-close-line">{ui.guideClosing}</p>
    <p>
      {ui.guideClosingCall}:{" "}
      <PhoneLink number={office.number}>
        {office.label}{" "}<span class="nowrap">{formatPhone(office.number).display}</span>
      </PhoneLink>
    </p>
  </div>
</div>

<style>
  .guide {
    width: 100%;
    max-width: calc(var(--page) + 2 * var(--gutter));
    margin-inline: auto;
    padding: 2.5rem var(--gutter) 0;
  }

  .guide-target {
    display: block;
    scroll-margin-top: 1rem;
  }

  .guide-intro {
    margin-bottom: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }

  .guide-intro > * + * {
    margin-top: 1.25rem;
  }

  /* The rewritten sentence: the display face; the count and "Zobrazit vše" in the body serif. */
  .composed {
    display: none;
    margin-top: 1rem;
    view-transition-name: guide-sentence;
  }

  .composed-place {
    display: block;
    color: var(--primary);
    font-family: var(--display);
    font-size: 1.75rem;
    font-weight: var(--display-weight);
    line-height: 1.2;
    text-wrap: balance;
  }

  .composed-count {
    display: block;
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 1.0625rem;
  }

  .guide-lead {
    max-width: 36em;
    color: var(--muted);
    font-size: 1.125rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  @media (min-width: 64rem) {
    .guide {
      padding-top: 3.5rem;
    }

    .guide-intro {
      display: grid;
      grid-template-columns: var(--col-label) var(--col-ring) minmax(0, var(--col-content));
      margin-bottom: 3.5rem;
      padding-top: 2.5rem;
    }

    .guide-intro > * {
      grid-column: 3;
    }

    .guide-intro > * + * {
      margin-top: 1.5rem;
    }

    .composed-place {
      font-size: 2.25rem;
    }

    .guide-lead {
      font-size: 1.1875rem;
    }
  }

  /* View transition of the picker (same-document, started by core's data-vt-anchor). */
  @media (prefers-reduced-motion: no-preference) {
    :global(::view-transition-old(guide-sentence)),
    :global(::view-transition-new(guide-sentence)) {
      animation-duration: 200ms;
    }

    :global(::view-transition-group(*.guide-step)) {
      animation-duration: 220ms;
      animation-timing-function: ease;
    }
  }
</style>

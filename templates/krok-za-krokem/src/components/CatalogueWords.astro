---
/**
 * Home `catalogue-links`: "Rakve a květiny" as plain words linking to the two catalogue pages.
 * The photos stay at the thread's "Příprava pohřbu" stop (one place for them on the page).
 */
import type { NavItem as Nav } from "@core/content/view-models.ts";
import AxisSection from "./AxisSection.astro";
import { ui } from "../i18n/cs.ts";

interface Props {
  links: Nav[];
}

const { links } = Astro.props;
---
{
  links.length > 0 ? (
    <AxisSection id="katalog-domu" heading={ui.catalogueHeading} data-section="catalogue-links">
      <ul class="words" role="list">
        {links.map((link) => (
          <li>
            <a href={link.href} class="go">{link.label}</a>
          </li>
        ))}
      </ul>
    </AxisSection>
  ) : null
}

<style>
  .words {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--display);
    font-size: 1.5rem;
  }
</style>

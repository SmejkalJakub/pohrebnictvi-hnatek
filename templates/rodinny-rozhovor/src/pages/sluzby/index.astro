---
/**
 * "Co pro vás můžeme zařídit?": one question per kind of help (service category), alternating
 * sand and cream; each service is an answer with its own anchor (/sluzby/#<slug>), the summary,
 * the body in <details> and "Co je v ceně" when it links to a price group. No prices here, so no
 * VAT note is needed; the services drawing sits in the first question's last column.
 */
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import { getIllustrations, getPage, getPricing, getServices, getSiteContext, render } from "@core/content/load.ts";
import { SERVICE_CATEGORIES } from "@core/content/schemas.ts";
import ConversationLayout from "../../layouts/ConversationLayout.astro";
import QuestionField from "../../components/QuestionField.astro";
import Drawing from "../../components/Drawing.astro";
import FieldProse from "../../components/FieldProse.astro";
import { keepShortWords, priceGroupFor, seoTitle, toneAt } from "../../lib/conversation.ts";
import { categoryQuestions, ui } from "../../i18n/cs.ts";

const site = await getSiteContext();
const page = await getPage("sluzby");
const services = await getServices();
const pricing = await getPricing();
const drawings = await getIllustrations();
const Body = page.Content;
const categories = SERVICE_CATEGORIES.map((category) => ({
  category,
  services: services.filter((service) => service.data.category === category),
})).filter((group) => group.services.length > 0);
const rendered = new Map<string, Awaited<ReturnType<typeof render>>["Content"]>();
for (const service of services) {
  rendered.set(service.id, (await render(service)).Content);
}
function hasBody(service: (typeof services)[number]): boolean {
  return (service.body ?? "").trim() !== "";
}
---
<ConversationLayout site={site} title={seoTitle(page.data)} description={page.data.metaDescription}>
  <QuestionField question={ui.arrangeQuestion} tone={toneAt(0)} level={1} layout="head">
    {page.data.lead !== null ? <p>{keepShortWords(page.data.lead)}</p> : null}
  </QuestionField>
  {
    categories.map((group, index) => (
      <QuestionField
        question={categoryQuestions[group.category]}
        tone={toneAt(1 + index)}
        id={`otazka-${group.category}`}
        margin={index === 0 && drawings.services !== undefined ? "small" : "none"}
      >
        {group.services.map((service) => {
          const Content = rendered.get(service.id);
          const priceGroup = priceGroupFor(pricing, service.data.priceGroupId);
          return (
            <PlaceholderMark active={service.data.placeholder} as="article" class="service">
              <h3 id={service.id} class="field-h3">
                {keepShortWords(service.data.title)}
              </h3>
              <p>{keepShortWords(service.data.summary)}</p>
              {hasBody(service) && Content !== undefined ? (
                <details class="say-more">
                  <summary>{ui.sayMore}</summary>
                  <div class="prose">
                    <Content />
                  </div>
                </details>
              ) : null}
              {priceGroup !== null ? (
                <p class="label">
                  <a href={`/cenik/#${priceGroup.id}`}>{ui.includesLink}</a>
                </p>
              ) : null}
            </PlaceholderMark>
          );
        })}
        <Fragment slot="margin">
          <Drawing image={drawings.services} line="dark" width={96} height={120} />
        </Fragment>
      </QuestionField>
    ))
  }
  <FieldProse show={page.hasBody} startIndex={1 + categories.length}><Body /></FieldProse>
</ConversationLayout>

<style>
  :global(.service) + :global(.service) {
    margin-top: var(--s3);
  }

  :global(.service) > * + * {
    margin-top: 0.5rem;
  }

  :global(.service h3) {
    scroll-margin-top: 1rem;
  }
</style>

---
/**
 * Oznámení a obřady (only while features.notices is on): the list and one page per live notice.
 * Both use the neutral chrome (research L1, ⚖ pending a lawyer's view): sand publisher strip,
 * two nav words, plain cream, no fields, drawings, clay or closing sentence, no service links or
 * prices anywhere on these pages.
 */
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import { getNoticeIndex, getNotices, getOptionalPage, getSiteContext, type LoadedNotice } from "@core/content/load.ts";
import ConversationLayout from "../../layouts/ConversationLayout.astro";
import NoticeNameList from "../../components/NoticeNameList.astro";
import NoticeAnswers from "../../components/NoticeAnswers.astro";
import { keepShortWords } from "../../lib/conversation.ts";
import { ui } from "../../i18n/cs.ts";

export async function getStaticPaths() {
  const site = await getSiteContext();
  const page = await getOptionalPage("oznameni");
  if (!site.config.features.notices || page === null) {
    return [];
  }
  const notices = await getNotices();
  return [
    { params: { path: undefined }, props: { notice: null } },
    ...notices.map((notice) => ({ params: { path: notice.view.id }, props: { notice } })),
  ];
}

interface Props {
  notice: LoadedNotice | null;
}

const { notice } = Astro.props;
const site = await getSiteContext();
const page = await getOptionalPage("oznameni");
const index = await getNoticeIndex();
let title: string = ui.noticesUpcoming;
let description: string = ui.noticesUpcoming;
let lead: string | null = null;
let hasBody = false;
let placeholder = false;
if (page !== null) {
  title = page.data.title;
  description = page.data.metaDescription;
  lead = page.data.lead;
  hasBody = page.hasBody;
  placeholder = page.data.placeholder;
}
const Body = page?.Content;
const isEmpty = index.upcoming.length === 0 && index.recent.length === 0;
---
{
  notice === null ? (
    <ConversationLayout site={site} title={title} description={description} neutral>
      <div class="notices">
        <PlaceholderMark active={placeholder} as="div">
          <h1 class="notices-title">{title}</h1>
          {lead !== null ? <p class="muted notices-lead">{keepShortWords(lead)}</p> : null}
        </PlaceholderMark>
        {isEmpty ? <p>{ui.noticesEmpty}</p> : null}
        {index.upcoming.length > 0 ? (
          <section class="notices-part" aria-labelledby="nadchazejici">
            <h2 id="nadchazejici" class="part-label">
              {ui.noticesUpcoming}
            </h2>
            <NoticeNameList notices={index.upcoming} recent={false} />
          </section>
        ) : null}
        {index.recent.length > 0 ? (
          <section class="notices-part" aria-labelledby="nedavna">
            <h2 id="nedavna" class="part-label">
              {ui.noticesRecent}
            </h2>
            <NoticeNameList notices={index.recent} recent />
          </section>
        ) : null}
        {hasBody && Body !== undefined ? (
          <div class="prose notices-body">
            <Body />
          </div>
        ) : null}
      </div>
    </ConversationLayout>
  ) : (
    <ConversationLayout
      site={site}
      title={notice.view.fullName}
      description={`${title}: ${notice.view.fullName}`}
      noindex={notice.view.noindex}
      neutral
    >
      <NoticeAnswers notice={notice} />
    </ConversationLayout>
  )
}

<style>
  .notices {
    padding: 1.75rem var(--side) 3rem;
  }

  .notices-title {
    font-size: var(--h1);
    line-height: 1.06;
  }

  .notices-lead {
    margin-top: 0.75rem;
    max-width: 34em;
  }

  .notices-part {
    margin-top: 2.5rem;
  }

  .part-label {
    margin-bottom: 0.75rem;
    color: var(--muted);
    font-family: var(--sans);
    font-size: var(--label);
    font-weight: 500;
  }

  .notices-body {
    margin-top: 3rem;
    max-width: 40rem;
  }

  @media (min-width: 64rem) {
    .notices {
      padding-top: 4rem;
      padding-bottom: 4.5rem;
    }

    .notices-part {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 1.5rem;
      margin-top: 3.5rem;
    }

    .part-label {
      grid-column: 1 / span 4;
      margin: 0.5rem 0 0;
    }

    .notices-part > :global(ul) {
      grid-column: 5 / span 8;
    }
  }
</style>

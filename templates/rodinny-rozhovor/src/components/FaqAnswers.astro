---
/** Časté otázky: each question is already a question, so it is a heading with its answer open. */
import type { CollectionEntry } from "astro:content";
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import { render, type FaqGroup } from "@core/content/load.ts";
import { keepShortWords } from "../lib/conversation.ts";

interface Props {
  groups: FaqGroup<CollectionEntry<"faq">>[];
}

const { groups } = Astro.props;
const rendered = await Promise.all(
  groups.map(async (group) => ({
    label: group.label,
    entries: await Promise.all(
      group.entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
    ),
  })),
);
---
{
  rendered.map((group) => (
    <div class="faq-group">
      {rendered.length > 1 ? <p class="list-label muted">{group.label}</p> : null}
      {group.entries.map(({ entry, Content }) => (
        <PlaceholderMark active={entry.data.placeholder} as="div" class="faq-item">
          <h3 id={`otazka-${entry.id}`} class="field-h3">
            {keepShortWords(entry.data.question)}
          </h3>
          <div class="prose faq-answer">
            <Content />
          </div>
        </PlaceholderMark>
      ))}
    </div>
  ))
}

<style>
  .faq-group + .faq-group {
    margin-top: var(--s4);
  }

  .faq-group :global(h3) {
    margin-top: var(--s3);
    scroll-margin-top: 1rem;
  }

  .faq-answer {
    margin-top: 0.375rem;
  }
</style>

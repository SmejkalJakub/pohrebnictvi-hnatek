---
/**
 * The header on cream: the wordmark (or the client's dark logo, never on the clay field) and the
 * navigation words. Not sticky. On phones the words wrap under the wordmark.
 */
import { Image } from "astro:assets";
import type { SiteContext } from "@core/content/view-models.ts";
import { resolveOptionalImage } from "@core/media/resolve.ts";
import WordNav from "./WordNav.astro";
import type { WordLink } from "../lib/conversation.ts";

interface Props {
  site: SiteContext;
  words: WordLink[];
}

const { site, words } = Astro.props;
const logo = resolveOptionalImage(site.company.logo);
---
<header class="family-header">
  <a href="/" class="wordmark">
    {
      logo !== null ? (
        <Image src={logo.src} alt={site.company.brandName} height={56} densities={[1, 2]} class="logo" loading="eager" />
      ) : (
        site.company.brandName
      )
    }
  </a>
  <WordNav words={words} />
</header>

<style>
  .family-header {
    padding: 0.75rem var(--side) 0.375rem;
    background: var(--ground);
  }

  .wordmark {
    display: inline-block;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;
  }

  /* A definite height (the image is generated at 56 px) so the box exists before the file loads;
   * the width follows from the width/height attributes. A logo wider than the phone shrinks
   * inside its box instead of stretching. */
  .wordmark :global(.logo) {
    width: auto;
    height: 3.5rem;
    object-fit: contain;
    object-position: left center;
  }

  @media (min-width: 64rem) {
    .family-header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0.5rem 2rem;
      padding-block: 1.375rem;
    }

    .wordmark {
      font-size: 1.75rem;
    }
  }
</style>

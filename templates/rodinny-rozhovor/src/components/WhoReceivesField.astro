---
/** Home "Kdo vás přijme?": the people's names with what they do for you, linking to /o-nas/#lide. */
import type { PersonView } from "@core/content/view-models.ts";
import QuestionField from "./QuestionField.astro";
import { keepShortWords, type Tone } from "../lib/conversation.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  tone: Tone;
  people: PersonView[];
}

const { tone, people } = Astro.props;
---
<QuestionField question={ui.receiveQuestion} tone={tone} section="people" wide>
  <ul class="name-list" role="list">
    {
      people.map((person) => (
        <li>
          <strong>{person.name}</strong>
          <span class="muted"> {keepShortWords(person.role)}</span>
        </li>
      ))
    }
  </ul>
  <p class="label"><a href="/o-nas/#lide">{ui.aboutLink}</a></p>
</QuestionField>

<style>
  .name-list {
    padding: 0;
    list-style: none;
  }

  .name-list li + li {
    margin-top: 0.375rem;
  }
</style>

---
/**
 * Jak postupovat (Teď hned): the navy opening with the number, the place picker as ruled rows and
 * the steps by phase (filtered by place without JavaScript), the page body, then a stone Kancelář
 * block. Časté otázky live on Služby (S předstihem), not here.
 */
import { getGuidance, getPage, getSiteContext } from "@core/content/load.ts";
import CestyLayout from "../layouts/CestyLayout.astro";
import PathPanel from "../components/PathPanel.astro";
import PhaseSteps from "../components/PhaseSteps.astro";
import OfficeColumn from "../components/OfficeColumn.astro";
import { getPathLinks } from "../lib/page-links.ts";
import { seoDescription, seoTitle } from "../lib/site.ts";

const site = await getSiteContext();
const page = await getPage("jak-postupovat");
const guidance = await getGuidance();
const links = await getPathLinks(site, Astro.url.pathname, "now");
const Body = page.Content;
---
<CestyLayout site={site} path="now" title={seoTitle(page.data)} description={seoDescription(page.data)}>
  <PathPanel
    tone="now"
    title={page.data.title}
    lead={page.data.lead}
    placeholder={page.data.placeholder}
    links={links}
    emergency={site.emergency}
  />
  <PhaseSteps site={site} guidance={guidance} />
  {
    page.hasBody ? (
      <div class="section prose narrow">
        <Body />
      </div>
    ) : null
  }
  <OfficeColumn site={site} closing />
</CestyLayout>

---
/**
 * Home: the split hero (the question, the navy half "Teď hned" and the stone half "S předstihem"),
 * then the other sections in site.config.homepage.sections order as plain columns (the drawn row
 * Kancelář · Oznámení a obřady · O nás). The hero is always first (manifest constraint).
 */
import {
  getDocuments,
  getFaq,
  getGuidance,
  getNoticeIndex,
  getOptionalPage,
  getPage,
  getPeople,
  getPricing,
  getServices,
  getSiteContext,
} from "@core/content/load.ts";
import { chooserSituations } from "@core/content/guidance-flow.ts";
import { serviceHref } from "@core/content/view-models.ts";
import type { HomepageSection } from "@core/content/config.ts";
import CestyLayout from "../layouts/CestyLayout.astro";
import SplitHero from "../components/SplitHero.astro";
import type { PrepareRow } from "../components/PrepareHalf.astro";
import OfficeColumn from "../components/OfficeColumn.astro";
import NoticesLinkColumn from "../components/NoticesLinkColumn.astro";
import AboutColumn from "../components/AboutColumn.astro";
import PlacePickerLinks from "../components/PlacePickerLinks.astro";
import ServicesRuledList from "../components/ServicesRuledList.astro";
import PriceFromLine from "../components/PriceFromLine.astro";
import PeopleColumn from "../components/PeopleColumn.astro";
import CataloguePairLinks from "../components/CataloguePairLinks.astro";
import DocumentsColumn from "../components/DocumentsColumn.astro";
import FaqColumn from "../components/FaqColumn.astro";
import { headlineItem } from "../lib/site.ts";
import { ui } from "../i18n/cs.ts";

const site = await getSiteContext();
const home = await getPage("home");
const about = await getPage("o-nas");
const services = await getServices();
const guidance = await getGuidance();
const people = await getPeople();
const pricing = await getPricing();
const documents = await getDocuments();
const faq = await getFaq();
const noticesPage = await getOptionalPage("oznameni");
const prePlanningPage = await getOptionalPage("pohreb-predem");
const noticeIndex = await getNoticeIndex();

/* The stone half: Ceník with a price, the featured services except transport (Teď hned), then
   Pohřeb předem and Časté otázky while they are on. */
const featured = services.filter((service) => service.data.featured && service.data.category !== "transport");
const firstGroup = pricing === null ? null : (pricing.groups[0] ?? null);
const headline = headlineItem(firstGroup);
const rows: PrepareRow[] = [];
if (pricing !== null) {
  rows.push({ key: "cenik", label: ui.priceRow, href: "/cenik/", note: null, price: headline });
}
for (const service of featured) {
  rows.push({
    key: service.id,
    label: service.data.title,
    href: serviceHref(service.id, true),
    note: service.data.summary,
    price: null,
  });
}
if (site.config.features.prePlanning && prePlanningPage !== null) {
  rows.push({
    key: "pohreb-predem",
    label: prePlanningPage.data.navLabel,
    href: "/pohreb-predem/",
    note: prePlanningPage.data.lead,
    price: null,
  });
}
if (faq.length > 0) {
  rows.push({ key: "faq", label: ui.faqHeading, href: "/sluzby/#caste-otazky", note: ui.faqRowNote, price: null });
}

const situations = chooserSituations(guidance);
let aboutText = about.data.lead;
if (about.data.excerpt !== null) {
  aboutText = about.data.excerpt;
}
const catalogueLinks = site.nav.filter((item) => item.id === "rakve" || item.id === "kvetiny");
let noticesTitle: string = ui.noticesHeading;
if (noticesPage !== null) {
  noticesTitle = noticesPage.data.title;
}
const noticeCount = noticeIndex.upcoming.length + noticeIndex.recent.length;
let homeServices = services.filter((service) => service.data.featured);
if (homeServices.length === 0) {
  homeServices = services.slice(0, 3);
}

/** Sections after the hero that have something to show, in the client's order. */
function renders(section: HomepageSection): boolean {
  if (section === "hero") {
    return false;
  }
  if (section === "next-steps") {
    return situations.length > 0;
  }
  if (section === "services") {
    return homeServices.length > 0;
  }
  if (section === "price-summary") {
    return pricing !== null && headline !== null;
  }
  if (section === "people") {
    return people.length > 0;
  }
  if (section === "catalogue-links") {
    return catalogueLinks.length > 0;
  }
  if (section === "notices") {
    return site.config.features.notices && noticesPage !== null;
  }
  if (section === "documents") {
    return documents.length > 0;
  }
  if (section === "faq") {
    return faq.length > 0;
  }
  return true;
}

const order = site.config.homepage.sections.filter(renders);
/* The drawn row: three columns only when exactly these three sections follow the hero. */
const ROW_SECTIONS: HomepageSection[] = ["contact-summary", "notices", "family-story"];
const threeUp = order.length === ROW_SECTIONS.length && order.every((section) => ROW_SECTIONS.includes(section));
---
<CestyLayout site={site} path="both" title={home.data.metaTitle} description={home.data.metaDescription ?? site.company.brandName}>
  <SplitHero emergency={site.emergency} rows={rows} pricing={pricing} threeUp={threeUp} />
  {
    order.map((section) => (
      <>
        {section === "contact-summary" ? <OfficeColumn site={site} /> : null}
        {section === "notices" ? <NoticesLinkColumn title={noticesTitle} count={noticeCount} /> : null}
        {section === "family-story" ? (
          <AboutColumn
            title={about.data.title}
            text={aboutText}
            tradition={site.company.tradition.publicWording}
            placeholder={about.data.placeholder}
          />
        ) : null}
        {section === "next-steps" ? (
          <PlacePickerLinks situations={situations} base="/jak-postupovat/" questionId="kde-domu" asSection />
        ) : null}
        {section === "services" ? <ServicesRuledList services={homeServices} /> : null}
        {section === "price-summary" && pricing !== null && headline !== null ? (
          <PriceFromLine pricing={pricing} item={headline} />
        ) : null}
        {section === "people" ? <PeopleColumn people={people} /> : null}
        {section === "catalogue-links" ? <CataloguePairLinks links={catalogueLinks} /> : null}
        {section === "documents" ? <DocumentsColumn documents={documents} /> : null}
        {section === "faq" ? <FaqColumn groups={faq} /> : null}
      </>
    ))
  }
</CestyLayout>

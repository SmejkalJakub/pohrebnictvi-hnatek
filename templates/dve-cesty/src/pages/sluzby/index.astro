---
/**
 * Služby (S předstihem, the path's first page): the stone opening, then the services by category
 * as ruled lists (heading 4/12, rows 8/12) linking to their own pages, prices with the VAT note,
 * then Časté otázky (#caste-otazky) while FAQ is on, then the page body.
 */
import VatNote from "@core/components/VatNote.astro";
import { SERVICE_CATEGORIES } from "@core/content/schemas.ts";
import { getFaq, getPage, getPricing, getServices, getSiteContext } from "@core/content/load.ts";
import CestyLayout from "../../layouts/CestyLayout.astro";
import PathPanel from "../../components/PathPanel.astro";
import ServiceGroupList from "../../components/ServiceGroupList.astro";
import FaqDetailsGroups from "../../components/FaqDetailsGroups.astro";
import { getPathLinks } from "../../lib/page-links.ts";
import { headlineItem, priceGroupFor, seoDescription, seoTitle } from "../../lib/site.ts";
import { serviceCategoryLabels } from "../../i18n/cs.ts";

const site = await getSiteContext();
const page = await getPage("sluzby");
const services = await getServices();
const pricing = await getPricing();
const faq = await getFaq();
const links = await getPathLinks(site, Astro.url.pathname, "ahead");
/* Pohřeb bez obřadu is first-class: the cremation category (funerals without ceremony) leads. */
const order = ["cremation", ...SERVICE_CATEGORIES.filter((category) => category !== "cremation")] as const;
const groups = order
  .map((category) => ({ category, services: services.filter((service) => service.data.category === category) }))
  .filter((group) => group.services.length > 0);
const showsPrice = services.some((service) => headlineItem(priceGroupFor(pricing, service.data.priceGroupId)) !== null);
const Body = page.Content;
---
<CestyLayout site={site} path="ahead" title={seoTitle(page.data)} description={seoDescription(page.data)}>
  <PathPanel
    tone="ahead"
    title={page.data.title}
    lead={page.data.lead}
    placeholder={page.data.placeholder}
    links={links}
    emergency={site.emergency}
  />
  {
    groups.map((group) => (
      <ServiceGroupList
        id={`kategorie-${group.category}`}
        heading={serviceCategoryLabels[group.category]}
        services={group.services}
        pricing={pricing}
      />
    ))
  }
  {
    showsPrice && pricing !== null ? (
      <div class="section">
        <VatNote pricing={pricing} class="muted" />
      </div>
    ) : null
  }
  {faq.length > 0 ? <FaqDetailsGroups groups={faq} /> : null}
  {
    page.hasBody ? (
      <div class="section prose narrow">
        <Body />
      </div>
    ) : null
  }
</CestyLayout>

---
/**
 * Service page (S předstihem): the stone opening (title, summary as the lead, ruled nonstop line),
 * then the body, what the linked price group includes and costs (with the VAT note), and the
 * other services.
 */
import type { CollectionEntry } from "astro:content";
import { getPricing, getServices, getSiteContext, render } from "@core/content/load.ts";
import CestyLayout from "../../layouts/CestyLayout.astro";
import PathPanel from "../../components/PathPanel.astro";
import ServiceDetailBody from "../../components/ServiceDetailBody.astro";
import { getPathLinks } from "../../lib/page-links.ts";
import { priceGroupFor } from "../../lib/site.ts";

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((service) => ({ params: { slug: service.id }, props: { service } }));
}

interface Props {
  service: CollectionEntry<"services">;
}

const { service } = Astro.props;
const site = await getSiteContext();
const pricing = await getPricing();
const services = await getServices();
const others = services.filter((other) => other.id !== service.id);
const group = priceGroupFor(pricing, service.data.priceGroupId);
const links = await getPathLinks(site, Astro.url.pathname, "ahead");
const { Content } = await render(service);
const hasBody = (service.body ?? "").trim() !== "";
---
<CestyLayout site={site} path="ahead" title={service.data.title} description={service.data.summary}>
  <PathPanel
    tone="ahead"
    title={service.data.title}
    lead={service.data.summary}
    placeholder={service.data.placeholder}
    links={links}
    emergency={site.emergency}
  />
  <ServiceDetailBody site={site} service={service} others={others} group={group} pricing={pricing} hasBody={hasBody}>
    <Content />
  </ServiceDetailBody>
</CestyLayout>

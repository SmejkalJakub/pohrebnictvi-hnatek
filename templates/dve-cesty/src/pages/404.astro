---
/**
 * 404: the switch with nothing selected, the H1 and one sentence, then the two small halves, and
 * a line to Oznámení a obřady while notices are on (someone looking for a notice lands here too).
 */
import { getOptionalPage, getPricing, getSiteContext } from "@core/content/load.ts";
import CestyLayout from "../layouts/CestyLayout.astro";
import LostSplit from "../components/LostSplit.astro";
import { ui } from "../i18n/cs.ts";

const site = await getSiteContext();
const pricing = await getPricing();
const noticesPage = await getOptionalPage("oznameni");
let showNotices = false;
if (site.config.features.notices && noticesPage !== null) {
  showNotices = true;
}
---
<CestyLayout site={site} path="both" title={ui.notFoundTitle} description={ui.notFoundTitle} noindex lost>
  <div class="wrap lost-head">
    <h1 class="lost-title">{ui.notFoundTitle}</h1>
    <p>{ui.notFoundText}</p>
  </div>
  <LostSplit emergency={site.emergency} hasPricing={pricing !== null} />
  {
    showNotices && noticesPage !== null ? (
      <div class="section">
        <p>
          {ui.notFoundNotices}{" "}
          <a href="/oznameni/" class="go">{noticesPage.data.navLabel}</a>
        </p>
      </div>
    ) : null
  }
</CestyLayout>

<style>
  .lost-head {
    padding-top: 1.75rem;
  }

  .lost-head > * + * {
    margin-top: 0.75rem;
  }

  .lost-title {
    font-size: var(--h1);
    line-height: 1.18;
  }

  @media (min-width: 64rem) {
    .lost-head {
      max-width: calc(48rem + 2 * var(--gutter));
      padding-top: 3rem;
    }
  }
</style>

---
/**
 * Kancelář (address, office hours under their own heading, office phone). On home it is the
 * "contact-summary" section; at the end of a Teď hned page (`closing`) it is a stone block. Never
 * in a navy field and never next to the nonstop number.
 */
import PhoneLink from "@core/components/PhoneLink.astro";
import type { SiteContext } from "@core/content/view-models.ts";
import { formatAddressInline } from "@core/format/address.ts";
import { formatPhone } from "@core/format/phone.ts";
import { mainLocation, primaryOfficePhone } from "../lib/site.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  site: SiteContext;
  /** A stone block closing a Teď hned page instead of the home section. */
  closing?: boolean;
}

const { site, closing = false } = Astro.props;
const location = mainLocation(site);
const office = primaryOfficePhone(site);
---
<section
  class={closing ? "office-close" : "home-col"}
  data-section={closing ? undefined : "contact-summary"}
  data-tone={closing ? "ahead" : undefined}
  aria-labelledby="kancelar"
>
  <h2 id="kancelar" class="col-heading">{ui.officeHeading}</h2>
  <p>{formatAddressInline(location.address)}</p>
  <div data-office-hours>
    <h3 class="visually-hidden">{ui.hoursHeading}</h3>
    <ul class="col-lines" role="list">
      {
        site.officeHoursRows.map((row) => (
          <li>
            <abbr title={row.daysLong}>{row.days}</abbr> <span class="nowrap">{row.text}</span>
            {row.note !== null ? <span class="col-note">{row.note}</span> : null}
          </li>
        ))
      }
    </ul>
  </div>
  <PhoneLink number={office.number}>{office.label}{" "}<span class="nowrap">{formatPhone(office.number).display}</span></PhoneLink>
</section>

<style>
  .office-close {
    margin-top: 2.25rem;
    padding: 1.375rem var(--gutter);
  }

  .office-close > * + * {
    margin-top: 0.5rem;
  }

  @media (min-width: 64rem) {
    .office-close {
      margin-top: 3.5rem;
      padding-block: 2.25rem;
    }
  }
</style>

---
/**
 * A Markdown body as plain sections: every `##` heading starts a section under a 1 px rule; at
 * 1280 the heading sits in the 4/12 column and its text in 8/12 (CSS grid on the prose, so the
 * Markdown stays one block and nothing is parsed).
 */
interface Props {
  label?: string;
}

const { label } = Astro.props;
---
<div class="section prose prose-sections" aria-label={label}>
  <slot />
</div>

<style>
  .prose-sections :global(h2) {
    margin-top: 2.25rem;
    padding-top: 0.875rem;
    border-top: 1px solid var(--hairline);
  }

  .prose-sections :global(h2:first-child) {
    margin-top: 0;
  }

  .prose-sections {
    max-width: calc(48rem + 2 * var(--gutter));
  }

  @media (min-width: 64rem) {
    .prose-sections {
      display: grid;
      grid-template-columns: 4fr 8fr;
      column-gap: 3.5rem;
      max-width: none;
    }

    .prose-sections > :global(*) {
      grid-column: 2;
      max-width: 48rem;
    }

    .prose-sections > :global(* + *) {
      margin-top: 0.875rem;
    }

    .prose-sections > :global(h2) {
      grid-column: 1;
      margin-top: 2.25rem;
      font-size: 1.5rem;
    }

    .prose-sections > :global(h2 + *) {
      margin-top: 2.25rem;
      padding-top: 0.875rem;
      border-top: 1px solid var(--hairline);
    }

    .prose-sections > :global(h2:first-child),
    .prose-sections > :global(h2:first-child + *) {
      margin-top: 0;
    }
  }
</style>

---
/**
 * Rakve and Květiny as ruled rows: the 4:3 or 1:1 image (160 px wide) beside the name, the code,
 * material or type, and the summary. Without any image the rows are plain ruled rows; an item
 * without an image gets no empty frame. Zero items: one sentence and the office phone.
 */
import { Image } from "astro:assets";
import PhoneLink from "@core/components/PhoneLink.astro";
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import type { ImageRef } from "@core/content/schemas.ts";
import type { SiteContext } from "@core/content/view-models.ts";
import { formatPhone } from "@core/format/phone.ts";
import { resolveOptionalImage } from "@core/media/resolve.ts";
import { primaryOfficePhone } from "../lib/site.ts";
import { ui } from "../i18n/cs.ts";

export interface ProductItem {
  id: string;
  name: string;
  detail: string | null;
  summary: string | null;
  image: ImageRef | null;
  placeholder: boolean;
}

interface Props {
  site: SiteContext;
  items: ProductItem[];
  aspect: "4:3" | "1:1";
}

const { site, items, aspect } = Astro.props;
const rows = items.map((item) => ({ item, photo: resolveOptionalImage(item.image) }));
const withImages = rows.some((row) => row.photo !== null);
const width = 160;
let height = 120;
if (aspect === "1:1") {
  height = 160;
}
const office = primaryOfficePhone(site);
---
{
  rows.length === 0 ? (
    <div class="section narrow">
      <p>{ui.catalogueEmpty}</p>
      <p>
        <PhoneLink number={office.number} class="go">{office.label}{" "}<span class="nowrap">{formatPhone(office.number).display}</span></PhoneLink>
      </p>
    </div>
  ) : (
    <div class="section">
      <ul class="ruled products" role="list" data-layout={withImages ? "images" : "plain"}>
        {rows.map(({ item, photo }) => (
          <li id={item.id} class="product">
            {photo !== null ? (
              <div class="product-image-wrap">
                <PlaceholderMark active={photo.isPlaceholder} kind="image" as="div">
                <Image
                  src={photo.src}
                  alt={photo.alt}
                  width={width}
                  height={height}
                  densities={[1, 2]}
                  class="product-image"
                  style={`object-position: ${photo.objectPosition}`}
                />
                </PlaceholderMark>
              </div>
            ) : null}
            <div class="product-text">
              <PlaceholderMark active={item.placeholder} as="div">
                <h2 class="product-name">{item.name}</h2>
                {item.detail !== null ? <p class="muted">{item.detail}</p> : null}
                {item.summary !== null ? <p>{item.summary}</p> : null}
              </PlaceholderMark>
            </div>
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .products > li:first-child {
    border-top: 2px solid var(--navy);
  }

  .products[data-layout="images"] .product {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    column-gap: 1rem;
    align-items: start;
  }

  .products[data-layout="images"] .product > .product-text:only-child {
    grid-column: 2;
  }

  .products :global(.product-image) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    background: var(--stone);
  }

  .product-name {
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .product-text > :global(* + *),
  .product-text > :global([data-placeholder] > * + *) {
    margin-top: 0.25rem;
  }

  @media (min-width: 64rem) {
    .products[data-layout="images"] .product {
      grid-template-columns: 10rem minmax(0, 1fr);
      column-gap: 2rem;
    }

    .product-name {
      font-size: 1.4375rem;
    }

    .product-text {
      max-width: 48rem;
    }
  }
</style>

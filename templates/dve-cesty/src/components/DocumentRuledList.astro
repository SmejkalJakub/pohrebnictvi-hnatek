---
/** Dokumenty (#dokumenty on Právní informace): a ruled list, title link, kind, "PDF", valid from. */
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import type { DocumentView } from "@core/content/view-models.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  documents: DocumentView[];
}

const { documents } = Astro.props;
---
<section id="dokumenty" class="section split-section" aria-labelledby="dokumenty-nadpis">
  <div class="split-head">
    <h2 id="dokumenty-nadpis" class="section-heading">{ui.documentsHeading}</h2>
  </div>
  <ul class="ruled documents" role="list">
    {
      documents.map((document) => (
        <li>
          <PlaceholderMark active={document.placeholder} as="div">
            <a href={document.href} class="ruled-title">{document.title}</a>
            <p class="muted">
              {document.kindLabel} · {ui.pdf}
              {document.validFromText !== null ? ` · ${ui.validFrom} ${document.validFromText}` : ""}
            </p>
          </PlaceholderMark>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .documents > li:first-child {
    border-top: 2px solid var(--navy);
  }
</style>

---
/**
 * The stone form of the nonstop line, the last element of every S předstihem opening: under a
 * 2 px navy rule, "Někdo právě zemřel?" as plain text, then one tel: link whose visible text is
 * the service label and the number (26 / 22 px 800, underlined 2 px). The boards show "Nonstop
 * +420 …"; the full label is visible on purpose (the link's visible text includes label and
 * number, WCAG 2.5.3 against core's accessible name). Never flex around the label and number.
 */
import EmergencyPhoneLink from "@core/components/EmergencyPhoneLink.astro";
import type { EmergencyTransport } from "@core/content/schemas.ts";
import { formatPhone } from "@core/format/phone.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  emergency: EmergencyTransport;
}

const { emergency } = Astro.props;
const phone = formatPhone(emergency.phone);
---
{
  emergency.enabled ? (
    <p class="ahead-line">
      <span class="ahead-question">{ui.someoneDied}</span>{" "}
      <EmergencyPhoneLink emergency={emergency} variant="custom" class="ahead-link">
        <span class="ahead-label">{emergency.label}</span>{" "}
        <span class="ahead-digits" data-part="number">{phone.display}</span>
      </EmergencyPhoneLink>
    </p>
  ) : null
}

<style>
  .ahead-line {
    margin-top: 1.25rem;
    padding-top: 0.75rem;
    border-top: 2px solid var(--navy);
  }

  .ahead-question {
    display: block;
  }

  .ahead-line :global(.ahead-link) {
    display: inline-block;
    padding-block: 0.375rem;
    color: var(--navy);
    font-size: 1.375rem;
    font-weight: 800;
    line-height: 1.3;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .ahead-digits {
    white-space: nowrap;
  }

  @media (min-width: 64rem) {
    .ahead-line {
      margin-top: 1.75rem;
      padding-top: 1rem;
    }

    .ahead-question {
      display: inline;
      margin-right: 0.75rem;
    }

    .ahead-line :global(.ahead-link) {
      font-size: 1.625rem;
    }
  }
</style>

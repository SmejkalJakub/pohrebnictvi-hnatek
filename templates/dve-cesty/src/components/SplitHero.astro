---
/**
 * The home hero is the split itself: the question as the H1, then the navy half (Teď hned) and
 * the stone half (S předstihem), side by side at ≥ 64 rem, navy first on phones. No image.
 */
import type { EmergencyTransport } from "@core/content/schemas.ts";
import type { PricingView } from "@core/content/view-models.ts";
import UrgentHalf from "./UrgentHalf.astro";
import PrepareHalf, { type PrepareRow } from "./PrepareHalf.astro";
import { ui } from "../i18n/cs.ts";

interface Props {
  emergency: EmergencyTransport;
  rows: PrepareRow[];
  pricing: PricingView | null;
  /** Exactly Kancelář, Oznámení and O nás follow: they sit as three columns at ≥ 64 rem. */
  threeUp?: boolean;
}

const { emergency, rows, pricing, threeUp = false } = Astro.props;
---
<section class="split" data-section="hero" data-hero data-home-row={threeUp ? "three" : undefined} aria-labelledby="otazka">
  <h1 id="otazka" class="split-question">{ui.homeQuestion}</h1>
  <div class="halves">
    <UrgentHalf emergency={emergency} />
    <PrepareHalf rows={rows} pricing={pricing} />
  </div>
</section>

<style>
  .split-question {
    padding: 1.25rem var(--gutter) 1rem;
    font-size: 1.75rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  @media (min-width: 64rem) {
    .split-question {
      padding: 2.75rem var(--gutter) 1.75rem;
      font-size: 2.5rem;
      line-height: 1.15;
    }

    .halves {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      min-height: 40rem;
    }
  }
</style>

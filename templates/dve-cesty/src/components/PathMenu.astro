---
/**
 * The menu below 64 rem, opened by the header's "Menu" button. It opens in the flow under the
 * header and overlays nothing. Path pages: a navy group (path label, the number, Teď hned links),
 * a stone group (S předstihem links; the current page bold with "(tato stránka)"), a plain group
 * (Oznámení a obřady, Úvodní stránka). Notice pages: only the reduced list (research L1).
 * Without JS the list is shown and the button hidden.
 */
import type { SiteContext } from "@core/content/view-models.ts";
import NowNumber from "./NowNumber.astro";
import type { PathLink, PathNav } from "../lib/site.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  site: SiteContext;
  id: string;
  nav: PathNav | null;
  /** Notice pages: the reduced list only. */
  reduced: PathLink[];
}

const { site, id, nav, reduced } = Astro.props;
const plain: PathLink[] = [];
if (nav !== null && nav.notices !== null) {
  plain.push(nav.notices);
}
plain.push({ key: "home", label: ui.homeLink, href: "/", current: false });
---
<nav id={id} class="menu" aria-label={ui.mainNav} data-menu>
  {
    nav === null ? (
      <div class="menu-group">
        <ul role="list">
          {reduced.map((item) => (
            <li>
              <a href={item.href} class="menu-link" aria-current={item.current ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ) : (
      <>
        <div class="menu-group" data-tone="now">
          <p class="path-label">{ui.menuNowLabel}</p>
          <NowNumber emergency={site.emergency} size="menu" />
          <ul role="list">
            {nav.now.map((item) => (
              <li>
                <a href={item.href} class="menu-link" aria-current={item.current ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="menu-group" data-tone="ahead">
          <p class="path-label">{ui.menuAheadLabel}</p>
          <ul role="list">
            {nav.ahead.map((item) => (
              <li>
                <a href={item.href} class="menu-link" aria-current={item.current ? "page" : undefined}>
                  {item.label}
                  {item.current ? <span class="menu-current"> {ui.thisPage}</span> : null}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="menu-group">
          <ul role="list">
            {plain.map((item) => (
              <li>
                <a href={item.href} class="menu-link" aria-current={item.current ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </>
    )
  }
</nav>

<style>
  .menu :global(.now-number) {
    padding-bottom: 0.5rem;
  }
</style>

---
/**
 * One notice in the neutral chrome (research L1): "Všechna oznámení", the family's photo uncropped
 * (3:4, never cropped around a face, consent per G-070), the name (34 px 800), the dates, the
 * ceremony sentence (21 px 700) under a 2 px rule, type, map link, the livestream as a plain link
 * with a note (L14), the notice text, Od rodiny, Kondolence (an instruction, never a form), the
 * parte and the QR code.
 */
import { Image } from "astro:assets";
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import type { LoadedNotice } from "@core/content/load.ts";
import { resolveOptionalImage } from "@core/media/resolve.ts";
import NoticeDates from "./NoticeDates.astro";
import NoticeQrHint from "./NoticeQrHint.astro";
import { ceremonySentence } from "../lib/notice-list.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  notice: LoadedNotice;
}

const { notice } = Astro.props;
const view = notice.view;
const ceremony = view.ceremony;
const photo = resolveOptionalImage(view.photo);
const parte = resolveOptionalImage(view.parteImage);
const Body = notice.Content;
const sentence = ceremonySentence(view, {
  sentence: ui.ceremonySentence,
  without: ui.withoutCeremony,
  private: ui.privateCeremony,
});
let mapLabel: string | null = null;
if (ceremony !== null && ceremony.mapUrl !== null) {
  const where = [ceremony.placeName, ceremony.address].filter((part) => part !== null).join(", ");
  mapLabel = `${ui.mapPrefix}: ${where}`;
}
let showType = false;
if (ceremony !== null && ceremony.type !== "without-ceremony") {
  showType = true;
}
---
<article class="notice wrap" data-notice={view.id}>
  <p class="no-print"><a href="/oznameni/" class="go">{ui.allNotices}</a></p>
  <div class="notice-main">
    <PlaceholderMark active={view.placeholder} as="div">
      {
        photo !== null ? (
          <Image
            src={photo.src}
            alt={photo.alt}
            widths={[360, 720]}
            sizes="(min-width: 48rem) 20rem, 100vw"
            class="notice-photo"
            loading="eager"
          />
        ) : null
      }
      <h1 class="notice-name">{view.fullName}</h1>
      <NoticeDates view={view} />
      {sentence !== null ? <p class="notice-sentence rule-top">{sentence}</p> : null}
      {showType && ceremony !== null ? <p class="muted">{ceremony.typeLabel}</p> : null}
      {
        mapLabel !== null && ceremony !== null && ceremony.mapUrl !== null ? (
          <p>
            <a href={ceremony.mapUrl} class="go">{mapLabel}</a>
          </p>
        ) : null
      }
      {
        view.livestreamUrl !== null ? (
          <>
            <p>
              <a href={view.livestreamUrl} rel="nofollow noopener" class="go">{ui.livestream}</a>
            </p>
            <p class="muted">{ui.livestreamNote}</p>
          </>
        ) : null
      }
      {notice.hasBody ? <div class="prose notice-body"><Body /></div> : null}
    </PlaceholderMark>
  </div>
  {
    view.familyNote !== null ? (
      <section class="notice-part" aria-labelledby="od-rodiny">
        <h2 id="od-rodiny" class="part-heading rule-top">{ui.familyNote}</h2>
        <p>{view.familyNote}</p>
      </section>
    ) : null
  }
  {
    view.condolencesEmail !== null ? (
      <section class="notice-part" aria-labelledby="kondolence">
        <h2 id="kondolence" class="part-heading rule-top">{ui.condolences}</h2>
        <p>
          {ui.condolencesText} <a href={`mailto:${view.condolencesEmail}`}>{view.condolencesEmail}</a>. {ui.condolencesAfter}
        </p>
      </section>
    ) : null
  }
  {
    parte !== null || view.partePdfHref !== null ? (
      <section class="notice-part" aria-labelledby="parte">
        <h2 id="parte" class="part-heading rule-top">{ui.parteImage}</h2>
        {parte !== null ? (
          <Image src={parte.src} alt={parte.alt} widths={[400, 800]} sizes="(min-width: 64rem) 32rem, 100vw" class="parte-image" />
        ) : null}
        {view.partePdfHref !== null ? (
          <p>
            <a href={view.partePdfHref} class="go">{ui.partePdf}</a>
          </p>
        ) : null}
      </section>
    ) : null
  }
  <NoticeQrHint view={view} />
</article>

<style>
  .notice {
    max-width: calc(46rem + 2 * var(--gutter));
    padding-top: 0.75rem;
    padding-bottom: 1rem;
  }

  .notice-main > :global(* + *),
  .notice-main > :global([data-placeholder] > * + *) {
    margin-top: 0.625rem;
  }

  .notice :global(.notice-photo) {
    display: block;
    width: 100%;
    max-width: 20rem;
    height: auto;
    margin-bottom: 1rem;
    object-fit: contain;
    object-position: left top;
  }

  .notice-name {
    font-size: 2.125rem;
    font-weight: 800;
    line-height: 1.15;
  }

  .notice-sentence {
    margin-top: 1.25rem;
    font-size: 1.3125rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .notice-body {
    margin-top: 1.25rem;
  }

  .notice-part {
    margin-top: 2.25rem;
  }

  .notice-part > * + * {
    margin-top: 0.5rem;
  }

  .part-heading {
    font-size: 1.375rem;
  }

  .notice :global(.parte-image) {
    width: 100%;
    max-width: 32rem;
  }

  @media (min-width: 64rem) {
    .notice {
      padding-top: 2rem;
    }

    .notice-name {
      font-size: 2.75rem;
    }
  }
</style>

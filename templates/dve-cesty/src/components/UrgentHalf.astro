---
/**
 * The navy half of the home split, "Někdo právě zemřel": the heading, the nonstop number (label,
 * number, availability), the three first steps (a real ordered list, template UI strings without
 * business facts) and the link to the guide by place.
 */
import type { EmergencyTransport } from "@core/content/schemas.ts";
import NowNumber from "./NowNumber.astro";
import { ui } from "../i18n/cs.ts";

interface Props {
  emergency: EmergencyTransport;
}

const { emergency } = Astro.props;
---
<section class="half" data-tone="now" aria-labelledby="pul-ted">
  <p class="path-label">{ui.nowLabel}</p>
  <h2 id="pul-ted" class="half-heading">{ui.nowHeading}</h2>
  <NowNumber emergency={emergency} />
  <ol class="first-steps" aria-label={ui.firstStepsLabel}>
    {
      ui.firstSteps.map((step, index) => (
        <li>
          <span class="step-no" aria-hidden="true">{index + 1}</span>
          <span>{step}</span>
        </li>
      ))
    }
  </ol>
  <a href="/jak-postupovat/" class="go guide-link">
    <span class="long">{ui.guideByPlace}</span>
    <span class="short">{ui.guideByPlaceShort}</span>
  </a>
</section>

<style>
  .half {
    padding: 1.5rem var(--gutter) 1.75rem;
  }

  .half > * + * {
    margin-top: 0.875rem;
  }

  .half-heading {
    font-size: 1.5rem;
    line-height: 1.25;
  }

  .first-steps {
    margin-top: 1rem;
    padding: 1.125rem 0 0;
    border-top: 1px solid var(--navy-rule);
    list-style: none;
  }

  .first-steps li {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    column-gap: 0.5rem;
    line-height: 1.5;
  }

  .first-steps li + li {
    margin-top: 0.75rem;
  }

  .step-no {
    font-weight: 800;
  }

  .long {
    display: none;
  }

  @media (min-width: 64rem) {
    .half {
      padding: 3rem var(--gutter) 3.5rem;
    }

    .half > * + * {
      margin-top: 1.375rem;
    }

    .half-heading {
      font-size: 2.25rem;
      line-height: 1.2;
    }

    .first-steps li {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      font-size: 1.1875rem;
    }

    .long {
      display: inline;
    }

    .short {
      display: none;
    }
  }
</style>

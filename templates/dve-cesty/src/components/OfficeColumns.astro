---
/**
 * Kontakt below the navy opening: Kancelář (address, map link) · Úřední hodiny (ruled table,
 * data-office-hours) · Telefony a e-mail, three columns at ≥ 64 rem, stacked on phones.
 */
import PhoneLink from "@core/components/PhoneLink.astro";
import type { SiteContext } from "@core/content/view-models.ts";
import { formatAddressLines } from "@core/format/address.ts";
import { formatPhone } from "@core/format/phone.ts";
import HoursRuledTable from "./HoursRuledTable.astro";
import { mainLocation, mapHref } from "../lib/site.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  site: SiteContext;
}

const { site } = Astro.props;
const location = mainLocation(site);
const [street, cityLine] = formatAddressLines(location.address);
const map = mapHref(location);
const phones = site.contact.phones.map((phone) => ({ ...phone, display: formatPhone(phone.number).display }));
---
<div class="office-cols">
  <section aria-labelledby="kancelar">
    <h2 id="kancelar" class="col-heading">{ui.officeHeading}</h2>
    <p>{location.name}<br />{street}<br />{cityLine}</p>
    {map !== null ? <a href={map} class="go">{ui.mapLink}</a> : null}
    {location.accessNote !== null ? <p class="muted">{location.accessNote}</p> : null}
  </section>
  <section aria-labelledby="hodiny" data-office-hours>
    <h2 id="hodiny" class="col-heading">{ui.hoursHeading}</h2>
    <HoursRuledTable site={site} />
  </section>
  <section aria-labelledby="telefony">
    <h2 id="telefony" class="col-heading">{ui.phonesHeading}</h2>
    <ul class="ruled" role="list">
      {
        phones.map((phone) => (
          <li>
            <span class="muted phone-label">{phone.label}</span>
            <PhoneLink number={phone.number}>
              <span class="visually-hidden">{phone.label} </span><span class="nowrap">{phone.display}</span>
            </PhoneLink>
          </li>
        ))
      }
      {
        site.contact.emails.map((email) => (
          <li>
            <a href={`mailto:${email.address}`} class="go mail">{email.address}</a>
          </li>
        ))
      }
    </ul>
  </section>
</div>

<style>
  .office-cols {
    display: grid;
    row-gap: 2rem;
    padding: 2rem var(--gutter) 0;
  }

  .office-cols section > * + * {
    margin-top: 0.625rem;
  }

  .office-cols .ruled > li {
    padding-block: 0.375rem;
  }

  .phone-label {
    display: block;
  }

  .mail {
    overflow-wrap: anywhere;
  }

  @media (min-width: 64rem) {
    .office-cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 3rem;
      padding-top: 3.5rem;
    }
  }
</style>

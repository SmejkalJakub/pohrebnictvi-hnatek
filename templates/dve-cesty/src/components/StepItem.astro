---
/**
 * One guide step: the number (CSS counter, so it stays continuous when the filter hides steps),
 * the 20 px title, the summary, native checkboxes in 44 px rows, the body in <details> (visible
 * marker), and the contact prompt: the nonstop link (label + number) or the office phone.
 */
import type { CollectionEntry } from "astro:content";
import EmergencyPhoneLink from "@core/components/EmergencyPhoneLink.astro";
import PhoneLink from "@core/components/PhoneLink.astro";
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import UnreviewedMark from "@core/components/UnreviewedMark.astro";
import { render } from "@core/content/load.ts";
import { situationsAttribute } from "@core/content/guidance-flow.ts";
import type { SiteContext } from "@core/content/view-models.ts";
import { formatPhone } from "@core/format/phone.ts";
import { nbsp, primaryOfficePhone } from "../lib/site.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  site: SiteContext;
  entry: CollectionEntry<"guidance">;
}

const { site, entry } = Astro.props;
const data = entry.data;
const office = primaryOfficePhone(site);
const { Content } = await render(entry);
const hasBody = (entry.body ?? "").trim() !== "";
---
<li id={entry.id} class="step" data-guide-step data-situations={situationsAttribute(entry)}>
  <span class="step-no" aria-hidden="true"></span>
  <div class="step-main">
    <h3 class="step-title">{data.title}</h3>
    <PlaceholderMark active={data.placeholder} as="div">
      <p>{nbsp(data.summary)}</p>
      <UnreviewedMark reviewedAt={data.review.reviewedAt} />
    </PlaceholderMark>
    {
      data.checklist.length > 0 ? (
        <ul class="step-checks" role="list" aria-label={ui.checklist}>
          {data.checklist.map((item, index) => (
            <li>
              <label class="tick">
                <input type="checkbox" name={`${entry.id}-${index}`} />
                <span>{item}</span>
              </label>
            </li>
          ))}
        </ul>
      ) : null
    }
    {
      hasBody ? (
        <details class="more">
          <summary>{ui.readMore}</summary>
          <div class="prose">
            <Content />
          </div>
        </details>
      ) : null
    }
    {
      data.contactPrompt === "emergency" && site.emergency.enabled ? (
        <p>
          <EmergencyPhoneLink emergency={site.emergency} variant="custom" class="step-call">
            {site.emergency.label}{" "}<span class="nowrap">{formatPhone(site.emergency.phone).display}</span>
          </EmergencyPhoneLink>
        </p>
      ) : null
    }
    {
      data.contactPrompt === "office" ? (
        <p>
          {ui.officePrompt}:{" "}
          <PhoneLink number={office.number}>{office.label}{" "}<span class="nowrap">{formatPhone(office.number).display}</span></PhoneLink>
        </p>
      ) : null
    }
  </div>
</li>

<style>
  .step {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    column-gap: 0.5rem;
    counter-increment: guide-step;
  }

  .step + .step {
    margin-top: 1.375rem;
  }

  .step-no::before {
    content: counter(guide-step);
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.3;
  }

  .step-main > * + * {
    margin-top: 0.375rem;
  }

  .step-title {
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .step-checks {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step :global(.step-call) {
    display: inline-block;
    padding-block: 0.625rem;
    font-weight: 700;
  }

  @media (min-width: 64rem) {
    .step {
      grid-template-columns: 2.5rem minmax(0, 1fr);
    }
  }
</style>

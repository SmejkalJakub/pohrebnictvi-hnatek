---
/**
 * A service page below its stone opening: the body (8/12), "Co je v ceně a kolik to stojí" with
 * the linked group's price, VAT note, inclusion lists and the link to Ceník, then "Další služby"
 * as a ruled list. Transport repeats the nonstop number in its navy form.
 */
import type { CollectionEntry } from "astro:content";
import PriceValue from "@core/components/PriceValue.astro";
import VatNote from "@core/components/VatNote.astro";
import type { PriceGroup } from "@core/content/schemas.ts";
import type { PricingView, SiteContext } from "@core/content/view-models.ts";
import { serviceHref } from "@core/content/view-models.ts";
import NowNumber from "./NowNumber.astro";
import { headlineItem } from "../lib/site.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  site: SiteContext;
  service: CollectionEntry<"services">;
  others: CollectionEntry<"services">[];
  group: PriceGroup | null;
  pricing: PricingView | null;
  hasBody: boolean;
}

const { site, service, others, group, pricing, hasBody } = Astro.props;
const headline = headlineItem(group);
let hasInclusions = false;
if (group !== null && (group.includes.length > 0 || group.excludes.length > 0)) {
  hasInclusions = true;
}
---
{
  service.data.category === "transport" && site.emergency.enabled ? (
    <div class="transport-number" data-tone="now">
      <NowNumber emergency={site.emergency} />
    </div>
  ) : null
}
{
  hasBody ? (
    <div class="section prose narrow">
      <slot />
    </div>
  ) : null
}
{
  group !== null && pricing !== null ? (
    <section class="section split-section" aria-labelledby="v-cene">
      <div class="split-head">
        <h2 id="v-cene" class="section-heading">{ui.includesHeading}</h2>
      </div>
      <div class="price-detail">
        {headline !== null ? (
          <p class="detail-price rule-top">
            <span>{group.title}</span>{" "}
            <PriceValue item={headline} />
          </p>
        ) : null}
        <VatNote pricing={pricing} class="muted" />
        {hasInclusions ? (
          <div class="detail-lists">
            {group.includes.length > 0 ? (
              <div>
                <h3 class="small-heading">{ui.included}</h3>
                <ul class="dot-list">
                  {group.includes.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            ) : null}
            {group.excludes.length > 0 ? (
              <div>
                <h3 class="small-heading">{ui.excluded}</h3>
                <ul class="dot-list">
                  {group.excludes.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            ) : null}
          </div>
        ) : null}
        <a href={`/cenik/#${group.id}`} class="go">{ui.priceLink}</a>
      </div>
    </section>
  ) : null
}
{
  others.length > 0 ? (
    <section class="section split-section" aria-labelledby="dalsi-sluzby">
      <div class="split-head">
        <h2 id="dalsi-sluzby" class="section-heading">{ui.moreServices}</h2>
      </div>
      <ul class="ruled" role="list">
        {others.map((other) => (
          <li>
            <a href={serviceHref(other.id, true)} class="ruled-title">{other.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  ) : null
}
<div class="section">
  <a href="/sluzby/" class="go">{ui.allServicesBack}</a>
</div>

<style>
  .transport-number {
    margin-top: 2rem;
    padding: 1.25rem var(--gutter);
  }

  .price-detail > * + * {
    margin-top: 0.75rem;
  }

  .detail-price {
    font-size: 1.375rem;
    font-weight: 800;
  }

  .detail-lists {
    display: grid;
    row-gap: 1.25rem;
  }

  .detail-lists h3 + ul {
    margin-top: 0.375rem;
  }

  @media (min-width: 48rem) {
    .detail-lists {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 3rem;
    }
  }
</style>

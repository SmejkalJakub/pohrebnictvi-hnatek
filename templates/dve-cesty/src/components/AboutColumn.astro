---
/** Home "family-story": the O nás heading, its excerpt (or lead) and the tradition wording, a link. */
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import { nbsp } from "../lib/site.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  title: string;
  text: string | null;
  tradition: string | null;
  placeholder: boolean;
}

const { title, text, tradition, placeholder } = Astro.props;
---
<section class="home-col" data-section="family-story" aria-labelledby="o-nas-sekce">
  <h2 id="o-nas-sekce" class="col-heading">{title}</h2>
  <PlaceholderMark active={placeholder} as="div">
    {tradition !== null ? <p class="strong">{tradition}</p> : null}
    {text !== null ? <p>{nbsp(text)}</p> : null}
  </PlaceholderMark>
  <a href="/o-nas/" class="go">{ui.aboutLink}</a>
</section>

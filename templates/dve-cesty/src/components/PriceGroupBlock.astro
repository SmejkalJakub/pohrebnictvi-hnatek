---
/**
 * A price group with inclusion lists: the group name left and its price right on one 2 px navy
 * rule (core has no group price, so the first item stands for it, as for C and E), the
 * description, then "V ceně je zahrnuto" and "Není zahrnuto" in two columns; further items in a
 * ruled table under them. Prices only through <PriceValue>.
 */
import PriceValue from "@core/components/PriceValue.astro";
import type { PriceGroup } from "@core/content/schemas.ts";
import ItemsRuledTable from "./ItemsRuledTable.astro";
import { headlineItem } from "../lib/site.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  group: PriceGroup;
}

const { group } = Astro.props;
const headline = headlineItem(group);
const rest = group.items.slice(1);
const headingId = `${group.id}-nadpis`;
---
<section id={group.id} class="section price-block" aria-labelledby={headingId} data-price-group={group.id}>
  <div class="group-line rule-top">
    <h2 id={headingId} class="group-name">{group.title}</h2>
    {
      headline !== null ? (
        <p class="group-price">
          {headline.label !== group.title ? <span class="headline-label">{headline.label}</span> : null}{" "}
          <PriceValue item={headline} />
        </p>
      ) : null
    }
  </div>
  {group.description !== null ? <p class="narrow">{group.description}</p> : null}
  {headline !== null && headline.description !== null ? <p class="muted narrow">{headline.description}</p> : null}
  <div class="inclusions">
    {
      group.includes.length > 0 ? (
        <div>
          <h3 class="small-heading">{ui.included}</h3>
          <ul class="dot-list">
            {group.includes.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ) : null
    }
    {
      group.excludes.length > 0 ? (
        <div>
          <h3 class="small-heading">{ui.excluded}</h3>
          <ul class="dot-list">
            {group.excludes.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ) : null
    }
  </div>
  {rest.length > 0 ? <ItemsRuledTable items={rest} caption={group.title} /> : null}
</section>

<style>
  .group-line {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    column-gap: 1.5rem;
    row-gap: 0.25rem;
  }

  .group-name,
  .group-price {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .headline-label {
    font-size: 1.125rem;
    font-weight: 700;
  }

  .inclusions {
    display: grid;
    row-gap: 1.25rem;
    padding-top: 0.5rem;
  }

  .inclusions h3 + ul {
    margin-top: 0.375rem;
  }

  @media (min-width: 48rem) {
    .inclusions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 3rem;
    }
  }

  @media (min-width: 64rem) {
    .price-block {
      padding-top: 4rem;
    }

    .group-name,
    .group-price {
      font-size: var(--h2);
    }
  }
</style>

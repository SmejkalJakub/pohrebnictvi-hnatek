---
/**
 * The 404 split: a small navy half (the nonstop number, Jak postupovat) and a small stone half
 * (Ceník when on, Služby, Kontakt a úřední hodiny), side by side at ≥ 48 rem, stacked below.
 */
import type { EmergencyTransport } from "@core/content/schemas.ts";
import NowNumber from "./NowNumber.astro";
import { ui } from "../i18n/cs.ts";

interface Props {
  emergency: EmergencyTransport;
  hasPricing: boolean;
}

const { emergency, hasPricing } = Astro.props;
---
<div class="lost">
  <section class="lost-half" data-tone="now" aria-labelledby="ztraceno-ted">
    <h2 id="ztraceno-ted" class="path-label">{ui.nowSwitch}</h2>
    {emergency.enabled ? <NowNumber emergency={emergency} /> : null}
    <p>
      <a href="/jak-postupovat/" class="go">{ui.notFoundGuide}</a>
    </p>
  </section>
  <section class="lost-half" data-tone="ahead" aria-labelledby="ztraceno-predem">
    <h2 id="ztraceno-predem" class="path-label">{ui.aheadSwitch}</h2>
    <ul class="ruled" role="list">
      {
        hasPricing ? (
          <li>
            <a href="/cenik/" class="ruled-title">{ui.priceRow}</a>
          </li>
        ) : null
      }
      <li>
        <a href="/sluzby/" class="ruled-title">{ui.servicesHeading}</a>
      </li>
      <li>
        <a href="/kontakt/" class="ruled-title">{ui.notFoundContact}</a>
      </li>
    </ul>
  </section>
</div>

<style>
  .lost {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-top: 1.5rem;
  }

  .lost-half {
    padding: 1.25rem var(--gutter) 1.5rem;
  }

  .lost-half > * + * {
    margin-top: 0.75rem;
  }

  .lost-half .ruled > li {
    padding-block: 0.375rem;
  }

  @media (min-width: 48rem) {
    .lost {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

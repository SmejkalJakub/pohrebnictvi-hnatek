---
/**
 * Footer, every page. Full form: two halves like the home page, the navy one holding only the
 * nonstop number and the Teď hned links (its own emergency block), the stone one holding Kancelář
 * (address, office hours under their own heading, office phone) and the S předstihem links; then
 * the legal row on paper (research L8, L10): legal name, sídlo, IČO, register entry, ADR, the
 * Právní informace, Dokumenty and privacy links. The two halves never share a container.
 * Neutral form (notice pages): no halves and no service links; Kancelář (address, hours, phone)
 * and the legal row stay (invariant 3).
 */
import MissingFact from "@core/components/MissingFact.astro";
import PhoneLink from "@core/components/PhoneLink.astro";
import type { SiteContext } from "@core/content/view-models.ts";
import { formatAddressInline } from "@core/format/address.ts";
import { formatPhone } from "@core/format/phone.ts";
import NowNumber from "./NowNumber.astro";
import type { PathNav } from "../lib/site.ts";
import { mainLocation, primaryOfficePhone } from "../lib/site.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  site: SiteContext;
  neutral: boolean;
  nav: PathNav;
  hasDocuments: boolean;
  hasPrivacyPage: boolean;
}

const { site, neutral, nav, hasDocuments, hasPrivacyPage } = Astro.props;
const location = mainLocation(site);
const office = primaryOfficePhone(site);
const officeDisplay = formatPhone(office.number).display;
const ids = site.company.legalIds;
const aheadLinks = nav.ahead.filter((item) => item.key !== "documents");
---
<footer class="foot" data-neutral={neutral ? "true" : "false"}>
  {
    neutral ? null : (
      <div class="foot-halves">
        {site.emergency.enabled ? (
          <section class="foot-now" data-tone="now" aria-labelledby="pata-ted" data-emergency-block>
            <h2 id="pata-ted" class="path-label">{ui.nowSwitch}</h2>
            <NowNumber emergency={site.emergency} size="footer" />
            <ul class="foot-links" role="list">
              {nav.now.map((item) => (
                <li>
                  <a href={item.href} class="go">{item.label}</a>
                </li>
              ))}
            </ul>
          </section>
        ) : null}
        <div class="foot-ahead" data-tone="ahead">
          <section aria-labelledby="pata-kancelar" class="foot-office">
            <h2 id="pata-kancelar" class="path-label">{ui.officeHeading}</h2>
            <p>{formatAddressInline(location.address)}</p>
            <div data-office-hours>
              <h3 class="visually-hidden">{ui.hoursHeading}</h3>
              <ul class="foot-hours" role="list">
                {site.officeHoursRows.map((row) => (
                  <li>
                    <abbr title={row.daysLong}>{row.days}</abbr> <span class="nowrap">{row.text}</span>
                    {row.note !== null ? <span class="muted">, {row.note}</span> : null}
                  </li>
                ))}
              </ul>
            </div>
            <PhoneLink number={office.number}>{office.label}{" "}<span class="nowrap">{officeDisplay}</span></PhoneLink>
          </section>
          <section aria-labelledby="pata-predem" class="foot-more">
            <h2 id="pata-predem" class="path-label">{ui.aheadSwitch}</h2>
            <ul class="foot-links" role="list">
              {aheadLinks.map((item) => (
                <li>
                  <a href={item.href} class="go">{item.label}</a>
                </li>
              ))}
            </ul>
          </section>
        </div>
      </div>
    )
  }
  <div class="foot-legal">
    {
      neutral ? (
        <section aria-labelledby="pata-kancelar" class="foot-office-line">
          <h2 id="pata-kancelar" class="visually-hidden">{ui.officeHeading}</h2>
          <p>
            <strong>{ui.officeHeading}</strong> {formatAddressInline(location.address)}
          </p>
          <div data-office-hours>
            <h3 class="visually-hidden">{ui.hoursHeading}</h3>
            <ul class="foot-hours" role="list">
              {site.officeHoursRows.map((row) => (
                <li>
                  <abbr title={row.daysLong}>{row.days}</abbr> <span class="nowrap">{row.text}</span>
                  {row.note !== null ? <span>, {row.note}</span> : null}
                </li>
              ))}
            </ul>
          </div>
          <PhoneLink number={office.number}>{office.label}{" "}<span class="nowrap">{officeDisplay}</span></PhoneLink>
        </section>
      ) : null
    }
    <p class="foot-id" data-legal-identification>
      {site.company.legalName}
      {", "}
      {
        ids.registeredOffice !== null ? (
          formatAddressInline(ids.registeredOffice)
        ) : (
          <MissingFact name="sídlo společnosti" />
        )
      }
      {", "}
      {ui.ico}{" "}
      {ids.ico !== null ? <span class="nowrap">{ids.ico}</span> : <MissingFact name="IČO" />}
      {", "}
      {ids.registryEntry !== null ? ids.registryEntry : <MissingFact name="zápis v obchodním rejstříku" />}
      {". "}
      {
        site.legal !== null ? (
          <>
            {ui.adrFooter} {site.legal.adr.name},{" "}
            <a href={site.legal.adr.url}>{site.legal.adr.url.replace(/^https?:\/\//, "")}</a>
          </>
        ) : null
      }
    </p>
    <ul class="foot-legal-links" role="list">
      {
        site.legalLink !== null ? (
          <li>
            <a href={site.legalLink.href} class="go">{site.legalLink.label}</a>
          </li>
        ) : null
      }
      {
        !neutral && hasDocuments ? (
          <li>
            <a href="/pravni-informace/#dokumenty" class="go">{ui.documentsLink}</a>
          </li>
        ) : null
      }
      {
        hasPrivacyPage ? (
          <li>
            <a href="/ochrana-osobnich-udaju/" class="go">{ui.privacy}</a>
          </li>
        ) : null
      }
    </ul>
  </div>
</footer>

<style>
  .foot {
    margin-top: 3rem;
  }

  .foot-halves {
    display: grid;
  }

  .foot-now,
  .foot-ahead {
    padding: 1.5rem var(--gutter);
  }

  .foot-now > * + * {
    margin-top: 0.5rem;
  }

  .foot-ahead {
    display: grid;
    row-gap: 1.75rem;
  }

  .foot-office > * + * {
    margin-top: 0.375rem;
  }

  .foot-links,
  .foot-hours,
  .foot-legal-links {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .foot-hours abbr {
    text-decoration: none;
  }

  .foot-legal {
    padding: 1.5rem var(--gutter);
    background: var(--paper);
    color: var(--slate);
  }

  .foot-legal a {
    color: var(--navy);
  }

  .foot-office-line {
    margin-bottom: 1.25rem;
    color: var(--navy);
  }

  .foot-office-line strong {
    font-weight: 800;
  }

  .foot-legal-links {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.5rem;
    margin-top: 0.5rem;
  }

  .foot-legal-links :global(.go) {
    font-weight: 400;
  }

  @media (min-width: 48rem) {
    .foot-halves {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .foot-ahead {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }

  @media (min-width: 64rem) {
    .foot {
      margin-top: 4.5rem;
    }

    .foot-now,
    .foot-ahead {
      padding-block: 2.25rem;
    }

    .foot-legal {
      display: grid;
      grid-template-columns: 7fr 5fr;
      column-gap: 2.5rem;
      align-items: start;
    }

    .foot-office-line {
      grid-column: 1 / -1;
    }

    .foot-legal-links {
      justify-content: end;
      margin-top: 0;
    }
  }
</style>

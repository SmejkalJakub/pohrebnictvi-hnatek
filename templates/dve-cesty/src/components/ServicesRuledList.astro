---
/** Home "services": the featured services as ruled rows (link + summary), then "Všechny služby". */
import type { CollectionEntry } from "astro:content";
import { serviceHref } from "@core/content/view-models.ts";
import { nbsp } from "../lib/site.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  services: CollectionEntry<"services">[];
}

const { services } = Astro.props;
---
<section class="home-wide" data-section="services" aria-labelledby="sluzby-sekce">
  <h2 id="sluzby-sekce" class="col-heading">{ui.servicesHeading}</h2>
  <ul class="ruled" role="list">
    {
      services.map((service) => (
        <li>
          <a href={serviceHref(service.id, true)} class="ruled-title">{service.data.title}</a>
          <p class="muted">{nbsp(service.data.summary)}</p>
        </li>
      ))
    }
  </ul>
  <a href="/sluzby/" class="go">{ui.allServices}</a>
</section>

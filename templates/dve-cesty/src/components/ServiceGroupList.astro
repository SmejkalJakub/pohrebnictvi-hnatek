---
/**
 * One category of services on Služby: the heading column (4/12) and a ruled list (8/12); each row
 * is the service link (to its own page), a price from its linked group or nothing, and the summary.
 */
import type { CollectionEntry } from "astro:content";
import PlaceholderMark from "@core/components/PlaceholderMark.astro";
import PriceValue from "@core/components/PriceValue.astro";
import type { PricingView } from "@core/content/view-models.ts";
import { serviceHref } from "@core/content/view-models.ts";
import { headlineItem, nbsp, priceGroupFor } from "../lib/site.ts";

interface Props {
  id: string;
  heading: string;
  services: CollectionEntry<"services">[];
  pricing: PricingView | null;
}

const { id, heading, services, pricing } = Astro.props;
const rows = services.map((service) => ({
  service,
  price: headlineItem(priceGroupFor(pricing, service.data.priceGroupId)),
}));
---
<section class="section split-section" aria-labelledby={id}>
  <div class="split-head">
    <h2 id={id} class="section-heading">{heading}</h2>
  </div>
  <ul class="ruled service-rows" role="list">
    {
      rows.map(({ service, price }) => (
        <li id={service.id}>
          <PlaceholderMark active={service.data.placeholder} as="div">
            <div class="service-row">
              <a href={serviceHref(service.id, true)} class="ruled-title service-title">{service.data.title}</a>
              {price !== null ? (
                <span class="service-price">
                  <PriceValue item={price} />
                </span>
              ) : null}
              <p class="service-summary">{nbsp(service.data.summary)}</p>
            </div>
          </PlaceholderMark>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .service-rows > li:first-child {
    border-top: 2px solid var(--navy);
  }

  .service-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 0.25rem;
  }

  .service-price {
    font-weight: 700;
  }

  @media (min-width: 64rem) {
    .service-rows > li {
      padding-block: 1.125rem;
    }

    .service-row {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 1.5rem;
      align-items: baseline;
    }

    .service-title {
      font-size: 1.4375rem;
      font-weight: 800;
    }

    .service-summary {
      grid-column: 1 / -1;
    }
  }
</style>

---
/** Home "faq": the first questions as plain lines, then the link to all questions on Služby. */
import type { CollectionEntry } from "astro:content";
import type { FaqGroup } from "@core/content/view-models.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  groups: FaqGroup<CollectionEntry<"faq">>[];
}

const { groups } = Astro.props;
const questions = groups.flatMap((group) => group.entries).slice(0, 3);
---
<section class="home-col" data-section="faq" aria-labelledby="otazky-sekce">
  <h2 id="otazky-sekce" class="col-heading">{ui.faqHeading}</h2>
  <ul class="col-lines" role="list">
    {questions.map((entry) => <li>{entry.data.question}</li>)}
  </ul>
  <a href="/sluzby/#caste-otazky" class="go">{ui.allFaq}</a>
</section>

---
/**
 * High emphasis (emergencyEmphasis: "high"): a full-width navy band directly under the switch on
 * every page that opens with the stone panel. One tel: link: "Někdo právě zemřel?" (mist), the
 * service label and the number (white, 22 px 800, underlined). Home and Teď hned pages already
 * open with the number, so they never show it.
 */
import EmergencyPhoneLink from "@core/components/EmergencyPhoneLink.astro";
import type { EmergencyTransport } from "@core/content/schemas.ts";
import { formatPhone } from "@core/format/phone.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  emergency: EmergencyTransport;
}

const { emergency } = Astro.props;
const phone = formatPhone(emergency.phone);
---
{
  emergency.enabled ? (
    <div class="urgent-band" data-tone="now" data-urgent-band>
      <EmergencyPhoneLink emergency={emergency} variant="custom" class="band-link">
        <span class="band-question">{ui.someoneDied}</span>{" "}
        <span class="band-label">{emergency.label}</span>{" "}
        <span class="band-digits" data-part="number">{phone.display}</span>
      </EmergencyPhoneLink>
    </div>
  ) : null
}

<style>
  .urgent-band {
    padding: 0.5rem var(--gutter);
  }

  .urgent-band :global(.band-link) {
    display: block;
    padding-block: 0.375rem;
    line-height: 1.4;
    text-decoration: none;
  }

  .band-question,
  .band-label {
    color: var(--mist);
  }

  .band-digits {
    display: inline-block;
    color: var(--white);
    font-size: 1.375rem;
    font-weight: 800;
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
</style>

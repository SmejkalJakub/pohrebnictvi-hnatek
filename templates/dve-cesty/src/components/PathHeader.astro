---
/**
 * The header (not sticky). ≥ 64 rem: a three-column grid, wordmark or logo | the path switch in
 * the centre | Oznámení a obřady · O nás · Kontakt. Below 64 rem: wordmark + "Menu" (never a
 * hamburger), the switch full width underneath (always visible, outside the menu), the menu in
 * the flow. Notice pages: wordmark and the reduced links only, no switch (research L1); below
 * 64 rem only Kontakt stays in the header and the rest sit behind the same "Menu" button.
 * The toggle is the header's last element, so Tab moves from it straight into the opened menu.
 */
import { Image } from "astro:assets";
import type { SiteContext } from "@core/content/view-models.ts";
import { resolveOptionalImage } from "@core/media/resolve.ts";
import PathSwitch from "./PathSwitch.astro";
import PathMenu from "./PathMenu.astro";
import type { PathId } from "../lib/paths.ts";
import type { PathLink, PathNav } from "../lib/site.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  site: SiteContext;
  path: PathId;
  nav: PathNav;
  reduced: PathLink[];
  lost: boolean;
}

const { site, path, nav, reduced, lost } = Astro.props;
const neutral = path === "neutral";
const logo = resolveOptionalImage(site.company.logo);
const menuId = "menu";
---
<header class="head" data-neutral={neutral ? "true" : "false"}>
  <a href="/" class="brand">
    {
      logo !== null ? (
        <Image src={logo.src} alt={site.company.brandName} height={104} densities={[1, 2]} loading="eager" />
      ) : (
        site.company.brandName
      )
    }
  </a>
  {neutral ? null : <PathSwitch path={path} lost={lost} />}
  {
    neutral ? (
      <nav class="reduced-nav" aria-label={ui.mainNav}>
        <ul role="list">
          {reduced.map((item) => (
            <li data-narrow={item.key === "kontakt" ? "true" : undefined}>
              <a href={item.href} aria-current={item.current ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ) : (
      <nav class="head-nav" aria-label={ui.mainNav}>
        <ul role="list">
          {nav.general.map((item) => (
            <li>
              <a href={item.href} aria-current={item.current ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
  <button type="button" class="menu-btn" aria-expanded="false" aria-controls={menuId} data-menu-toggle>
    {ui.menuOpen}
  </button>
</header>
<PathMenu site={site} id={menuId} nav={neutral ? null : nav} reduced={reduced} />

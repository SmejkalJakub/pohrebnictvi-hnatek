---
/**
 * The "Teď hned / S předstihem" switch: one segmented control of two links (never a JS tab). The
 * page's path is filled navy with aria-current="page"; on home "Teď hned" is filled as drawn but
 * without aria-current (home belongs to both paths); on the 404 nothing is filled.
 * Marked data-path-switch for the structure check (never on notice pages).
 */
import type { PathId } from "../lib/paths.ts";
import { PATH_HREF } from "../lib/paths.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  path: PathId;
  /** The 404 page: neither option is filled. */
  lost?: boolean;
}

const { path, lost = false } = Astro.props;

function selected(option: "now" | "ahead"): boolean {
  if (lost) {
    return false;
  }
  if (path === "both") {
    return option === "now";
  }
  return path === option;
}

function current(option: "now" | "ahead"): "page" | undefined {
  if (path === option) {
    return "page";
  }
  return undefined;
}

const options = [
  { key: "now" as const, label: ui.nowSwitch, href: PATH_HREF.now },
  { key: "ahead" as const, label: ui.aheadSwitch, href: PATH_HREF.ahead },
];
---
<nav class="path-switch" aria-label={ui.pathNav} data-path-switch>
  <ul role="list">
    {
      options.map((option) => (
        <li>
          <a href={option.href} aria-current={current(option.key)} data-selected={selected(option.key) ? "true" : "false"}>
            {option.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

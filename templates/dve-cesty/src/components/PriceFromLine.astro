---
/**
 * Home "price-summary": the first group's headline price with its label, the VAT note (research
 * L9) and the link to Ceník. The page renders nothing for it while pricing is hidden.
 */
import PriceValue from "@core/components/PriceValue.astro";
import VatNote from "@core/components/VatNote.astro";
import type { PriceItem } from "@core/content/schemas.ts";
import type { PricingView } from "@core/content/view-models.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  pricing: PricingView;
  item: PriceItem;
}

const { pricing, item } = Astro.props;
---
<section class="home-col" data-section="price-summary" aria-labelledby="ceny-sekce">
  <h2 id="ceny-sekce" class="col-heading">{ui.priceHeading}</h2>
  <p>
    <span class="strong">{item.label}</span>{" "}
    <PriceValue item={item} />
  </p>
  <VatNote pricing={pricing} class="muted" />
  <a href="/cenik/" class="go">{ui.priceLink}</a>
</section>

---
/**
 * Home "notices": a heading, one plain sentence and a link with the count. Never names, dates or
 * places of the deceased on home (research L1).
 */
import { ui } from "../i18n/cs.ts";

interface Props {
  title: string;
  count: number;
}

const { title, count } = Astro.props;
---
<section class="home-col" data-section="notices" aria-labelledby="oznameni-sekce">
  <h2 id="oznameni-sekce" class="col-heading">{title}</h2>
  <p>{ui.noticesText}</p>
  <a href="/oznameni/" class="go">{ui.noticesShow(count)}</a>
</section>

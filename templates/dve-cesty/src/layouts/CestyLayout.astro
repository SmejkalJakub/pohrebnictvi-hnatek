---
/**
 * Page shell for Template D "Dvě cesty". Options become data attributes on <html>.
 * The header (wordmark · path switch · links; "Menu" below 64 rem), then the page, then the split
 * footer. `path` says which path the page belongs to: "now" (Teď hned), "ahead" (S předstihem),
 * "neutral" (notice pages: reduced header, publisher line, no switch, neutral footer; research L1)
 * or "both" (home, 404). High emphasis adds a navy band under the switch on "ahead" pages.
 */
import "../styles/fonts.css";
import "../styles/global.css";
import "../styles/print.css";
import SeoHead from "@core/components/SeoHead.astro";
import StructuredData from "@core/components/StructuredData.astro";
import PrototypeBanner from "@core/components/PrototypeBanner.astro";
import type { ImageMetadata } from "astro";
import { hasPage } from "@core/content/load.ts";
import type { SiteContext } from "@core/content/view-models.ts";
import manropeLatin800 from "@fontsource/manrope/files/manrope-latin-800-normal.woff2?url";
import manropeLatinExt800 from "@fontsource/manrope/files/manrope-latin-ext-800-normal.woff2?url";
import PathHeader from "../components/PathHeader.astro";
import PublisherStrip from "../components/PublisherStrip.astro";
import UrgentBand from "../components/UrgentBand.astro";
import SplitFooter from "../components/SplitFooter.astro";
import { resolveOptions } from "../lib/options.ts";
import type { PathId } from "../lib/paths.ts";
import { neutralLinks } from "../lib/site.ts";
import { getPathNav, hasDocumentLinks } from "../lib/page-links.ts";
import { ui } from "../i18n/cs.ts";

interface Props {
  site: SiteContext;
  path: PathId;
  /** Page title without the brand name; null on the homepage. */
  title?: string | null;
  description: string;
  noindex?: boolean;
  image?: ImageMetadata | null;
  /** The 404 page: the switch shows no selection. */
  lost?: boolean;
}

const { site, path, title = null, description, noindex = false, image = null, lost = false } = Astro.props;
const options = resolveOptions(site.config);
const url = Astro.url.pathname;
const neutral = path === "neutral";

const hasPrivacyPage = await hasPage("ochrana-osobnich-udaju");
const hasDocuments = await hasDocumentLinks();
const nav = await getPathNav(site, url);
const reduced = neutralLinks(site, url);
const band = options.emergencyEmphasis === "high" && path === "ahead";

/* Preload the 800 face: the H1 and the nonstop number, the largest paints, are text (Czech needs latin-ext). */
const preloads = [manropeLatin800, manropeLatinExt800];
const menuLabels = JSON.stringify({ open: ui.menuOpen, close: ui.menuClose });
---
<html
  lang="cs"
  class="no-js"
  data-palette={options.palette}
  data-font={options.fontPair}
  data-emphasis={options.emergencyEmphasis}
  data-path={path}
>
  <head>
    {preloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <SeoHead site={site} title={title} description={description} noindex={noindex} image={image} />
    <script is:inline>
      document.documentElement.classList.replace("no-js", "js");
    </script>
    <StructuredData site={site} />
  </head>
  <body>
    <PrototypeBanner />
    <a href="#obsah" class="skip-link">{ui.skipLink}</a>
    <PathHeader site={site} path={path} nav={nav} reduced={reduced} lost={lost} />
    {neutral ? <PublisherStrip site={site} /> : null}
    {band ? <UrgentBand emergency={site.emergency} /> : null}
    <main id="obsah" tabindex="-1" data-path={path}>
      <slot />
    </main>
    <SplitFooter site={site} neutral={neutral} nav={nav} hasDocuments={hasDocuments} hasPrivacyPage={hasPrivacyPage} />
    <script is:inline define:vars={{ menuLabels }}>
      const labels = JSON.parse(menuLabels);
      const toggle = document.querySelector("[data-menu-toggle]");
      const panel = toggle === null ? null : document.getElementById(toggle.getAttribute("aria-controls"));
      if (toggle !== null && panel !== null) {
        const setOpen = (open) => {
          toggle.setAttribute("aria-expanded", String(open));
          toggle.textContent = open ? labels.close : labels.open;
          panel.toggleAttribute("data-open", open);
        };
        toggle.addEventListener("click", () => {
          setOpen(toggle.getAttribute("aria-expanded") !== "true");
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
            setOpen(false);
            toggle.focus();
          }
        });
      }
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>

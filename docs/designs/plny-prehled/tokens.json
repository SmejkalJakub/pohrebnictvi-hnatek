{
  "template": "plny-prehled",
  "name": "Plný přehled",
  "board": "H",
  "status": "direction approved in principle on 2026-11-10; moodboard stage, full comps not drawn",
  "palettes": {
    "bila-a-zluta": {
      "label": "Bílá a žlutá (default)",
      "colours": {
        "ground": "#FFFFFF",
        "ink": "#111111",
        "muted": "#4A4A4A",
        "highlight": "#F2C230",
        "rule": "#8A8A8A",
        "thumb_placeholder": "#DADAD6"
      },
      "contrast": [
        {
          "fg": "ink",
          "bg": "ground",
          "ratio": 18.88,
          "minimum": 4.5,
          "pass": true,
          "use": "body text, links"
        },
        {
          "fg": "muted",
          "bg": "ground",
          "ratio": 8.86,
          "minimum": 4.5,
          "pass": true,
          "use": "secondary text, counts"
        },
        {
          "fg": "ink",
          "bg": "highlight",
          "ratio": 11.27,
          "minimum": 4.5,
          "pass": true,
          "use": "nonstop label and number on the highlight"
        },
        {
          "fg": "highlight",
          "bg": "ground",
          "ratio": 1.68,
          "minimum": 3.0,
          "pass": false,
          "use": "highlight box edge: FAILS alone, so the box always has a 2 px ink border"
        },
        {
          "fg": "rule",
          "bg": "ground",
          "ratio": 3.45,
          "minimum": 3.0,
          "pass": true,
          "use": "column and table rules"
        },
        {
          "fg": "ink",
          "bg": "ground",
          "ratio": 18.88,
          "minimum": 3.0,
          "pass": true,
          "use": "focus ring (3 px ink)"
        }
      ]
    },
    "seda-a-terakota": {
      "label": "Šedá a terakota",
      "colours": {
        "ground": "#F2F2F0",
        "ink": "#141414",
        "muted": "#4A4A4A",
        "highlight": "#E8B98C",
        "rule": "#868684",
        "thumb_placeholder": "#D6D6D2"
      },
      "contrast": [
        {
          "fg": "ink",
          "bg": "ground",
          "ratio": 16.44,
          "minimum": 4.5,
          "pass": true,
          "use": "body text, links"
        },
        {
          "fg": "muted",
          "bg": "ground",
          "ratio": 7.91,
          "minimum": 4.5,
          "pass": true,
          "use": "secondary text, counts"
        },
        {
          "fg": "ink",
          "bg": "highlight",
          "ratio": 10.31,
          "minimum": 4.5,
          "pass": true,
          "use": "nonstop label and number on the highlight"
        },
        {
          "fg": "highlight",
          "bg": "ground",
          "ratio": 1.59,
          "minimum": 3.0,
          "pass": false,
          "use": "highlight box edge: FAILS alone, so the box always has a 2 px ink border"
        },
        {
          "fg": "rule",
          "bg": "ground",
          "ratio": 3.25,
          "minimum": 3.0,
          "pass": true,
          "use": "column and table rules"
        },
        {
          "fg": "ink",
          "bg": "ground",
          "ratio": 16.44,
          "minimum": 3.0,
          "pass": true,
          "use": "focus ring (3 px ink)"
        }
      ]
    }
  },
  "fonts": [
    {
      "family": "Overpass",
      "weights": [
        400,
        700
      ],
      "role": "text and headings",
      "licence": "SIL OFL 1.1",
      "fontsource": "@fontsource/overpass"
    },
    {
      "family": "Overpass Mono",
      "weights": [
        500
      ],
      "role": "every number: phones, times, dates, prices",
      "licence": "SIL OFL 1.1",
      "fontsource": "@fontsource/overpass-mono"
    }
  ],
  "font_alternative": "Red Hat Text + Red Hat Mono",
  "type_scale_px": {
    "body": 18,
    "small_min": 18,
    "section_heading": 22,
    "h1_375": 32,
    "h1_1280": 40,
    "nonstop_number_375": 28,
    "nonstop_number_1280": 30,
    "line_height_body": 1.45
  },
  "spacing_px": [
    4,
    8,
    12,
    16,
    24,
    32
  ],
  "layout": {
    "directory_1280": "4 equal columns, 20 px padding, 1 px column rules",
    "side_margin_1280": 32,
    "gutter_375": 16,
    "radius": 0,
    "heavy_rule": "3 px ink above the directory and the footer"
  },
  "separation": "column rules and table rules; a 3 px ink rule above the directory"
}
